{
  "name": "support-bundle-investigator",
  "version": "0.1.0",
  "description": "CLI-first, local-first tool that takes a Troubleshoot support bundle .tar.gz and produces evidence-backed diagnosis",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "sbi": "dist/cli/run.mjs"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "unit": "vitest run",
    "build": "tsup",
    "benchmark:hypotheses": "node scripts/benchmark-hypotheses.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "glob": "^11.0.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "js-yaml": "^4.1.0",
    "openai": "^6.31.0",
    "react": "^19.2.4",
    "tar": "^7.0.0"
  }
}
