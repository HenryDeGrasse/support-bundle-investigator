{
  "name": "support-bundle-investigator",
  "version": "0.1.0",
  "description": "CLI-first, local-first tool that takes a Troubleshoot support bundle .tar.gz and produces evidence-backed diagnosis",
  "keywords": [
    "kubernetes",
    "support-bundle",
    "troubleshoot",
    "diagnostics",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenryDeGrasse/support-bundle-investigator.git"
  },
  "bugs": {
    "url": "https://github.com/HenryDeGrasse/support-bundle-investigator/issues"
  },
  "homepage": "https://github.com/HenryDeGrasse/support-bundle-investigator#readme",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "import": "./dist/tui/index.mjs",
      "require": "./dist/tui/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md"
  ],
  "bin": {
    "sbi": "dist/cli/run.mjs",
    "rat": "dist/cli/rat.mjs"
  },
  "engines": {
    "node": "20 || >=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "unit": "vitest run",
    "build": "tsup",
    "prepack": "npm run build",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "cassettes:record": "node scripts/record-cassettes.mjs",
    "benchmark:hypotheses": "node scripts/benchmark-hypotheses.mjs",
    "audit": "node scripts/audit-findings.mjs",
    "benchmark:retrieval": "node scripts/benchmark-retrieval.mjs",
    "eval:golden": "vitest run test/golden/__tests__/golden-eval.test.ts test/golden/__tests__/scorecard.test.ts test/golden/__tests__/dedup-invariant.test.ts",
    "eval:cassette": "vitest run test/golden/__tests__/cassette-eval.test.ts",
    "test:robustness": "vitest run test/integration/__tests__/robustness.test.ts",
    "test:sensitive": "vitest run test/integration/__tests__/sensitive-data.test.ts",
    "test:perf": "vitest run test/integration/__tests__/perf-benchmark.test.ts",
    "rat": "npm run build && node dist/cli/rat.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "glob": "^13.0.6",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "js-yaml": "^5.2.3",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "tar": "^7.5.22"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
