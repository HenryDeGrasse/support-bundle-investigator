+  for (const range of coveredRanges) {
+    if (mergedCovered.length === 0) {
+      mergedCovered.push({ ...range });
+    } else {
+      const last = mergedCovered[mergedCovered.length - 1]!;
+      if (range.startIdx <= last.endIdx + 1) {
