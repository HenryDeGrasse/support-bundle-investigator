+{"type":"message","id":"37dd020b","parentId":"d1db3b48","timestamp":"2026-03-21T19:51:46.930Z","message":{"role":"toolResult","toolCallId":"call_qMBOYepH4WSHL48N6uj6cask|fc_0f9932afa4a686050169bef6d2b8a4819bbfea7769519f429d","toolName":"read","content":[{"type":"text","text":"import * as fs from \"fs/promises\";\nimport * as path from \"path\";\nimport * as tar from \"tar\";\n\n/**\n * Returns the absolute path to the fixture directory for a given scenario name.\n */\nexport function getFixturePath(scenario: string): string {\n  return path.resolve(__dirname, \"../fixtures/scenarios\", scenario);\n}\n\n/**\n * Packs a scenario directory into a .tar.gz bundle archive.\n *\n * @param scenarioDir - Absolute or relative path to the directory to pack.\n * @param outputPath  - Absolute or relative path for the output .tar.gz file.\n * @returns The resolved output path.\n */\nexport async function createTestBundle(\n  scenarioDir: string,\n  outputPath: string\n): Promise<string> {\n  const absoluteScenarioDir = path.resolve(scenarioDir);\n  const absoluteOutputPath = path.resolve(outputPath);\n\n  const scenarioStats = await fs.stat(absoluteScenarioDir).catch(() => null);\n  if (!scenarioStats?.isDirectory()) {\n    throw new Error(`Scenario directory does not exist: ${absoluteScenarioDir}`);\n  }\n\n  await fs.mkdir(path.dirname(absoluteOutputPath), { recursive: true });\n\n  // Collect entries relative to the parent of scenarioDir so that the\n  // archive contains the scenario folder itself at its root.\n  const parentDir = path.dirname(absoluteScenarioDir);\n  const scenarioName = path.basename(absoluteScenarioDir);\n\n  await tar.c(\n    {\n      gzip: true,\n      file: absoluteOutputPath,\n      cwd: parentDir,\n    },\n    [scenarioName]\n  );\n\n  return absoluteOutputPath;\n}\n"}],"isError":false,"timestamp":1774122706930}}
+{"type":"message","id":"85e625ec","parentId":"37dd020b","timestamp":"2026-03-21T19:51:46.930Z","message":{"role":"toolResult","toolCallId":"call_lCtcs2drYgJp94zPmOVXXjaa|fc_0f9932afa4a686050169bef6d2bb60819bb655ff5d2fd2d03e","toolName":"read","content":[{"type":"text","text":"import type { BundleProfile } from '../types/index.js';\nimport type { AIRunSummary } from '../ai/telemetry.js';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport interface RetrievalStats {\n  graphChunks: number;\n  lexicalChunks: number;\n  semanticChunks: number;\n  mergedChunks: number;\n}\n\nexport interface ConfidenceStats {\n  min: number;\n  max: number;\n  mean: number;\n  median: number;\n}\n\nexport interface HypothesisStats {\n  generated: number;\n  verified: number;\n  converted: number;\n}\n\nexport interface TraceStep {\n  name: string;\n  startedAt: string;\n  completedAt?: string;\n  artifactsProcessed: number;\n  errors?: string[];\n  seedCount?: number;\n  seedCategories?: Record<string, number>;\n  retrievalStats?: RetrievalStats;\n  confidenceStats?: ConfidenceStats;\n  hypothesisStats?: HypothesisStats;\n}\n\nexport interface InvestigationTrace {\n  bundlePath: string;\n  startedAt: string;\n  completedAt?: string;\n  steps: TraceStep[];\n  profile?: BundleProfile;\n  metadata?: Record<string, unknown>;\n  aiSummary?: AIRunSummary;\n}\n\n// ---------------------------------------------------------------------------\n// Factory\n// ---------------------------------------------------------------------------\n\n/**\n * Creates a new investigation trace for the given bundle path.\n */\nexport function createTrace(bundlePath: string): InvestigationTrace {\n  return {\n    bundlePath,\n    startedAt: new Date().toISOString(),\n    steps: [],\n  };\n}\n\n/**\n * Records the start of a new pipeline step and returns its index.\n *\n * The returned index should be passed to {@link completeTraceStep} when the\n * step finishes.\n */\nexport function startTraceStep(trace: InvestigationTrace, name: string): number {\n  const step: TraceStep = {\n    name,\n    startedAt: new Date().toISOString(),\n    artifactsProcessed: 0,\n  };\n  trace.steps.push(step);\n  return trace.steps.length - 1;\n}\n\n/**\n * Marks a trace step as completed, recording the finish time, artifact count\n * and any errors encountered.\n */\nexport function completeTraceStep(\n  trace: InvestigationTrace,\n  stepIndex: number,\n  artifactsProcessed: number,\n  errors?: string[],\n): void {\n  const step = trace.steps[stepIndex];\n  if (!step) return;\n\n  step.completedAt = new Date().toISOString();\n  step.artifactsProcessed = artifactsProcessed;\n  if (errors && errors.length > 0) {\n    step.errors = errors;\n  }\n}\n\n/**\n * Marks the entire trace as completed.\n */\nexport function completeTrace(\n  trace: InvestigationTrace,\n  profile?: BundleProfile,\n  metadata?: Record<string, unknown>,\n): void {\n  trace.completedAt = new Date().toISOString();\n  if (profile) {\n    trace.profile = profile;\n  }\n  if (metadata && Object.keys(metadata).length > 0) {\n    trace.metadata = metadata;\n  }\n}\n"}],"isError":false,"timestamp":1774122706930}}
