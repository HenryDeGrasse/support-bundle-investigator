+{"type":"message","id":"9f17d632","parentId":"13d3e614","timestamp":"2026-03-21T19:53:50.947Z","message":{"role":"toolResult","toolCallId":"call_tuGFjnB4pfJiaOhhVEOwSuDG|fc_0f9932afa4a686050169bef74b47b0819b920435f16fd17ac7","toolName":"read","content":[{"type":"text","text":"import type { Finding } from '../types/index.js';\nimport type { AIRunSummary } from '../ai/telemetry.js';\n\n// ---------------------------------------------------------------------------\n// SpecRecommendation\n// ---------------------------------------------------------------------------\n\n/**\n * A recommendation to improve the support bundle specification, generated\n * from evidence gaps and heuristic findings discovered during investigation.\n *\n * - `collector`  — suggests adding or expanding a data collector so future\n *                  bundles contain the missing artifact class.\n * - `analyzer`   — suggests adding a deterministic analyzer to replace a\n *                  heuristic finding (improves precision and repeatability).\n * - `redaction`  — suggests adding a redaction rule when sensitive data paths\n *                  appear in evidence but no existing rule covers them.\n */\nexport type SpecRecommendationType = 'collector' | 'analyzer' | 'redaction';\n\nexport interface SpecRecommendation {\n  /** The category of spec improvement being suggested. */\n  type: SpecRecommendationType;\n  /**\n   * Human-readable description of the recommended spec change.\n   * Should be concise and actionable (one or two sentences).\n   */\n  description: string;\n  /**\n   * Explanation of why this recommendation was generated — which evidence gap\n   * or heuristic finding triggered it, so the suggestion is traceable.\n   */\n  rationale: string;\n}\n\n// ---------------------------------------------------------------------------\n// ReportOptions\n// ---------------------------------------------------------------------------\n\nexport type ReportFormat = 'markdown' | 'html' | 'json';\n\n/**\n * Configuration options controlling how a report is written to disk.\n *\n * - `format`        — output format (default: `'markdown'`)\n * - `outputDir`     — directory where the report file will be written\n *                     (default: current working directory)\n * - `includeTrace`  — when `true`, the full investigation trace is appended\n *                     as a separate section / field in the report\n */\nexport interface ReportOptions {\n  format?: ReportFormat;\n  outputDir?: string;\n  includeTrace?: boolean;\n}\n\n// ---------------------------------------------------------------------------\n// InvestigationReport\n// ---------------------------------------------------------------------------\n\n/**\n * The top-level output of the reporting layer.\n *\n * All fields are serialisation-safe (no class instances, no functions) so the\n * report can be written to JSON, Markdown, or HTML without transformation.\n */\nexport interface InvestigationReport {\n  /**\n   * High-level narrative written for a human reader — typically 2–4 sentences\n   * summarising the most critical finding, the overall confidence, and the\n   * recommended immediate action.\n   */\n  executiveSummary: string;\n\n  /**\n   * Verified, deduplicated findings sorted by severity then confidence\n   * (highest first).  This is the primary payload for report consumers.\n   */\n  findings: Finding[];\n\n  /**\n   * The single most likely root cause for the observed symptoms.  Derived\n   * from the highest-ranked finding; may be `null` when no findings exist.\n   */\n  rootCause: string | null;\n\n  /**\n   * Flat list of all evidence references cited across every finding, with\n   * duplicates removed.  Useful for report sections that list all touched\n   * files in one place.\n   */\n  evidenceReferences: Array<{ path: string; note: string }>;\n\n  /**\n   * Union of `contradictionsChecked` strings across all findings, with\n   * duplicates removed.  Surfaces the \"what we checked and ruled out\"\n   * narrative for the reader.\n   */\n  contradictions: string[];\n\n  /**\n   * Consolidated recommended next steps drawn from `recommendedAction` on\n   * every finding (highest-severity first).  Duplicates are removed.\n   */\n  nextSteps: string[];\n\n  /**\n   * Union of `missingEvidence` strings across all findings, with duplicates\n   * removed.  Tells the reader what additional data would improve confidence.\n   */\n  missingEvidence: string[];\n\n  /**\n   * Suggestions for improving the support bundle spec — collectors, analyzers,\n   * or redaction rules that should be added to prevent evidence gaps in future\n   * bundles.  Empty when the investigation found sufficient coverage.\n   */\n  specRecommendations: SpecRecommendation[];\n\n  /** Summary of AI model usage, latency, and token/cost telemetry for this run. */\n  aiSummary?: AIRunSummary;\n}\n"}],"isError":false,"timestamp":1774122830947}}
+{"type":"message","id":"22ff16f6","parentId":"9f17d632","timestamp":"2026-03-21T19:53:50.947Z","message":{"role":"toolResult","toolCallId":"call_Nir4rMlGG9DJdv15oZuEDbTE|fc_0f9932afa4a686050169bef74b47e8819b8032462e6cf23662","toolName":"read","content":[{"type":"text","text":"import type { PipelineResult } from '../pipeline/analyze.js';\nimport type { Finding } from '../types/index.js';\nimport type { InvestigationReport } from './types.js';\nimport { generateSpecRecommendations } from './spec-recommender.js';\nimport { cleanEvidencePath, humanizeTitle } from './display-helpers.js';\n\n// ---------------------------------------------------------------------------\n// AI finding helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Returns `true` when a finding was produced by the AI investigator.\n *\n * AI findings carry IDs prefixed with `finding:ai:`, assigned by\n * `convertAIFindings` in the AI investigator.\n */\nexport function isAIFinding(finding: Finding): boolean {\n  return finding.id.startsWith('finding:ai:');\n}\n\n/**\n * Returns the number of distinct `artifactType` values across all evidence\n * items in a finding.\n *\n * A value of 2 or more means the finding corroborates evidence from at least\n * two different artifact categories (e.g., log + kubernetes-resource), which\n * indicates cross-source correlation.\n */\nfunction countDistinctArtifactTypes(finding: Finding): number {\n  const types = new Set<string>();\n  for (const ev of finding.evidence) {\n    if (ev.artifactType !== undefined && ev.artifactType.trim().length > 0) {\n      types.add(ev.artifactType);\n    }\n  }\n  return types.size;\n}\n\n// ---------------------------------------------------------------------------\n// Internal helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Generates a concise, human-readable executive summary from the ranked list\n * of findings and the bundle profile.\n *\n * When no findings are present the summary states that no significant issues\n * were detected.  When findings are present the summary names the top finding,\n * states the overall count and highest severity level, and quotes the\n * recommended action so a reader can act immediately.\n *\n * When AI-augmented findings are present, the summary appends a sentence\n * noting AI analysis was used along with the count of AI findings.\n */\nfunction generateExecutiveSummary(findings: Finding[]): string {\n  if (findings.length === 0) {\n    return (\n      'No significant issues were identified in this support bundle. ' +\n      'All investigated conditions appear normal.'\n    );\n  }\n\n  const topFinding = findings[0]!;\n  const criticalCount = findings.filter((f) => f.severity === 'critical').length;\n  const highCount = findings.filter((f) => f.severity === 'high').length;\n\n  const severitySummary =\n    criticalCount > 0\n      ? `${criticalCount} critical issue${criticalCount > 1 ? 's' : ''} require${criticalCount === 1 ? 's' : ''} immediate attention.`\n      : highCount > 0\n        ? `${highCount} high-severity issue${highCount > 1 ? 's' : ''} ${highCount === 1 ? 'was' : 'were'} found.`\n        : '';\n\n  const confidencePct = Math.round(topFinding.confidence * 100);\n\n  const aiFindings = findings.filter(isAIFinding);\n  const aiFindingCount = aiFindings.length;\n  const crossSourceAIFindingCount = aiFindings.filter(\n    (finding) => countDistinctArtifactTypes(finding) >= 2,\n  ).length;\n  const aiNote =\n    aiFindingCount > 0\n      ? crossSourceAIFindingCount > 0\n        ? `AI-augmented analysis contributed ${aiFindingCount} finding${aiFindingCount > 1 ? 's' : ''}, including ${crossSourceAIFindingCount} with cross-source evidence correlation.`\n        : `AI-augmented analysis contributed ${aiFindingCount} finding${aiFindingCount > 1 ? 's' : ''}.`\n      : '';\n\n  return [\n    `Investigation identified ${findings.length} finding${findings.length > 1 ? 's' : ''}.`,\n    severitySummary,\n    `Most significant: ${humanizeTitle(topFinding.title)} (confidence: ${confidencePct}%).`,\n    `Recommended action: ${topFinding.recommendedAction}`,\n    aiNote,\n  ]\n    .filter(Boolean)\n    .join(' ');\n}\n\n/**\n * Derives a root-cause string from the verified findings list.\n *\n * Selection logic (in priority order):\n * 1. AI findings with evidence spanning 2+ distinct `artifactType` values\n *    (cross-source correlation — most trustworthy causal explanation).\n * 2. All other findings (first by severity+confidence ordering, which callers\n *    are expected to preserve before passing findings here).\n *\n * Returns `null` when there are no findings.\n */\nfunction deriveRootCause(findings: Finding[]): string | null {\n  if (findings.length === 0) return null;\n\n  // Prefer cross-source AI findings (evidence from 2+ distinct artifact types)\n  const crossSourceAI = findings.filter(\n    (f) => isAIFinding(f) && countDistinctArtifactTypes(f) >= 2,\n  );\n  if (crossSourceAI.length > 0) {\n    return crossSourceAI[0]!.reasoningSummary;\n  }\n\n  // Fall back to the highest-ranked finding (callers sort by severity desc, confidence desc)\n  return findings[0]!.reasoningSummary;\n}\n\n/**\n * Collects all evidence references across findings, deduplicating by path.\n * The first note encountered for a given path is retained.\n */\nfunction collectEvidenceReferences(\n  findings: Finding[],\n): Array<{ path: string; note: string }> {\n  const seen = new Set<string>();\n  const refs: Array<{ path: string; note: string }> = [];\n\n  for (const finding of findings) {\n    for (const ev of finding.evidence) {\n      const cleanedPath = cleanEvidencePath(ev.path);\n      if (!seen.has(cleanedPath)) {\n        seen.add(cleanedPath);\n        refs.push({ path: cleanedPath, note: ev.note });\n      }\n    }\n  }\n\n  return refs;\n}\n\n/**\n * Generic helper: flattens a string field from every finding, deduplicating\n * by exact string equality while preserving insertion order.\n */\nfunction collectDeduped(\n  getItems: (finding: Finding) => string[],\n  findings: Finding[],\n): string[] {\n  const seen = new Set<string>();\n  const result: string[] = [];\n\n  for (const finding of findings) {\n    for (const item of getItems(finding)) {\n      if (!seen.has(item)) {\n        seen.add(item);\n        result.push(item);\n      }\n    }\n  }\n\n  return result;\n}\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\n/**\n * Assembles an {@link InvestigationReport} from a completed\n * {@link PipelineResult}.\n *\n * The function:\n * 1. Generates an **executive summary** naming the most critical finding,\n *    the total finding count, and the recommended immediate action.\n * 2. Passes the already-ranked `findings[]` through unchanged (the\n *    orchestrator sorts them by severity then confidence).\n * 3. Derives the **root cause** from the highest-ranked finding's\n *    `reasoningSummary`.\n * 4. Collects deduplicated **evidence references**, **contradictions**,\n *    **next steps**, and **missing evidence** across all findings.\n * 5. Calls {@link generateSpecRecommendations} to produce collector,\n *    analyzer, and redaction suggestions from evidence gaps and the bundle\n *    profile's coverage gaps.\n *\n * All fields in the returned report are serialisation-safe (no class\n * instances, no functions) so the result can be passed directly to any of\n * the three reporters.\n *\n * @param result - The completed pipeline result containing findings, profile,\n *                 and all parsed bundle data.\n * @returns A fully assembled {@link InvestigationReport}.\n */\nexport function buildReport(result: PipelineResult): InvestigationReport {\n  const { findings, profile } = result;\n\n  const executiveSummary = generateExecutiveSummary(findings);\n  const rootCause = deriveRootCause(findings);\n  const specRecommendations = generateSpecRecommendations(findings, profile);\n  const evidenceReferences = collectEvidenceReferences(findings);\n  const contradictions = collectDeduped((f) => f.contradictionsChecked, findings);\n  const nextSteps = collectDeduped((f) => [f.recommendedAction], findings);\n  const missingEvidence = collectDeduped((f) => f.missingEvidence, findings);\n\n  return {\n    executiveSummary,\n    findings,\n    rootCause,\n    evidenceReferences,\n    contradictions,\n    nextSteps,\n    missingEvidence,\n    specRecommendations,\n    aiSummary: result.trace.aiSummary,\n  };\n}\n"}],"isError":false,"timestamp":1774122830947}}
+{"type":"message","id":"c149c2af","parentId":"22ff16f6","timestamp":"2026-03-21T19:53:50.948Z","message":{"role":"toolResult","toolCallId":"call_fxyn12Nn5o6A30iWSuRRt7Qw|fc_0f9932afa4a686050169bef74b47f0819b9c26c801d8b7dbc7","toolName":"read","content":[{"type":"text","text":"import * as fsp from 'fs/promises';\nimport * as path from 'path';\nimport type { InvestigationReport } from './types.js';\nimport { cleanEvidencePath, humanizeTitle } from './display-helpers.js';\n\n// ---------------------------------------------------------------------------\n// Constants\n// ---------------------------------------------------------------------------\n\n/** Identifies the schema version of the JSON output.  Increment on breaking changes. */\nconst REPORT_SCHEMA_VERSION = '1.0.0';\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\nexport interface JsonReportOptions {\n  includeProvenance?: boolean;\n}\n\n/**\n * Serializes an {@link InvestigationReport} to a well-structured JSON string.\n *\n * The output includes:\n * - Report metadata: `schemaVersion` and `generatedAt` (ISO-8601 timestamp).\n * - All top-level report fields: `executiveSummary`, `rootCause`,\n *   `evidenceReferences`, `contradictions`, `nextSteps`, `missingEvidence`,\n *   and `specRecommendations`.\n * - A `findings` array where every finding is serialized with its full set of\n *   fields: `id`, `title`, `severity`, `confidence`, `affectedComponents`,\n *   `reasoningSummary`, `evidence`, `contradictionsChecked`,\n *   `recommendedAction`, and `missingEvidence`.\n *\n * The JSON is formatted with 2-space indentation for human readability.  The\n * output is safe for `JSON.parse` round-tripping — no circular references, no\n * class instances, no functions.\n *\n * @param report - The investigation report to serialize.\n * @returns A JSON string representing the full investigation report.\n */\nexport function generateJsonReport(\n  report: InvestigationReport,\n  options: JsonReportOptions = {},\n): string {\n  const output = {\n    schemaVersion: REPORT_SCHEMA_VERSION,\n    generatedAt: new Date().toISOString(),\n    executiveSummary: report.executiveSummary,\n    rootCause: report.rootCause,\n    findings: report.findings.map((finding) => {\n      const base = {\n        id: finding.id,\n        title: humanizeTitle(finding.title),\n        severity: finding.severity,\n        confidence: finding.confidence,\n        affectedComponents: finding.affectedComponents.map(cleanEvidencePath),\n        reasoningSummary: finding.reasoningSummary,\n        evidence: finding.evidence.map((ev) => {\n          const evOut: Record<string, unknown> = {\n            path: cleanEvidencePath(ev.path),\n            note: ev.note,\n          };\n          if (ev.artifactType !== undefined) {\n            evOut['artifactType'] = ev.artifactType;\n          }\n          if (ev.timestamp !== undefined) {\n            evOut['timestamp'] = ev.timestamp;\n          }\n          return evOut;\n        }),\n        contradictionsChecked: finding.contradictionsChecked,\n        recommendedAction: finding.recommendedAction,\n        missingEvidence: finding.missingEvidence,\n        ...(finding.confidenceQuality !== undefined\n          ? { confidenceQuality: finding.confidenceQuality }\n          : {}),\n        ...(options.includeProvenance === true && finding.provenance !== undefined\n          ? { provenance: finding.provenance }\n          : {}),\n      };\n      return base;\n    }),\n    evidenceReferences: report.evidenceReferences.map((ev) => ({\n      path: cleanEvidencePath(ev.path),\n      note: ev.note,\n    })),\n    contradictions: report.contradictions,\n    nextSteps: report.nextSteps,\n    missingEvidence: report.missingEvidence,\n    specRecommendations: report.specRecommendations,\n    ...(report.aiSummary !== undefined ? { aiSummary: report.aiSummary } : {}),\n  };\n\n  return JSON.stringify(output, null, 2);\n}\n\n/**\n * Writes an {@link InvestigationReport} as a JSON file to disk.\n *\n * The report is written to `findings.json` inside `outputDir`.  The directory\n * is created recursively if it does not already exist.\n *\n * @param report    - The investigation report to write.\n * @param outputDir - Directory where `findings.json` will be created.\n * @returns The absolute path of the written file.\n */\nexport async function writeJsonReport(\n  report: InvestigationReport,\n  outputDir: string,\n  options: JsonReportOptions = {},\n): Promise<string> {\n  const resolvedOutputDir = path.resolve(outputDir);\n  await fsp.mkdir(resolvedOutputDir, { recursive: true });\n  const outFile = path.join(resolvedOutputDir, 'findings.json');\n  await fsp.writeFile(outFile, generateJsonReport(report, options), 'utf-8');\n  return outFile;\n}\n"}],"isError":false,"timestamp":1774122830948}}
+{"type":"message","id":"37aeb721","parentId":"c149c2af","timestamp":"2026-03-21T19:53:50.948Z","message":{"role":"toolResult","toolCallId":"call_0610GXAjWDj6EFulaDDtxABj|fc_0f9932afa4a686050169bef74b47f8819b98ab4a26cf192070","toolName":"read","content":[{"type":"text","text":"import * as fsp from 'fs/promises';\nimport * as path from 'path';\nimport type { Finding, FindingSeverity } from '../types/index.js';\nimport type { InvestigationReport, SpecRecommendation } from './types.js';\nimport { isAIFinding } from './report-builder.js';\nimport {\n  cleanEvidencePath,\n  humanizeTitle,\n  humanizeReasoning,\n  collapseEvidence,\n  formatSummaryCard,\n} from './display-helpers.js';\n\n// ---------------------------------------------------------------------------\n// Severity helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Maps a {@link FindingSeverity} to a Markdown-renderable badge string.\n * Uses text-only markers (no emoji) for maximum terminal compatibility.\n */\nfunction severityBadge(severity: FindingSeverity): string {\n  const labels: Record<FindingSeverity, string> = {\n    critical: '[!!] CRITICAL',\n    high: '[!] HIGH',\n    medium: '[~] MEDIUM',\n    low: '[-] LOW',\n    info: '[i] INFO',\n  };\n  return `**${labels[severity]}**`;\n}\n\n/**\n * Returns a confidence percentage string with an optional quality indicator.\n * e.g. `0.87` with quality `'strong'` → `\"87% (strong)\"`.\n * Clamps the value to [0, 1] before formatting.\n */\nfunction formatConfidence(confidence: number, quality?: Finding['confidenceQuality']): string {\n  const clamped = Math.min(1, Math.max(0, confidence));\n  const pct = `${Math.round(clamped * 100)}%`;\n  if (quality === undefined) return pct;\n  return `${pct} (${quality})`;\n}\n\n// ---------------------------------------------------------------------------\n// Section renderers\n// ---------------------------------------------------------------------------\n\n/**\n * Renders the top-level H1 title and executive summary.\n */\nfunction renderExecutiveSummary(report: InvestigationReport): string {\n  const lines: string[] = [];\n  lines.push('# Investigation Report');\n  lines.push('');\n\n  // \"Start here\" card for the top finding\n  if (report.findings.length > 0) {\n    lines.push(formatSummaryCard(report.findings[0]!, report.findings.length));\n    lines.push('');\n  }\n\n  lines.push('## Executive Summary');\n  lines.push('');\n  lines.push(report.executiveSummary);\n  lines.push('');\n\n  if (report.rootCause !== null) {\n    lines.push(`**Root Cause:** ${humanizeReasoning(report.rootCause)}`);\n    lines.push('');\n  }\n\n  return lines.join('\\n');\n}\n\n/**\n * Renders the evidence table for a single finding.\n *\n * | Path | Note |\n * |------|------|\n * | …   | …   |\n */\nfunction renderEvidenceTable(finding: Finding): string {\n  if (finding.evidence.length === 0) {\n    return '_No evidence recorded._\\n';\n  }\n\n  const collapsed = collapseEvidence(finding.evidence);\n  const rows = collapsed.map((ev) => {\n    const cleanedPath = cleanEvidencePath(ev.path);\n    const escapedPath = cleanedPath.replace(/\\|/g, '\\\\|');\n    const escapedNote = ev.note.replace(/\\|/g, '\\\\|');\n    return `| \\`${escapedPath}\\` | ${escapedNote} |`;\n  });\n\n  return ['| Path | Note |', '|------|------|', ...rows].join('\\n') + '\\n';\n}\n\n/**\n * Renders all findings as numbered H3 subsections, sorted by their position\n * in the supplied `findings` array (callers are responsible for ordering).\n */\nfunction renderFindings(findings: Finding[]): string {\n  if (findings.length === 0) {\n    return '## Findings\\n\\n_No findings recorded._\\n';\n  }\n\n  const lines: string[] = [];\n  lines.push('## Findings');\n  lines.push('');\n\n  findings.forEach((finding, idx) => {\n    const aiTag = isAIFinding(finding) ? ' [AI-assisted]' : '';\n    const displayTitle = humanizeTitle(finding.title);\n    lines.push(`### ${idx + 1}. ${displayTitle}${aiTag}`);\n    lines.push('');\n\n    // Severity badge + confidence on the same line for scannability\n    lines.push(\n      `${severityBadge(finding.severity)} · Confidence: **${formatConfidence(finding.confidence, finding.confidenceQuality)}**`,\n    );\n    lines.push('');\n\n    // Affected components (clean temp paths)\n    if (finding.affectedComponents.length > 0) {\n      lines.push(\n        `**Affected Components:** ${finding.affectedComponents.map((c) => `\\`${cleanEvidencePath(c)}\\``).join(', ')}`,\n      );\n      lines.push('');\n    }\n\n    // Reasoning\n    lines.push('**Reasoning**');\n    lines.push('');\n    lines.push(humanizeReasoning(finding.reasoningSummary));\n    lines.push('');\n\n    // Evidence table\n    lines.push('**Evidence**');\n    lines.push('');\n    lines.push(renderEvidenceTable(finding));\n\n    // Contradictions checked\n    if (finding.contradictionsChecked.length > 0) {\n      lines.push('**Contradictions Checked**');\n      lines.push('');\n      for (const contradiction of finding.contradictionsChecked) {\n        lines.push(`- ${contradiction}`);\n      }\n      lines.push('');\n    }\n\n    // Recommended action\n    lines.push('**Recommended Action**');\n    lines.push('');\n    lines.push(finding.recommendedAction);\n    lines.push('');\n  });\n\n  return lines.join('\\n');\n}\n\n/**\n * Renders the missing evidence section listing all gaps consolidated across\n * all findings.\n */\nfunction renderMissingEvidence(missingEvidence: string[]): string {\n  const lines: string[] = [];\n  lines.push('## Missing Evidence');\n  lines.push('');\n\n  if (missingEvidence.length === 0) {\n    lines.push('_No missing evidence identified._');\n    lines.push('');\n  } else {\n    for (const item of missingEvidence) {\n      lines.push(`- ${item}`);\n    }\n    lines.push('');\n  }\n\n  return lines.join('\\n');\n}\n\n/**\n * Renders the spec improvement recommendations section.\n */\nfunction renderSpecRecommendations(recommendations: SpecRecommendation[]): string {\n  const lines: string[] = [];\n  lines.push('## Spec Improvement Recommendations');\n  lines.push('');\n\n  if (recommendations.length === 0) {\n    lines.push('_No spec improvements recommended._');\n    lines.push('');\n    return lines.join('\\n');\n  }\n\n  recommendations.forEach((rec, idx) => {\n    const typeLabel =\n      rec.type === 'collector'\n        ? '[+] Collector'\n        : rec.type === 'analyzer'\n          ? '[?] Analyzer'\n          : '[x] Redaction';\n\n    lines.push(`### ${idx + 1}. ${typeLabel}`);\n    lines.push('');\n    lines.push(rec.description);\n    lines.push('');\n    lines.push(`_Rationale: ${rec.rationale}_`);\n    lines.push('');\n  });\n\n  return lines.join('\\n');\n}\n\n/**\n * Renders the investigation metadata footer.\n */\nfunction renderMetadataFooter(report: InvestigationReport, generatedAt: string): string {\n  const lines: string[] = [];\n  lines.push('---');\n  lines.push('');\n  lines.push('## Investigation Metadata');\n  lines.push('');\n  lines.push(`| Field | Value |`);\n  lines.push(`|-------|-------|`);\n  lines.push(`| Generated At | ${generatedAt} |`);\n  lines.push(`| Total Findings | ${report.findings.length} |`);\n  lines.push(`| Evidence References | ${report.evidenceReferences.length} |`);\n  lines.push(`| Contradictions Checked | ${report.contradictions.length} |`);\n  lines.push(`| Spec Recommendations | ${report.specRecommendations.length} |`);\n  lines.push('');\n\n  return lines.join('\\n');\n}\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\n/**\n * Generates a Markdown document from an {@link InvestigationReport}.\n *\n * The document contains:\n * 1. **Executive summary** — bundle info, top-level diagnosis, and root cause.\n * 2. **Ranked findings** — each finding rendered as a subsection with severity\n *    badge, confidence score, affected components, reasoning paragraph,\n *    evidence table (path + note), contradictions-checked list, and recommended\n *    action.\n * 3. **Missing evidence** — consolidated list of evidence gaps across all findings.\n * 4. **Spec improvement recommendations** — collector, analyzer, and redaction\n *    suggestions categorised and rationale-annotated.\n * 5. **Investigation metadata footer** — counts and timestamp rendered as a\n *    summary table.\n *\n * @param report - The investigation report to render.\n * @returns A UTF-8 Markdown string.\n */\nexport function generateMarkdownReport(report: InvestigationReport): string {\n  const generatedAt = new Date().toISOString();\n\n  const sections = [\n    renderExecutiveSummary(report),\n    renderFindings(report.findings),\n    renderMissingEvidence(report.missingEvidence),\n    renderSpecRecommendations(report.specRecommendations),\n    renderMetadataFooter(report, generatedAt),\n  ];\n\n  return sections.join('\\n');\n}\n\n/**\n * Writes an {@link InvestigationReport} as a Markdown file to disk.\n *\n * The report is written to `findings.md` inside `outputDir`.  The directory\n * is created recursively if it does not already exist.\n *\n * @param report    - The investigation report to write.\n * @param outputDir - Directory where `findings.md` will be created.\n * @returns The absolute path of the written file.\n */\nexport async function writeMarkdownReport(\n  report: InvestigationReport,\n  outputDir: string,\n): Promise<string> {\n  const resolvedOutputDir = path.resolve(outputDir);\n  await fsp.mkdir(resolvedOutputDir, { recursive: true });\n  const outFile = path.join(resolvedOutputDir, 'findings.md');\n  await fsp.writeFile(outFile, generateMarkdownReport(report), 'utf-8');\n  return outFile;\n}\n"}],"isError":false,"timestamp":1774122830948}}
+{"type":"message","id":"4f5b6f40","parentId":"37aeb721","timestamp":"2026-03-21T19:53:50.948Z","message":{"role":"toolResult","toolCallId":"call_1ERbf7gInJNJTqLbccXOaXjV|fc_0f9932afa4a686050169bef74b4800819b8f0ebe20d4f57e1b","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from 'vitest';\nimport type { Finding, FindingSeverity, ArtifactCategory } from '../../types/index.js';\nimport type { BundleProfile } from '../../types/index.js';\nimport type { PipelineResult } from '../../pipeline/analyze.js';\nimport type { InvestigationGraphImpl } from '../../graph/index.js';\nimport type { InvestigationTrace } from '../../pipeline/trace.js';\nimport { buildReport } from '../report-builder.js';\n\n// ---------------------------------------------------------------------------\n// Fixture helpers\n// ---------------------------------------------------------------------------\n\nfunction makeFinding(overrides: Partial<Finding> = {}): Finding {\n  return {\n    id: 'finding:test:0',\n    title: 'Test Finding',\n    severity: 'high' as FindingSeverity,\n    confidence: 0.75,\n    affectedComponents: ['web', 'api'],\n    reasoningSummary: 'A database hostname misconfiguration is causing DNS lookup failures.',\n    evidence: [\n      {\n        path: 'logs/app/current.log',\n        note: 'lookup db.internal: no such host',\n        artifactType: 'log',\n      },\n    ],\n    contradictionsChecked: ['No successful DB connection logs found'],\n    recommendedAction: 'Update the DB_HOST environment variable to the correct hostname.',\n    missingEvidence: ['Kubernetes events for pod app-pod'],\n    ...overrides,\n  };\n}\n\nfunction makeCriticalFinding(): Finding {\n  return makeFinding({\n    id: 'finding:test:critical',\n    title: 'CrashLoopBackOff: Pod crashing at startup',\n    severity: 'critical',\n    confidence: 0.95,\n    reasoningSummary: 'The app-pod is in CrashLoopBackOff due to a missing secret.',\n    recommendedAction: 'Create the missing secret app-credentials.',\n    missingEvidence: ['Container logs for app-pod'],\n    contradictionsChecked: ['Pod is not in Running state'],\n  });\n}\n\nfunction makeMinimalProfile(): BundleProfile {\n  const emptyByCategory: Record<ArtifactCategory, number> = {\n    analyzer: 0,\n    log: 0,\n    'kubernetes-resource': 0,\n    event: 0,\n    'cluster-info': 0,\n    'helm-release': 0,\n    unknown: 0,\n  };\n  return {\n    manifest: {\n      bundlePath: '/tmp/test.tar.gz',\n      extractedPath: '/tmp/extracted',\n      files: [],\n      totalSize: 0,\n      extractedAt: new Date(),\n    },\n    analyzerCount: 1,\n    resourceCount: 2,\n    eventCount: 1,\n    logFileCount: 1,\n    namespaces: ['default'],\n    workloads: [],\n    coverageGaps: [],\n    artifactsByCategory: emptyByCategory,\n  };\n}\n\nfunction makePipelineResult(findings: Finding[] = []): PipelineResult {\n  return {\n    profile: makeMinimalProfile(),\n    analyzerResults: [],\n    resources: [],\n    events: [],\n    logs: [],\n    findings,\n    findingTree: [],\n    graph: {\n      nodes: new Map(),\n      edges: [],\n    } as unknown as InvestigationGraphImpl,\n    trace: {\n      bundlePath: '/tmp/test.tar.gz',\n      startedAt: new Date().toISOString(),\n      completedAt: new Date().toISOString(),\n      steps: [],\n    } as unknown as InvestigationTrace,\n    aiMode: 'off',\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Section 1: buildReport — return type and structure\n// ---------------------------------------------------------------------------\n\ndescribe('buildReport — return type and structure', () => {\n  it('returns an object with executiveSummary', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect(typeof report.executiveSummary).toBe('string');\n  });\n\n  it('returns an object with findings array', () => {\n    const result = makePipelineResult([makeFinding()]);\n    const report = buildReport(result);\n    expect(Array.isArray(report.findings)).toBe(true);\n  });\n\n  it('returns an object with rootCause', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect('rootCause' in report).toBe(true);\n  });\n\n  it('returns an object with evidenceReferences array', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect(Array.isArray(report.evidenceReferences)).toBe(true);\n  });\n\n  it('returns an object with contradictions array', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect(Array.isArray(report.contradictions)).toBe(true);\n  });\n\n  it('returns an object with nextSteps array', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect(Array.isArray(report.nextSteps)).toBe(true);\n  });\n\n  it('returns an object with missingEvidence array', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect(Array.isArray(report.missingEvidence)).toBe(true);\n  });\n\n  it('returns an object with specRecommendations array', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect(Array.isArray(report.specRecommendations)).toBe(true);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Section 2: buildReport — findings pass-through\n// ---------------------------------------------------------------------------\n\ndescribe('buildReport — findings pass-through', () => {\n  it('report findings array matches input findings', () => {\n    const findings = [makeFinding({ id: 'f:0' }), makeFinding({ id: 'f:1' })];\n    const report = buildReport(makePipelineResult(findings));\n    expect(report.findings.length).toBe(2);\n    expect(report.findings[0]!.id).toBe('f:0');\n    expect(report.findings[1]!.id).toBe('f:1');\n  });\n\n  it('report findings are the same array reference (no copy)', () => {\n    const findings = [makeFinding()];\n    const result = makePipelineResult(findings);\n    const report = buildReport(result);\n    expect(report.findings).toBe(result.findings);\n  });\n\n  it('report findings array is empty when pipeline has no findings', () => {\n    const report = buildReport(makePipelineResult([]));\n    expect(report.findings.length).toBe(0);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Section 3: buildReport — root cause\n// ---------------------------------------------------------------------------\n\ndescribe('buildReport — root cause', () => {\n  it('rootCause is null when there are no findings', () => {\n    const report = buildReport(makePipelineResult([]));\n    expect(report.rootCause).toBeNull();\n  });\n\n  it('rootCause is non-null when there is at least one finding', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect(report.rootCause).not.toBeNull();\n  });\n\n  it('rootCause is derived from the first (highest-ranked) finding', () => {\n    const topFinding = makeFinding({\n      id: 'top',\n      reasoningSummary: 'The main root cause of all failures.',\n    });\n    const secondFinding = makeFinding({\n      id: 'second',\n      reasoningSummary: 'Secondary reasoning.',\n    });\n    const report = buildReport(makePipelineResult([topFinding, secondFinding]));\n    expect(report.rootCause).toBe('The main root cause of all failures.');\n  });\n\n  it('rootCause is a string when a finding is present', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect(typeof report.rootCause).toBe('string');\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Section 4: buildReport — executive summary\n// ---------------------------------------------------------------------------\n\ndescribe('buildReport — executive summary', () => {\n  it('executive summary is non-empty for a report with findings', () => {\n    const report = buildReport(makePipelineResult([makeFinding()]));\n    expect(report.executiveSummary.length).toBeGreaterThan(0);\n  });\n\n  it('executive summary mentions the finding count', () => {\n    const findings = [makeFinding({ id: 'f:0' }), makeFinding({ id: 'f:1' })];\n    const report = buildReport(makePipelineResult(findings));\n    expect(report.executiveSummary).toContain('2');\n  });\n\n  it('executive summary mentions critical count when critical findings present', () => {\n    const report = buildReport(makePipelineResult([makeCriticalFinding()]));\n    expect(report.executiveSummary.toLowerCase()).toContain('critical');\n  });\n\n  it('executive summary states no issues when there are no findings', () => {\n    const report = buildReport(makePipelineResult([]));\n    expect(report.executiveSummary.toLowerCase()).toContain('no significant issues');\n  });\n\n  it('executive summary includes the top finding title', () => {\n    const finding = makeFinding({ title: 'CrashLoopBackOff: Pod app-pod' });\n    const report = buildReport(makePipelineResult([finding]));\n    expect(report.executiveSummary).toContain('CrashLoopBackOff: Pod app-pod');\n  });\n\n  it('executive summary includes recommended action from top finding', () => {\n    const finding = makeFinding({\n      recommendedAction: 'Restart the deployment immediately.',\n    });\n    const report = buildReport(makePipelineResult([finding]));\n    expect(report.executiveSummary).toContain('Restart the deployment immediately.');\n  });\n\n  it('executive summary humanizes legacy hypothesis titles', () => {\n    const finding = makeFinding({\n      title: '[Hypothesis] DNS failure for db.internal (symptom: Pod app-pod is not ready)',\n    });\n    const report = buildReport(makePipelineResult([finding]));\n    expect(report.executiveSummary).toContain('Most significant: DNS failure for db.internal');\n    expect(report.executiveSummary).not.toContain('[Hypothesis]');\n    expect(report.executiveSummary).not.toContain('(symptom:');\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Section 5: buildReport — evidence references\n// ---------------------------------------------------------------------------\n\n[224 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1774122830948}}
+{"type":"message","id":"4ab9c8f9","parentId":"4f5b6f40","timestamp":"2026-03-21T19:53:50.948Z","message":{"role":"toolResult","toolCallId":"call_inanT8SzUqLE3XX0hOTcRdmJ|fc_0f9932afa4a686050169bef74b4808819b80f9702c8e6cb780","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect, afterEach } from 'vitest';\nimport * as fsp from 'fs/promises';\nimport * as os from 'os';\nimport * as path from 'path';\nimport type { Finding, FindingSeverity } from '../../types/index.js';\nimport type { InvestigationReport, SpecRecommendation } from '../types.js';\nimport { generateJsonReport, writeJsonReport } from '../json-reporter.js';\n\n// ---------------------------------------------------------------------------\n// Fixture helpers\n// ---------------------------------------------------------------------------\n\nfunction makeFinding(overrides: Partial<Finding> = {}): Finding {\n  return {\n    id: 'finding:test:0',\n    title: 'Test Finding',\n    severity: 'high' as FindingSeverity,\n    confidence: 0.75,\n    affectedComponents: ['web', 'api'],\n    reasoningSummary: 'Test reasoning summary.',\n    evidence: [\n      {\n        path: 'logs/app/current.log',\n        note: 'lookup db.internal: no such host',\n        artifactType: 'log',\n        timestamp: '2024-01-01T00:00:00.000Z',\n      },\n    ],\n    contradictionsChecked: ['No successful DB connection logs found'],\n    recommendedAction: 'Update the DB host configuration.',\n    missingEvidence: ['Kubernetes events for pod app-pod'],\n    ...overrides,\n  };\n}\n\nfunction makeReport(overrides: Partial<InvestigationReport> = {}): InvestigationReport {\n  return {\n    executiveSummary: 'A database hostname misconfiguration is causing repeated DNS lookup failures.',\n    findings: [makeFinding()],\n    rootCause: 'Misconfigured DB hostname in environment variable DB_HOST.',\n    evidenceReferences: [\n      { path: 'logs/app/current.log', note: 'Repeated DNS lookup failures' },\n      { path: 'cluster-resources/services/default/', note: 'No matching Service found' },\n    ],\n    contradictions: ['No successful DB connection logs found'],\n    nextSteps: ['Update the DB host to the correct in-cluster Service name.'],\n    missingEvidence: ['Kubernetes events for pod app-pod'],\n    specRecommendations: [\n      {\n        type: 'collector',\n        description: 'Add a logs collector to capture container logs.',\n        rationale: 'Missing container logs prevent root-cause confirmation.',\n      } as SpecRecommendation,\n    ],\n    ...overrides,\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Section 1: generateJsonReport — top-level structure\n// ---------------------------------------------------------------------------\n\ndescribe('generateJsonReport — output is valid JSON', () => {\n  it('returns a string', () => {\n    const result = generateJsonReport(makeReport());\n    expect(typeof result).toBe('string');\n  });\n\n  it('output round-trips through JSON.parse without error', () => {\n    const result = generateJsonReport(makeReport());\n    expect(() => JSON.parse(result)).not.toThrow();\n  });\n\n  it('round-tripped object is a plain object (not null or array)', () => {\n    const result = generateJsonReport(makeReport());\n    const parsed: unknown = JSON.parse(result);\n    expect(parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)).toBe(true);\n  });\n});\n\ndescribe('generateJsonReport — metadata fields', () => {\n  it('includes a schemaVersion field', () => {\n    const parsed = JSON.parse(generateJsonReport(makeReport())) as Record<string, unknown>;\n    expect(parsed['schemaVersion']).toBeDefined();\n    expect(typeof parsed['schemaVersion']).toBe('string');\n  });\n\n  it('includes a generatedAt field', () => {\n    const parsed = JSON.parse(generateJsonReport(makeReport())) as Record<string, unknown>;\n    expect(parsed['generatedAt']).toBeDefined();\n    expect(typeof parsed['generatedAt']).toBe('string');\n  });\n\n  it('generatedAt is a valid ISO-8601 date string', () => {\n    const parsed = JSON.parse(generateJsonReport(makeReport())) as Record<string, unknown>;\n    const ts = parsed['generatedAt'] as string;\n    const date = new Date(ts);\n    expect(Number.isNaN(date.getTime())).toBe(false);\n  });\n});\n\ndescribe('generateJsonReport — top-level report fields', () => {\n  it('includes executiveSummary', () => {\n    const report = makeReport();\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(parsed['executiveSummary']).toBe(report.executiveSummary);\n  });\n\n  it('includes rootCause when non-null', () => {\n    const report = makeReport({ rootCause: 'Misconfigured DB hostname.' });\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(parsed['rootCause']).toBe('Misconfigured DB hostname.');\n  });\n\n  it('includes rootCause as null when report has no root cause', () => {\n    const report = makeReport({ rootCause: null });\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(parsed['rootCause']).toBeNull();\n  });\n\n  it('includes evidenceReferences array', () => {\n    const report = makeReport();\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(Array.isArray(parsed['evidenceReferences'])).toBe(true);\n    expect((parsed['evidenceReferences'] as unknown[]).length).toBe(\n      report.evidenceReferences.length,\n    );\n  });\n\n  it('includes contradictions array', () => {\n    const report = makeReport();\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(Array.isArray(parsed['contradictions'])).toBe(true);\n  });\n\n  it('includes nextSteps array', () => {\n    const report = makeReport();\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(Array.isArray(parsed['nextSteps'])).toBe(true);\n  });\n\n  it('includes missingEvidence array', () => {\n    const report = makeReport();\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(Array.isArray(parsed['missingEvidence'])).toBe(true);\n  });\n\n  it('includes specRecommendations array', () => {\n    const report = makeReport();\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(Array.isArray(parsed['specRecommendations'])).toBe(true);\n  });\n\n  it('includes findings array', () => {\n    const report = makeReport();\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(Array.isArray(parsed['findings'])).toBe(true);\n    expect((parsed['findings'] as unknown[]).length).toBe(report.findings.length);\n  });\n\n  it('includes aiSummary when present on the report', () => {\n    const report = makeReport({\n      aiSummary: {\n        model: 'gpt-4o',\n        backend: 'cloud',\n        totalCalls: 2,\n        successfulCalls: 2,\n        failedCalls: 0,\n        totalLatencyMs: 240,\n        avgLatencyMs: 120,\n        totalPromptTokens: 200,\n        totalCompletionTokens: 80,\n        estimatedCostUsd: 0.0042,\n      },\n    });\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    expect(parsed['aiSummary']).toEqual(report.aiSummary);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Section 2: generateJsonReport — finding fields\n// ---------------------------------------------------------------------------\n\ndescribe('generateJsonReport — finding field presence', () => {\n  function getParsedFinding(): Record<string, unknown> {\n    const report = makeReport();\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    return (parsed['findings'] as Record<string, unknown>[])[0]!;\n  }\n\n  it('finding has id field', () => {\n    expect(getParsedFinding()['id']).toBeDefined();\n  });\n\n  it('finding has title field', () => {\n    expect(getParsedFinding()['title']).toBeDefined();\n  });\n\n  it('finding has severity field', () => {\n    const f = getParsedFinding();\n    expect(f['severity']).toBeDefined();\n    expect(['critical', 'high', 'medium', 'low', 'info']).toContain(f['severity']);\n  });\n\n  it('finding has confidence field as a number', () => {\n    const f = getParsedFinding();\n    expect(typeof f['confidence']).toBe('number');\n  });\n\n  it('finding has affectedComponents array', () => {\n    expect(Array.isArray(getParsedFinding()['affectedComponents'])).toBe(true);\n  });\n\n  it('finding has reasoningSummary field', () => {\n    expect(typeof getParsedFinding()['reasoningSummary']).toBe('string');\n  });\n\n  it('finding has evidence array', () => {\n    expect(Array.isArray(getParsedFinding()['evidence'])).toBe(true);\n  });\n\n  it('finding has contradictionsChecked array', () => {\n    expect(Array.isArray(getParsedFinding()['contradictionsChecked'])).toBe(true);\n  });\n\n  it('finding has recommendedAction field', () => {\n    expect(typeof getParsedFinding()['recommendedAction']).toBe('string');\n  });\n\n  it('finding has missingEvidence array', () => {\n    expect(Array.isArray(getParsedFinding()['missingEvidence'])).toBe(true);\n  });\n\n  it('omits provenance by default', () => {\n    const report = makeReport({\n      findings: [\n        makeFinding({\n          provenance: {\n            investigator: 'log',\n            generatedAt: '2024-01-01T00:00:00.000Z',\n            seedId: 'seed:log:0',\n          },\n        }),\n      ],\n    });\n\n    const parsed = JSON.parse(generateJsonReport(report)) as Record<string, unknown>;\n    const finding = (parsed['findings'] as Record<string, unknown>[])[0]!;\n    expect(finding['provenance']).toBeUndefined();\n  });\n\n  it('includes provenance when includeProvenance is true