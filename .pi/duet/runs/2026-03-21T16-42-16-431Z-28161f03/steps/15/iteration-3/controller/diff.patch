+{"type":"message","id":"26928f74","parentId":"a44ce25a","timestamp":"2026-03-21T19:53:50.949Z","message":{"role":"toolResult","toolCallId":"call_V8kRFgr6bkLNDynnpdoc8yzP|fc_0f9932afa4a686050169bef74b4814819bab7e55c16441ff1b","toolName":"read","content":[{"type":"text","text":"import type { BundleProfile } from '../types/index.js';\nimport type { AIRunSummary } from '../ai/telemetry.js';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport interface RetrievalStats {\n  graphChunks: number;\n  lexicalChunks: number;\n  semanticChunks: number;\n  mergedChunks: number;\n}\n\nexport interface ConfidenceStats {\n  min: number;\n  max: number;\n  mean: number;\n  median: number;\n}\n\nexport interface HypothesisStats {\n  generated: number;\n  verified: number;\n  converted: number;\n}\n\nexport interface TraceStep {\n  name: string;\n  startedAt: string;\n  completedAt?: string;\n  artifactsProcessed: number;\n  errors?: string[];\n  seedCount?: number;\n  seedCategories?: Record<string, number>;\n  retrievalStats?: RetrievalStats;\n  confidenceStats?: ConfidenceStats;\n  hypothesisStats?: HypothesisStats;\n}\n\nexport interface InvestigationTrace {\n  bundlePath: string;\n  startedAt: string;\n  completedAt?: string;\n  steps: TraceStep[];\n  profile?: BundleProfile;\n  metadata?: Record<string, unknown>;\n  aiSummary?: AIRunSummary;\n}\n\n// ---------------------------------------------------------------------------\n// Factory\n// ---------------------------------------------------------------------------\n\n/**\n * Creates a new investigation trace for the given bundle path.\n */\nexport function createTrace(bundlePath: string): InvestigationTrace {\n  return {\n    bundlePath,\n    startedAt: new Date().toISOString(),\n    steps: [],\n  };\n}\n\n/**\n * Records the start of a new pipeline step and returns its index.\n *\n * The returned in