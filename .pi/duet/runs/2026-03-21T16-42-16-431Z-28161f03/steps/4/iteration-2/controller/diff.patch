+{"type":"message","id":"edcd1c01","parentId":"956236f4","timestamp":"2026-03-21T17:59:43.499Z","message":{"role":"toolResult","toolCallId":"call_vAYeW3K3l48T5w8DJUqN6EpM|fc_0f9932afa4a686050169bedc8f6594819b8cb7982ecf423f85","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// Golden Set Evaluator\n// ---------------------------------------------------------------------------\n//\n// Scores pipeline results against golden expectations. Returns a structured\n// report that can be serialised to JSON for nightly CI artifacts.\n\nimport type { Finding } from '../../src/types/index.js';\nimport type { ScenarioExpectation } from './expectations.js';\n\nexport interface EvalDetail {\n  check: string;\n  pass: boolean;\n  detail: string;\n}\n\nexport interface ScenarioEvalResult {\n  scenario: string;\n  pass: boolean;\n  score: number;\n  checks: EvalDetail[];\n}\n\nexport interface EvalReport {\n  timestamp: string;\n  scenarios: Record<string, ScenarioEvalResult>;\n  overallPass: boolean;\n  overallScore: number;\n}\n\nfunction allFindingsText(findings: Finding[]): string {\n  return findings\n    .map((f) => [\n      f.title,\n      f.reasoningSummary,\n      ...f.evidence.map((e) => `${e.path} ${e.note}`),\n    ].join(' '))\n    .join(' ');\n}\n\nexport function evaluateScenario(\n  scenarioName: string,\n  expectation: ScenarioExpectation,\n  findings: Finding[],\n): ScenarioEvalResult {\n  const checks: EvalDetail[] = [];\n  const top = findings[0];\n\n  // 1. Minimum findings count\n  checks.push({\n    check: 'minFindings',\n    pass: findings.length >= expectation.minFindings,\n    detail: `Expected >= ${expectation.minFindings}, got ${findings.length}`,\n  });\n\n  // 2. Top finding title matches\n  const topTitleMatch =\n    top !== undefined &&\n    expectation.topFindingMustMatch.some((re) => re.test(top.title));\n  checks.push({\n    check: 'topFindingTitle',\n    pass: topTitleMatch,\n    detail: top\n      ? `Top finding: \"${top.title}\"`\n      : 'No findings produced',\n  });\n\n  // 3. Top finding severity\n  const topSeverityMatch =\n    top !== undefined &&\n    expectation.topFindingSeverity.includes(top.severity);\n  checks.push({\n    check: 'topFindingSeverity',\n    pass: topSeverityMatch,\n    detail: top\n      ? `Got \"${top.severity}\", expected one of [${expectation.topFindingSeverity.join(', ')}]`\n      : 'No findings',\n  });\n\n  // 4. Top finding confidence\n  const topConfMatch =\n    top !== undefined &&\n    top.confidence >= expectation.topFindingMinConfidence;\n  checks.push({\n    check: 'topFindingConfidence',\n    pass: topConfMatch,\n    detail: top\n      ? `Got ${(top.confidence * 100).toFixed(0)}%, min ${(expectation.topFindingMinConfidence * 100).toFixed(0)}%`\n      : 'No findings',\n  });\n\n  // 5. Evidence citation coverage\n  const allPaths = findings.flatMap((f) => f.evidence.map((e) => e.path));\n  for (const pattern of expectation.mustCiteEvidence) {\n    const cited = allPaths.some((p) => pattern.test(p));\n    checks.push({\n      check: `mustCiteEvidence: ${pattern.source}`,\n      pass: cited,\n      detail: cited ? 'Found matching evidence path' : `No evidence path matches /${pattern.source}/`,\n    });\n  }\n\n  // 6. No hallucinations\n  const fullText = allFindingsText(findings);\n  for (const pattern of expectation.mustNotHallucinate) {\n    const found = pattern.test(fullText);\n    checks.push({\n      check: `mustNotHallucinate: ${pattern.source}`,\n      pass: !found,\n      detail: found\n        ? `HALLUCINATION DETECTED: /${pattern.source}/ found in findings text`\n        : 'Clean — pattern not found',\n    });\n  }\n\n  // 7. Root cause match\n  const rootCauseText = top?.reasoningSummary ?? '';\n  const rootCauseMatch = expectation.rootCauseMustMatch.some((re) =>\n    re.test(rootCauseText),\n  );\n  checks.push({\n    check: 'rootCauseMatch',\n    pass: rootCauseMatch,\n    detail: rootCauseMatch\n      ? 'Root cause reasoning matches expected pattern'\n      : `Root cause \"${rootCauseText.slice(0, 100)}\" did not match any expected pattern`,\n  });\n\n  // 8. Required identifiers\n  for (const id of expectation.mustMentionIdentifiers) {\n    const mentioned = fullText.toLowerCase().includes(id.toLowerCase());\n    checks.push({\n      check: `mustMention: ${id}`,\n      pass: mentioned,\n      detail: mentioned ? `Found \"${id}\"` : `\"${id}\" not found in any finding`,\n    });\n  }\n\n  const passCount = checks.filter((c) => c.pass).length;\n  const score = checks.length > 0 ? passCount / checks.length : 0;\n\n  return {\n    scenario: scenarioName,\n    pass: checks.every((c) => c.pass),\n    score,\n    checks,\n  };\n}\n\nexport function buildEvalReport(\n  results: Record<string, ScenarioEvalResult>,\n): EvalReport {\n  const scenarios = results;\n  const allResults = Object.values(scenarios);\n  const overallPass = allResults.every((r) => r.pass);\n  const overallScore =\n    allResults.length > 0\n      ? allResults.reduce((sum, r) => sum + r.score, 0) / allResults.length\n      : 0;\n\n  return {\n    timestamp: new Date().toISOString(),\n    scenarios,\n    overallPass,\n    overallScore,\n  };\n}\n"}],"isError":false,"timestamp":1774115983499}}
+{"type":"message","id":"2e4a5697","parentId":"edcd1c01","timestamp":"2026-03-21T17:59:43.499Z","message":{"role":"toolResult","toolCallId":"call_hb4VVkFR2KEmJcBPQcqE8912|fc_0f9932afa4a686050169bedc8f65a4819b8096a0fc08f20376","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// Golden Set Expectations\n// ---------------------------------------------------------------------------\n//\n// Defines structural expectations for each scenario. These are NOT about\n// exact LLM wording — they verify that the correct root cause appears, that\n// evidence is cited from the right artifacts, and that no hallucinations\n// appear.\n\nimport type { FindingSeverity } from '../../src/types/index.js';\n\nexport interface ScenarioExpectation {\n  /** Human-readable scenario name. */\n  name: string;\n  /** Minimum number of findings the pipeline should produce. */\n  minFindings: number;\n  /** Top finding title must match one of these patterns. */\n  topFindingMustMatch: RegExp[];\n  /** Acceptable severities for the top finding. */\n  topFindingSeverity: FindingSeverity[];\n  /** Minimum confidence for the top finding. */\n  topFindingMinConfidence: number;\n  /**\n   * Evidence paths across all findings must include at least one match\n   * per pattern.\n   */\n  mustCiteEvidence: RegExp[];\n  /**\n   * No finding title or reasoning should match these patterns.\n   * Catches hallucinations of wrong failure modes.\n   */\n  mustNotHallucinate: RegExp[];\n  /**\n   * Root cause (reasoning of top finding) must match at least one pattern.\n   */\n  rootCauseMustMatch: RegExp[];\n  /**\n   * Key identifiers that must appear somewhere in findings (titles,\n   * reasoning, evidence notes).\n   */\n  mustMentionIdentifiers: string[];\n}\n\nexport const GOLDEN_EXPECTATIONS: Record<string, ScenarioExpectation> = {\n  'bad-image-tag': {\n    name: 'Bad Image Tag (ImagePullBackOff)',\n    minFindings: 1,\n    topFindingMustMatch: [\n      /image.*pull/i,\n      /ImagePullBackOff/i,\n      /ErrImagePull/i,\n      /image.*tag/i,\n    ],\n    topFindingSeverity: ['critical'],\n    // Hypothesis evidence for image-pull-failure uses events + pod-status only\n    // (no log evidence in collector), giving 0.74 confidence.  Step 1 correctly\n    // routes the log finding through hypothesis dedup (Pod-based components),\n    // so the hypothesis becomes the top finding.  Step 5 will further tune this.\n    topFindingMinConfidence: 0.74,\n    mustCiteEvidence: [\n      /pods/i,\n      /events/i,\n    ],\n    mustNotHallucinate: [\n      /^CrashLoopBackOff$/i, // wrong failure mode (exact match)\n      /missing.*secret/i,     // wrong failure mode\n    ],\n    rootCauseMustMatch: [\n      /image/i,\n      /v999\\.99\\.99|pull|tag|registry/i,\n    ],\n    mustMentionIdentifiers: ['app-pod', 'myapp:v999.99.99'],\n  },\n\n  'missing-secret-crashloop': {\n    name: 'Missing Secret CrashLoop',\n    minFindings: 1,\n    topFindingMustMatch: [\n      /CrashLoopBackOff/i,\n      /missing.*secret/i,\n      /app-credentials/i,\n      // New hypothesis rootCause format (title is now just the rootCause string)\n      /kubernetes secret.*absent|required.*kubernetes secret|secret.*absent|secret.*fail/i,\n    ],\n    topFindingSeverity: ['critical'],\n    topFindingMinConfidence: 0.85,\n    mustCiteEvidence: [\n      /pods/i,\n      /events/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n    ],\n    rootCauseMustMatch: [\n      /secret|app-credentials|CrashLoop|FailedMount/i,\n    ],\n    mustMentionIdentifiers: ['app-pod', 'app-credentials'],\n  },\n\n  'ghost-service': {\n    name: 'Ghost Service (Cross-Namespace DNS Failure)',\n    minFindings: 2,\n    topFindingMustMatch: [\n      /CrashLoopBackOff/i,\n      /dns/i,\n      /api-service\\.staging/i,\n      /no such host/i,\n    ],\n    // In heuristic mode the CrashLoop symptom currently sorts above the DNS\n    // hypothesis. If ranking changes later, the namespace-mismatch DNS finding\n    // is still acceptable as the top finding for this scenario.\n    topFindingSeverity: ['critical', 'high'],\n    topFindingMinConfidence: 0.8,\n    mustCiteEvidence: [\n      /pods/i,\n      /events/i,\n      /services/i,\n      /staging/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n      /persistentvolumeclaim|storageclass/i,\n      /OOMKilled/i,\n    ],\n    rootCauseMustMatch: [\n      /crashloop|backoff|restart/i,\n      /dns|no such host|api-service\\.staging|namespace/i,\n    ],\n    mustMentionIdentifiers: ['web-app-pod', 'api-service.staging', 'staging'],\n  },\n\n  'network-policy-deny': {\n    name: 'NetworkPolicy Deny-All Egress',\n    minFindings: 3,\n    topFindingMustMatch: [\n      /NetworkPolicy/i,\n      /deny-all-egress/i,\n      /egress/i,\n      /payments-api/i,\n    ],\n    topFindingSeverity: ['high'],\n    topFindingMinConfidence: 0.9,\n    mustCiteEvidence: [\n      /networkpolicies/i,\n      /pods/i,\n      /services/i,\n      /logs/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n      /CrashLoopBackOff/i,\n      /missing.*secret/i,\n    ],\n    rootCauseMustMatch: [\n      /networkpolicy|deny|egress|outbound/i,\n      /payments-api|service|port 8443/i,\n    ],\n    mustMentionIdentifiers: ['api-client-pod', 'deny-all-egress', 'payments-api'],\n  },\n\n  'helm-release-failure': {\n    name: 'Helm Release Failure (Failed Hook CrashLoop)',\n    minFindings: 1,\n    topFindingMustMatch: [\n      /CrashLoopBackOff/i,\n      /storefront-hook-pod/i,\n      /hook/i,\n    ],\n    topFindingSeverity: ['critical'],\n    topFindingMinConfidence: 0.95,\n    mustCiteEvidence: [\n      /pods/i,\n      /events/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n      /missing.*secret/i,\n      /NetworkPolicy/i,\n    ],\n    rootCauseMustMatch: [\n      /crashloop|backoff|restart/i,\n      /migrate-hook|storefront-hook-pod/i,\n    ],\n    mustMentionIdentifiers: ['storefront-hook-pod', 'migrate-hook'],\n  },\n\n  'wrong-db-endpoint': {\n    name: 'Wrong DB Endpoint (DNS Failure)',\n    minFindings: 1,\n    topFindingMustMatch: [\n      /dns/i,\n      /db\\.internal/i,\n      /database/i,\n      /endpoint/i,\n      /no such host/i,\n      /not ready/i,\n      /readiness/i,\n    ],\n    topFindingSeverity: ['critical', 'high'],\n    topFindingMinConfidence: 0.7,\n    mustCiteEvidence: [\n      /logs|events|pods/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n      /CrashLoopBackOff/i,\n    ],\n    rootCauseMustMatch: [\n      // In heuristic mode, top finding is \"Not Ready\" — reasoning mentions readiness probe\n      // In AI mode, top finding is DNS failure — reasoning mentions db.internal\n      /dns|db\\.internal|no such host|database|endpoint|connectivity|ready|readiness|probe/i,\n    ],\n    mustMentionIdentifiers: ['app-pod'],\n  },\n\n  'pvc-pending': {\n    name: 'PVC Pending (StorageClass Mismatch)',\n    minFindings: 2,\n    topFindingMustMatch: [\n      /persistentvolumeclaim/i,\n      /storageclass/i,\n      /storage provisioner/i,\n      /volume/i,\n      /pvc/i,\n    ],\n    topFindingSeverity: ['critical'],\n    topFindingMinConfidence: 0.7,\n    mustCiteEvidence: [\n      /events/i,\n      /persistentvolumeclaims/i,\n      /storageclasses/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n      /CrashLoopBackOff/i,\n    ],\n    rootCauseMustMatch: [\n      /persistentvolumeclaim|storageclass|storage provisioner|provisioningfailed|pending/i,\n    ],\n    mustMentionIdentifiers: ['db-pod', 'data-pvc', 'fast-ssd'],\n  },\n\n  'multi-namespace-retrieval': {\n    name: 'Multi-Namespace Retrieval (Cross-Namespace DNS Noise)',\n    minFindings: 4,\n    topFindingMustMatch: [\n      /dns/i,\n      /wrong-host\\.internal/i,\n      /migration-pod/i,\n      /cluster-wide/i,\n    ],\n    // Heuristic mode currently ranks the database migration pod's concrete DNS\n    // failure above the broader cluster-wide DNS hypothesis, so either title is\n    // acceptable as long as the root cause remains DNS-related.\n    topFindingSeverity: ['high'],\n    topFindingMinConfidence: 0.8,\n    mustCiteEvidence: [\n      /pods/i,\n      /events/i,\n      /database/i,\n\n[51 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1774115983499}}
+{"type":"message","id":"fb5a90d6","parentId":"2e4a5697","timestamp":"2026-03-21T17:59:43.500Z","message":{"role":"toolResult","toolCallId":"call_6XTGF8pYqe7NMuD5GTUZie7h|fc_0f9932afa4a686050169bedc8f65ac819bb09b314803b8dca0","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// Priority 3: Golden Set Evaluation Tests\n// ---------------------------------------------------------------------------\n//\n// Tests the evaluation framework itself and runs heuristic-mode findings\n// through golden expectations to verify the baseline quality floor.\n// Also tests the recorder infrastructure for CI/CD replay.\n\nimport { describe, it, expect, beforeAll, afterAll } from 'vitest';\nimport * as fs from 'fs';\nimport * as path from 'path';\nimport * as os from 'os';\n\nimport { analyzeBundlePipeline, cleanupPipelineResult } from '../../../src/pipeline/analyze.js';\nimport type { PipelineResult } from '../../../src/pipeline/analyze.js';\nimport { createTestBundle, getFixturePath } from '../../helpers/create-test-bundle.js';\nimport { GOLDEN_EXPECTATIONS } from '../expectations.js';\nimport { evaluateScenario, buildEvalReport } from '../evaluate.js';\nimport {\n  CassetteRecorder,\n  cassetteSeedKey,\n  getRecorderMode,\n} from '../../../src/ai/recorder.js';\n\n// ---------------------------------------------------------------------------\n// Setup\n// ---------------------------------------------------------------------------\n\nlet tmpDir: string;\nconst results: Record<string, PipelineResult> = {};\n\nbeforeAll(async () => {\n  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'sbi-golden-'));\n\n  for (const scenario of Object.keys(GOLDEN_EXPECTATIONS)) {\n    const bundlePath = await createTestBundle(\n      getFixturePath(scenario),\n      path.join(tmpDir, `${scenario}.tar.gz`),\n    );\n    results[scenario] = await analyzeBundlePipeline(bundlePath, { noAi: true });\n  }\n});\n\nafterAll(async () => {\n  for (const result of Object.values(results)) {\n    await cleanupPipelineResult(result);\n  }\n  fs.rmSync(tmpDir, { recursive: true, force: true });\n});\n\n// ---------------------------------------------------------------------------\n// Golden eval: heuristic baseline\n// ---------------------------------------------------------------------------\n\ndescribe('Golden Evaluation: heuristic baseline', () => {\n  for (const [scenario, expectation] of Object.entries(GOLDEN_EXPECTATIONS)) {\n    describe(`Scenario: ${expectation.name}`, () => {\n      it('produces findings that pass golden expectations', () => {\n        const result = results[scenario]!;\n        const evalResult = evaluateScenario(scenario, expectation, result.findings);\n\n        // Log failures for debugging\n        const failures = evalResult.checks.filter((c) => !c.pass);\n        if (failures.length > 0) {\n          console.log(`[${scenario}] Failed checks:`, failures.map((f) => `${f.check}: ${f.detail}`));\n        }\n\n        expect(evalResult.pass).toBe(true);\n      });\n\n      it(`has >= ${expectation.minFindings} findings`, () => {\n        const result = results[scenario]!;\n        expect(result.findings.length).toBeGreaterThanOrEqual(expectation.minFindings);\n      });\n\n      it('top finding matches expected pattern', () => {\n        const result = results[scenario]!;\n        const top = result.findings[0]!;\n        const matched = expectation.topFindingMustMatch.some((re) => re.test(top.title));\n        expect(matched).toBe(true);\n      });\n\n      it('top finding has expected severity', () => {\n        const result = results[scenario]!;\n        const top = result.findings[0]!;\n        expect(expectation.topFindingSeverity).toContain(top.severity);\n      });\n\n      it('top finding meets minimum confidence', () => {\n        const result = results[scenario]!;\n        const top = result.findings[0]!;\n        expect(top.confidence).toBeGreaterThanOrEqual(expectation.topFindingMinConfidence);\n      });\n\n      it('no hallucinated content in findings', () => {\n        const result = results[scenario]!;\n        const fullText = result.findings\n          .map((f) => `${f.title} ${f.reasoningSummary}`)\n          .join(' ');\n\n        for (const pattern of expectation.mustNotHallucinate) {\n          expect(pattern.test(fullText)).toBe(false);\n        }\n      });\n\n      it('root cause reasoning matches expected pattern', () => {\n        const result = results[scenario]!;\n        const rootCause = result.findings[0]!.reasoningSummary;\n        const matched = expectation.rootCauseMustMatch.some((re) => re.test(rootCause));\n        expect(matched).toBe(true);\n      });\n\n      for (const id of expectation.mustMentionIdentifiers) {\n        it(`mentions required identifier: ${id}`, () => {\n          const result = results[scenario]!;\n          const fullText = result.findings\n            .map((f) => [\n              f.title,\n              f.reasoningSummary,\n              ...f.evidence.map((e) => `${e.path} ${e.note}`),\n            ].join(' '))\n            .join(' ')\n            .toLowerCase();\n\n          expect(fullText).toContain(id.toLowerCase());\n        });\n      }\n    });\n  }\n});\n\n// ---------------------------------------------------------------------------\n// Eval report builder\n// ---------------------------------------------------------------------------\n\ndescribe('Golden Evaluation: report builder', () => {\n  it('builds a complete eval report from all scenarios', () => {\n    const scenarioResults: Record<string, ReturnType<typeof evaluateScenario>> = {};\n\n    for (const [scenario, expectation] of Object.entries(GOLDEN_EXPECTATIONS)) {\n      scenarioResults[scenario] = evaluateScenario(scenario, expectation, results[scenario]!.findings);\n    }\n\n    const report = buildEvalReport(scenarioResults);\n\n    expect(report.timestamp).toBeDefined();\n    expect(report.overallPass).toBe(true);\n    expect(report.overallScore).toBeGreaterThan(0.8);\n    expect(Object.keys(report.scenarios)).toHaveLength(Object.keys(GOLDEN_EXPECTATIONS).length);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// Cassette recorder infrastructure\n// ---------------------------------------------------------------------------\n\ndescribe('Cassette Recorder', () => {\n  it('generates stable seed keys from seed identity', () => {\n    const key1 = cassetteSeedKey('seed:pod:0', 'kubernetes');\n    const key2 = cassetteSeedKey('seed:pod:0', 'kubernetes');\n    expect(key1).toBe(key2);\n  });\n\n  it('generates different keys for different seeds', () => {\n    const key1 = cassetteSeedKey('seed:pod:0', 'kubernetes');\n    const key2 = cassetteSeedKey('seed:pod:1', 'kubernetes');\n    expect(key1).not.toBe(key2);\n  });\n\n  it('generates different keys for different categories', () => {\n    const key1 = cassetteSeedKey('seed:test:0', 'kubernetes');\n    const key2 = cassetteSeedKey('seed:test:0', 'log');\n    expect(key1).not.toBe(key2);\n  });\n\n  it('getRecorderMode defaults to live', () => {\n    const original = process.env['SBI_AI_MODE'];\n    delete process.env['SBI_AI_MODE'];\n    expect(getRecorderMode()).toBe('live');\n    if (original !== undefined) process.env['SBI_AI_MODE'] = original;\n  });\n\n  it('records and replays a cassette in memory', () => {\n    const recorder = new CassetteRecorder('record', '/tmp/test-cassettes');\n\n    recorder.record(\n      'seed:pod:0',\n      'kubernetes',\n      { system: 'system prompt', user: 'user prompt' },\n      { findings: [], rawResponse: '{}' },\n      'gpt-4o',\n    );\n\n    expect(recorder.size).toBe(1);\n\n    const cassette = recorder.replay('seed:pod:0', 'kubernetes');\n    expect(cassette).toBeDefined();\n    expect(cassette!.seedId).toBe('seed:pod:0');\n    expect(cassette!.model).toBe('gpt-4o');\n  });\n\n  it('returns undefined for missing cassette', () => {\n    const recorder = new CassetteRecorder('replay', '/tmp/test-cassettes');\n    expect(recorder.replay('nonexistent', 'kubernetes')).toBeUndefined();\n  });\n\n  it('does not record in replay mode', () => {\n    const recorder = new CassetteRecorder('replay', '/tmp/test-cassettes');\n    recorder.record(\n      'seed:pod:0',\n      'kubernetes',\n      { system: '', user: '' },\n      { findings: [], rawResponse: '{}' },\n      'gpt-4o',\n    );\n    expect(recorder.size).toBe(0);\n  });\n\n  it('round-trips cassettes through flush and load', async () => {\n    const cassetteDir = path.join(tmpDir, 'cassettes-roundtrip');\n    const recorder = new CassetteRecorder('record', cassetteDir);\n\n    recorder.record(\n      'seed:test:0',\n      'log',\n      { system: 'sys', user: 'usr' },\n      { findings: [{ title: 'test', severity: 'high', confidence: 0.5, affectedComponents: [], reasoningSummary: 'r', evidence: [{ path: 'p', note: 'n' }], contradictionsChecked: [], recommendedAction: 'a', missingEvidence: [] }], rawResponse: '{\"findings\":[]}' },\n      'gpt-4o',\n    );\n\n    await recorder.flush();\n\n    // Load into a fresh recorder\n    const loader = new CassetteRecorder('replay', cassetteDir);\n    await loader.load();\n\n    expect(loader.size).toBe(1);\n    const cassette = loader.replay('seed:test:0', 'log');\n    expect(cassette).toBeDefined();\n    expect(cassette!.response.findings).toHaveLength(1);\n    expect(cassette!.response.findings[0]!.title).toBe('test');\n  });\n\n  it('load handles missing cassette file gracefully', async () => {\n    const recorder = new CassetteRecorder('replay', '/nonexistent/path');\n    await recorder.load();\n    expect(recorder.size).toBe(0);\n  });\n\n  it('has() checks cassette existence', () => {\n    const recorder = new CassetteRecorder('record', '/tmp/test');\n    recorder.record('seed:a:0', 'kubernetes', { system: '', user: '' }, { findings: [], rawResponse: '{}' }, 'gpt-4o');\n    expect(recorder.has('seed:a:0', 'kubernetes')).toBe(true);\n    expect(recorder.has('seed:b:0', 'kubernetes')).toBe(false);\n  });\n\n  it('keys() returns all stored cassette keys', () => {\n    const recorder = new CassetteRecorder('record', '/tmp/test');\n    recorder.record('seed:a:0', 'kubernetes', { system: '', user: '' }, { findings: [], rawResponse: '{}' }, 'gpt-4o');\n    recorder.record('seed:b:0', 'log', { system: '', user: '' }, { findings: [], rawResponse: '{}' }, 'gpt-4o');\n\n[4 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1774115983500}}
