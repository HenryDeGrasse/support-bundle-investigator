-{"type":"message","id":"ce97f1ec","parentId":"df2da315","timestamp":"2026-03-21T13:20:37.874Z","message":{"role":"toolResult","toolCallId":"call_AbYBhnuzFIOXBwlNpob6VGb8|fc_0e22c3c104fdf4860169be9b25cec4819ba7ce36a87d81a7ef","toolName":"read","content":[{"type":"text","text":"import type { Evidence } from '../types/index.js';\n\n// ---------------------------------------------------------------------------\n// HypothesisCategory\n// ---------------------------------------------------------------------------\n\n/**\n * The broad root-cause class that a hypothesis belongs to.\n *\n * - `missing-secret`       — A required Kubernetes Secret or key is absent\n * - `bad-db-endpoint`      — A database connection string or endpoint is wrong\n * - `dns-failure`          — DNS resolution is failing for a service or host\n * - `image-pull-failure`   — A container image cannot be pulled (auth, tag, registry)\n * - `config-error`         — A ConfigMap value or environment variable is misconfigured\n * - `oom-kill`             — The container was killed due to memory limits being exceeded\n * - `connectivity-failure` — A network path between services or to an external endpoint is broken\n * - `readiness-failure`    — A Pod is not passing its readiness probe\n * - `generic-crash`        — The application crashed for an unclassified reason\n * - `missing-service`      — A required Kubernetes Service is absent or has no endpoints\n * - `volume-mount-failure`  — A PVC cannot be provisioned or a volume cannot be mounted (e.g. missing StorageClass)\n */\nexport type HypothesisCategory =\n  | 'missing-secret'\n  | 'bad-db-endpoint'\n  | 'dns-failure'\n  | 'image-pull-failure'\n  | 'config-error'\n  | 'oom-kill'\n  | 'connectivity-failure'\n  | 'readiness-failure'\n  | 'generic-crash'\n  | 'missing-service'\n  | 'volume-mount-failure';\n\n// ---------------------------------------------------------------------------\n// EvidenceAssessment\n// ---------------------------------------------------------------------------\n\n/**\n * A structured breakdown of all evidence gathered for a single hypothesis.\n *\n * - `supporting`       — Evidence items that increase confidence in the hypothesis\n * - `contradicting`    — Evidence items that lower confidence or rule out the hypothesis\n * - `missingDecisive`  — Descriptions of evidence that would be decisive but is absent,\n *                        used to drive spec-gap recommendations\n */\nexport interface EvidenceAssessment {\n  /** Evidence items that support the hypothesis being the root cause. */\n  supporting: Evidence[];\n  /** Evidence items that contradict or weaken the hypothesis. */\n  contradicting: Evidence[];\n  /**\n   * Human-readable descriptions of evidence that would decisively confirm or\n   * refute the hypothesis but is not present in the bundle.\n   */\n  missingDecisive: string[];\n}\n\n// ---------------------------------------------------------------------------\n// Hypothesis\n// ---------------------------------------------------------------------------\n\n/**\n * A single candidate root-cause hypothesis for an observed symptom.\n *\n * Each hypothesis is independently assessed with supporting, contradicting, and\n * missing evidence before a calibrated confidence score is assigned. This\n * models the differential-diagnosis pattern used by support engineers.\n */\nexport interface Hypothesis {\n  /** Unique identifier for this hypothesis within its {@link HypothesisSet}. */\n  id: string;\n  /** The observed symptom string that this hypothesis attempts to explain. */\n  symptom: string;\n  /** Human-readable statement of the proposed root cause. */\n  rootCause: string;\n  /** Broad classification of the root-cause class. */\n  category: HypothesisCategory;\n  /** Structured evidence gathered for and against this hypothesis. */\n  evidenceAssessment: EvidenceAssessment;\n  /**\n   * Calibrated confidence that this hypothesis is the true root cause,\n   * in the range [0, 1]. Penalised when decisive evidence is missing.\n   */\n  confidence: number;\n  /**\n   * Free-text explanation of how the confidence score was derived from the\n   * supporting, contradicting, and missing evidence.\n   */\n  confidenceRationale: string;\n  /**\n   * Actionable recommendations to fill evidence gaps identified in\n   * {@link EvidenceAssessment.missingDecisive}. Emitted as spec-gap guidance\n   * when a hypothesis cannot be confirmed or ruled out.\n   */\n  specGapRecommendations: string[];\n  /**\n   * IDs of the raw {@link Finding} objects whose evidence contributed to\n   * this hypothesis.\n   */\n  sourceFindings: string[];\n}\n\n// ---------------------------------------------------------------------------\n// HypothesisSet\n// ---------------------------------------------------------------------------\n\n/**\n * All candidate hypotheses generated for a single symptom, together with the\n * top-ranked hypothesis (or `null` when no hypothesis reaches a useful\n * confidence threshold).\n */\nexport interface HypothesisSet {\n  /**\n   * A short stable key identifying the symptom (e.g. `\"pod-crashloop:api\"`)\n   * used for deduplication and cross-referencing.\n   */\n  symptomKey: string;\n  /** Full human-readable description of the observed symptom. */\n  symptomDescription: string;\n  /**\n   * All candidate hypotheses ranked from highest confidence to lowest.\n   * An empty array means no hypotheses could be generated for this symptom.\n   */\n  hypotheses: Hypothesis[];\n  /**\n   * The highest-ranked hypothesis after scoring, or `null` when `hypotheses`\n   * is empty.\n   */\n  topHypothesis: Hypothesis | null;\n}\n\n// ---------------------------------------------------------------------------\n// HypothesisVerificationResult\n// ---------------------------------------------------------------------------\n\n/**\n * The top-level result produced by the hypothesis verification layer.\n *\n * Contains one {@link HypothesisSet} per unique symptom detected across the\n * bundle, together with aggregate metadata suitable for tracing and reporting.\n */\nexport interface HypothesisVerificationResult {\n  /** One entry per unique symptom analysed. */\n  hypothesisSets: HypothesisSet[];\n  /** Aggregate counters for tracing and reporting. */\n  metadata: {\n    /** Total number of hypotheses generated across all symptom sets. */\n    totalHypotheses: number;\n    /** Total number of distinct symptoms that were analysed. */\n    totalSymptomsAnalyzed: number;\n  };\n}\n"}],"isError":false,"timestamp":1774099237874}}
-{"type":"message","id":"950cdbb3","parentId":"ce97f1ec","timestamp":"2026-03-21T13:20:37.875Z","message":{"role":"toolResult","toolCallId":"call_xaL6ccvNTy7VFYVs6kZvmEp5|fc_0e22c3c104fdf4860169be9b25ced4819b9cb3d4d1039e39a0","toolName":"read","content":[{"type":"text","text":"import type { Evidence, Finding, FindingSeverity } from '../types/index.js';\nimport type { InvestigatorContext } from './types.js';\nimport type {\n  EvidenceAssessment,\n  Hypothesis,\n  HypothesisCategory,\n  HypothesisSet,\n} from './hypothesis-types.js';\nimport { matchTemplate } from './hypothesis-templates.js';\nimport type { HypothesisTemplate } from './hypothesis-templates.js';\n\n// ---------------------------------------------------------------------------\n// Helpers — symptom detection (now template-driven)\n// ---------------------------------------------------------------------------\n\n/**\n * Returns a lower-cased text corpus for a finding, combining the title,\n * reasoning summary, and evidence notes so symptom detection remains robust\n * even when different investigators phrase the same issue differently.\n */\nfunction findingTextCorpus(finding: Finding): string {\n  return [\n    finding.title,\n    finding.reasoningSummary,\n    ...finding.evidence.map((e) => e.note),\n    ...finding.missingEvidence,\n  ]\n    .join(' ')\n    .toLowerCase();\n}\n\n/**\n * Finds the matching template for a group of findings by building a combined\n * text corpus and matching against the template registry.\n */\nfunction detectTemplate(findings: Finding[]): HypothesisTemplate {\n  for (const finding of findings) {\n    const corpus = findingTextCorpus(finding);\n    const template = matchTemplate(corpus);\n    // If we got a non-generic match, use it immediately (first match wins)\n    if (template.id !== 'generic') {\n      return template;\n    }\n  }\n  // No specific match found — return the generic fallback\n  return matchTemplate('');\n}\n\n// ---------------------------------------------------------------------------\n// Helpers — symptom key / description derivation (template-driven)\n// ---------------------------------------------------------------------------\n\n/**\n * Extracts the primary affected component from a finding.\n *\n * Prefers a `Pod/namespace/name` component, then any workload component,\n * then falls back to the first component or the finding id.\n */\nfunction primaryComponentKey(finding: Finding): string {\n  const podComp = finding.affectedComponents.find((c) => /^Pod\\//.test(c));\n  if (podComp) return podComp;\n\n  const workloadComp = finding.affectedComponents.find((c) =>\n    /^(Deployment|StatefulSet|DaemonSet|ReplicaSet)\\//.test(c),\n  );\n  if (workloadComp) return workloadComp;\n\n  return finding.affectedComponents[0] ?? finding.id;\n}\n\n/**\n * Builds a concise, stable symptom key from a component identifier and\n * the matched template.\n *\n * Format: `{symptomKeyPrefix}:{namespace}/{name}` or `{symptomKeyPrefix}:{name}`,\n * e.g. `pod-crashloop:default/app-pod`.\n */\nfunction buildSymptomKey(componentKey: string, template: HypothesisTemplate): string {\n  // Extract the meaningful suffix from a component path like \"Pod/default/app-pod\"\n  const slashIdx = componentKey.indexOf('/');\n  const suffix = slashIdx !== -1 ? componentKey.slice(slashIdx + 1) : componentKey;\n  return `${template.symptomKeyPrefix}:${suffix}`;\n}\n\n/**\n * Builds a human-readable description of the symptom using the template's\n * description template string with placeholder substitution.\n */\nfunction buildSymptomDescription(\n  componentKey: string,\n  template: HypothesisTemplate,\n  findings: Finding[],\n): string {\n  // Try to parse \"Kind/namespace/name\" → namespace + name\n  const parts = componentKey.split('/');\n  const name = parts[parts.length - 1] ?? componentKey;\n  const namespace = parts.length >= 3 ? parts[parts.length - 2] : 'unknown';\n\n  const descTemplate = template.symptomDescriptionTemplate;\n\n  // For the generic template, the {title} placeholder falls back to finding title\n  if (descTemplate === '{title}') {\n    return findings[0]?.title ?? componentKey;\n  }\n\n  return descTemplate\n    .replace(/\\{name\\}/g, name)\n    .replace(/\\{namespace\\}/g, namespace);\n}\n\n// ---------------------------------------------------------------------------\n// Helpers — empty evidence assessment\n// ---------------------------------------------------------------------------\n\n/** Returns a fresh, empty {@link EvidenceAssessment} (hypotheses start unscored). */\nfunction emptyEvidenceAssessment(): EvidenceAssessment {\n  return {\n    supporting: [],\n    contradicting: [],\n    missingDecisive: [],\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Helpers — hypothesis builder (template-driven)\n// -----------------------------------------
