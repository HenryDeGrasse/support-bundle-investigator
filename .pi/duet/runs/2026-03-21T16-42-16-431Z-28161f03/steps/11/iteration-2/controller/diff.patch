info\n  if (indexOf(segments, 'cluster-info') >= 0) {\n    return 'cluster-info';\n  }\n\n  // analysis.json at any level → analyzer (real Troubleshoot bundles use this\n  // filename at the bundle root instead of an analyzers/ directory)\n  if (filename === 'analysis.json') {\n    return 'analyzer';\n  }\n\n  // analyzers directory segment → analyzer (legacy / custom bundles)\n  if (indexOf(segments, 'analyzers') >= 0) {\n    return 'analyzer';\n  }\n\n  // cluster-resources segment — check sub-kind before returning kubernetes-resource\n  const crIdx = indexOf(segments, 'cluster-resources');\n  if (crIdx >= 0) {\n    const subKind = segments[crIdx + 1];\n\n    // Pod logs live under cluster-resources/pods/logs/ — classify as log\n    // *before* the generic kubernetes-resource fallback\n    if (subKind === 'pods') {\n      const nextSegment = segments[crIdx + 2];\n      if (nextSegment === 'logs') {\n        return 'log';\n      }\n    }\n\n    if (subKind === 'events') {\n      return 'event';\n    }\n    return 'kubernetes-resource';\n  }\n\n  // logs directory segment → log\n  if (indexOf(segments, 'logs') >= 0) {\n    return 'log';\n  }\n\n  // helm directory segment → helm-release\n  if (indexOf(segments, 'helm') >= 0) {\n    return 'helm-release';\n  }\n\n  return 'unknown';\n}\n"}],"isError":false,"timestamp":1774121792219}}
