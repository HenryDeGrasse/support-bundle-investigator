+{"type":"message","id":"245a54f0","parentId":"ba205256","timestamp":"2026-03-21T19:36:22.370Z","message":{"role":"toolResult","toolCallId":"call_QSGV14pu2bGkJbCCOpKGlUNx|fc_0f9932afa4a686050169bef33637a0819b9df7c7b71fb9c9af","toolName":"read","content":[{"type":"text","text":"import * as fs from 'fs';\nimport * as fsp from 'fs/promises';\nimport * as os from 'os';\nimport * as path from 'path';\nimport * as tar from 'tar';\nimport { buildManifest } from './manifest.js';\nimport type { BundleManifest } from '../types/index.js';\n\n// ---------------------------------------------------------------------------\n// Public types\n// ---------------------------------------------------------------------------\n\nexport interface ExtractOptions {\n  /**\n   * Directory to extract into. When omitted a temporary directory is created\n   * under `os.tmpdir()` automatically. The caller is responsible for cleaning\n   * up a custom `outputDir`; auto-created temp directories are removed on\n   * extraction failure.\n   */\n  outputDir?: string;\n\n  /**\n   * Maximum allowed uncompressed size in bytes across archive entries.\n   */\n  maxSize?: number;\n\n  /**\n   * When true, perform a full archive validation pass before extraction.\n   * Security validation is always performed.\n   */\n  validateIntegrity?: boolean;\n}\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfunction isUnsafeArchivePath(entryPath: string): boolean {\n  const normalizedPath = entryPath.replace(/\\\\/g, '/');\n\n  if (normalizedPath.startsWith('/')) {\n    return true;\n  }\n\n  if (/^[A-Za-z]:\\//.test(normalizedPath)) {\n    return true;\n  }\n\n  return normalizedPath.split('/').some((segment) => segment === '..');\n}\n\nasync function validateArchive(\n  bundlePath: string,\n  options: ExtractOptions,\n): Promise<void> {\n  let totalUncompressedSize = 0;\n  let unsafePath: string | undefined;\n\n  await tar.t({\n    file: bundlePath,\n    onentry(entry) {\n      if (!unsafePath && isUnsafeArchivePath(entry.path)) {\n        unsafePath = entry.path;\n      }\n\n      totalUncompressedSize += entry.size;\n    },\n  });\n\n  if (unsafePath) {\n    throw new Error(`Archive contains unsafe path: ${unsafePath}`);\n  }\n\n  if (\n    typeof options.maxSize === 'number' &&\n    totalUncompressedSize > options.maxSize\n  ) {\n    throw new Error(\n      `Archive exceeds maxSize of ${options.maxSize} bytes: ${totalUncompressedSize}`,\n    );\n  }\n}\n\n// ---------------------------------------------------------------------------\n// Implementation\n// ---------------------------------------------------------------------------\n\n/**\n * Extracts a `.tar.gz` support bundle archive and returns a\n * {@link BundleManifest} describing every file found inside.\n *\n * Safety guarantees\n * -----------------\n * - Only files with a `.tar.gz` extension are accepted.\n * - The archive is validated before extraction and rejected if any entry path\n *   is absolute or contains `..` path segments.\n * - If an auto-created temporary directory is used and extraction fails for\n *   any reason, that directory is removed before the error is re-thrown.\n *\n * @param bundlePath - Path to the `.tar.gz` archive to extract.\n * @param options    - Optional extraction settings.\n * @returns A fully populated {@link BundleManifest} (file categories are all\n *          set to `'unknown'`; classification happens in the profiling step).\n */\nexport async function extractBundle(\n  bundlePath: string,\n  options: ExtractOptions = {},\n): Promise<BundleManifest> {\n  const absoluteBundlePath = path.resolve(bundlePath);\n\n  // ── 1. Validate file accessibility ────────────────────────────────────────\n  try {\n    await fsp.access(absoluteBundlePath, fs.constants.R_OK);\n  } catch {\n    throw new Error(`Bundle file not found or not readable: ${absoluteBundlePath}`);\n  }\n\n  // ── 2. Validate extension ─────────────────────────────────────────────────\n  if (!absoluteBundlePath.endsWith('.tar.gz')) {\n    throw new Error(\n      `Bundle must be a .tar.gz file, got: ${path.basename(absoluteBundlePath)}`,\n    );\n  }\n\n  // ── 3. Validate archive contents before extraction ────────────────────────\n  await validateArchive(absoluteBundlePath, options);\n\n  // ── 4. Prepare output directory ───────────────────────────────────────────\n  let outputDir: string;\n  let ownsTempDir = false;\n\n  if (options.outputDir) {\n    outputDir = path.resolve(options.outputDir);\n    await fsp.mkdir(outputDir, { recursive: true });\n  } else {\n    outputDir = await fsp.mkdtemp(path.join(os.tmpdir(), 'sbi-bundle-'));\n    ownsTempDir = true;\n  }\n\n  // ── 5. Extract & build manifest ───────────────────────────────────────────\n  try {\n    await tar.x({\n      file: absoluteBundlePath,\n      cwd: outputDir,\n    });\n\n    return await buildManifest(outputDir, absoluteBundlePath);\n  } catch (err) {\n    if (ownsTempDir) {\n      await fsp.rm(outputDir, { recursive: true, force: true }).catch(() => undefined);\n    }\n    throw err;\n  }\n}\n"}],"isError":false,"timestamp":1774121782370}}
+{"type":"message","id":"ac4d418b","parentId":"245a54f0","timestamp":"2026-03-21T19:36:22.371Z","message":{"role":"toolResult","toolCallId":"call_0KDxf8CbRpTJ0tjyErZH2BaH|fc_0f9932afa4a686050169bef33637ac819b920f6b53a441a529","toolName":"read","content":[{"type":"text","text":"import type {\n  ArtifactCategory,\n  ArtifactEntry,\n  BundleManifest,\n  BundleProfile,\n  WorkloadSummary,\n} from '../types/index.js';\nimport { classifyArtifact } from './classifier.js';\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Returns a zero-initialised count map for every {@link ArtifactCategory}.\n */\nfunction zeroCounts(): Record<ArtifactCategory, number> {\n  return {\n    analyzer: 0,\n    log: 0,\n    'kubernetes-resource': 0,\n    event: 0,\n    'cluster-info': 0,\n    'helm-release': 0,\n    unknown: 0,\n  };\n}\n\n/**\n * Strips a `.json` or `.yaml`/`.yml` extension from a filename.\n * Returns the input unchanged if it has no recognised extension.\n */\nfunction stripResourceExtension(name: string): string {\n  return name.replace(/\\.(json|yaml|yml)$/i, '');\n}\n\n/**\n * Returns true when the segment looks like a file (has a recognised\n * resource-file extension) rather than a bare directory name.\n */\nfunction isResourceFile(segment: string): boolean {\n  return /\\.(json|yaml|yml)$/i.test(segment);\n}\n\n/**\n * Extracts a namespace string from a classified {@link ArtifactEntry}.\n *\n * Supports two path layouts produced by the Troubleshoot collector:\n *\n * **Flat (real bundles):**\n *   `…/cluster-resources/<kind>/<namespace>.json`\n *\n * **Nested (legacy / test fixtures):**\n *   `…/cluster-resources/<kind>/<namespace>/<file>`\n *\n * **Cluster-scoped resources** (e.g. `cluster-resources/nodes.json`) have\n * no namespace segment and return `undefined`.\n *\n * Returns `undefined` when the path does not conform to any supported\n * structure.\n */\nfunction extractNamespace(entry: ArtifactEntry): string | undefined {\n  const segments = entry.relativePath.split('/');\n  const crIdx = segments.indexOf('cluster-resources');\n  if (crIdx < 0) return undefined;\n\n  const subKind = segments[crIdx + 1];\n  if (!subKind) return undefined;\n\n  // Cluster-scoped: cluster-resources/<kind>.json (no namespace at all)\n  if (isResourceFile(subKind)) return undefined;\n\n  if (subKind === 'events') {\n    // events/<namespace>.json  →  strip extension to get namespace\n    const evFile = segments[crIdx + 2];\n    if (!evFile) return undefined;\n    return stripResourceExtension(evFile) || undefined;\n  }\n\n  const namespacePart = segments[crIdx + 2];\n  if (!namespacePart) return undefined;\n\n  // Flat layout: <kind>/<namespace>.json  →  strip extension\n  if (isResourceFile(namespacePart)) {\n    return stripResourceExtension(namespacePart) || undefined;\n  }\n\n  // Nested layout: <kind>/<namespace>/<file>  →  namespace is the directory\n  return namespacePart || undefined;\n}\n\n/**\n * Kinds (as they appear in `cluster-resources/<kind>/` paths) that represent\n * workload controllers and should appear in the workload summary.\n */\nconst WORKLOAD_KINDS = new Set([\n  'deployments',\n  'statefulsets',\n  'daemonsets',\n  'replicasets',\n  'jobs',\n  'cronjobs',\n]);\n\n/**\n * Attempts to build a {@link WorkloadSummary} stub from a kubernetes-resource\n * entry whose sub-kind is a recognised workload controller.\n *\n * Supports two path layouts:\n * - **Flat:** `cluster-resources/<kind>/<namespace>.json` — the namespace is\n *   derived from the filename; the workload name is set to `<namespace>`\n *   (individual workloads are discovered at parse-time, not from paths).\n * - **Nested:** `cluster-resources/<kind>/<namespace>/<file>` — name comes\n *   from the file, namespace from the directory.\n *\n * Returns `undefined` for non-workload resources (e.g. services, configmaps).\n */\nfunction buildWorkloadSummary(entry: ArtifactEntry): WorkloadSummary | undefined {\n  const segments = entry.relativePath.split('/');\n  const crIdx = segments.indexOf('cluster-resources');\n  if (crIdx < 0) return undefined;\n\n  const kind = segments[crIdx + 1];\n  if (!kind || !WORKLOAD_KINDS.has(kind)) return undefined;\n\n  const namespacePart = segments[crIdx + 2];\n  if (!namespacePart) return undefined;\n\n  // ── Flat layout: cluster-resources/<kind>/<namespace>.json ─────────────\n  if (isResourceFile(namespacePart) && segments.length === crIdx + 3) {\n    const namespace = stripResourceExtension(namespacePart);\n    if (!namespace) return undefined;\n    // In flat layout, the file contains a List with many workloads — we\n    // represent it as a single placeholder stub per namespace file. The\n    // actual workload names are resolved at parse time when the List items\n    // are unwrapped.\n    return { name: `${kind}/${namespace}`, namespace, kind };\n  }\n\n  // ── Nested layout: cluster-resources/<kind>/<namespace>/<file> ─────────\n  const namespace = namespacePart;\n  if (!namespace) return undefined;\n\n  const filename = segments[segments.length - 1] ?? '';\n  const name = filename.replace(/\\.(yaml|json)$/i, '');\n  if (!name) return undefined;\n\n  return { name, namespace, kind };\n}\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\n/**\n * Profiles a {@link BundleManifest} by classifying every artifact, counting\n * by category, extracting namespace information, building workload summaries,\n * and identifying coverage gaps.\n *\n * The returned {@link BundleProfile} contains an updated manifest where every\n * {@link ArtifactEntry} has its `category` field populated.\n *\n * @param manifest - The raw manifest produced by `buildManifest` (categories\n *                   are typically `'unknown'` at this stage).\n * @returns A fully populated {@link BundleProfile}.\n */\nexport async function profileBundle(manifest: BundleManifest): Promise<BundleProfile> {\n  // ── 1. Classify every entry ───────────────────────────────────────────────\n  const classifiedFiles: ArtifactEntry[] = manifest.files.map((entry) => ({\n    ...entry,\n    category: classifyArtifact(entry),\n  }));\n\n  const updatedManifest: BundleManifest = { ...manifest, files: classifiedFiles };\n\n  // ── 2. Count by category ──────────────────────────────────────────────────\n  const artifactsByCategory = zeroCounts();\n  for (const file of classifiedFiles) {\n    artifactsByCategory[file.category]++;\n  }\n\n  // ── 3. Extract namespaces ─────────────────────────────────────────────────\n  const namespaceSet = new Set<string>();\n  for (const file of classifiedFiles) {\n    if (file.category === 'kubernetes-resource' || file.category === 'event') {\n      const ns = extractNamespace(file);\n      if (ns) namespaceSet.add(ns);\n    }\n  }\n\n  // ── 4. Build workload summaries ───────────────────────────────────────────\n  const workloads: WorkloadSummary[] = [];\n  for (const file of classifiedFiles) {\n    if (file.category === 'kubernetes-resource') {\n      const summary = buildWorkloadSummary(file);\n      if (summary) workloads.push(summary);\n    }\n  }\n\n  // ── 5. Identify coverage gaps ─────────────────────────────────────────────\n  const coverageGaps: string[] = [];\n  if (artifactsByCategory.analyzer === 0) {\n    coverageGaps.push('No analyzer results found');\n  }\n  if (artifactsByCategory.event === 0) {\n    coverageGaps.push('No event data found');\n  }\n  if (artifactsByCategory.log === 0) {\n    coverageGaps.push('No log files found');\n  }\n  if (artifactsByCategory['kubernetes-resource'] === 0) {\n    coverageGaps.push('No Kubernetes resources found');\n  }\n\n  return {\n    manifest: updatedManifest,\n    analyzerCount: artifactsByCategory.analyzer,\n    logFileCount: artifactsByCategory.log,\n    resourceCount: artifactsByCategory['kubernetes-resource'],\n    eventCount: artifactsByCategory.event,\n    namespaces: Array.from(namespaceSet).sort(),\n    workloads,\n    coverageGaps,\n    artifactsByCategory,\n  };\n}\n"}],"isError":false,"timestamp":1774121782371}}
+{"type":"message","id":"ddc622ac","parentId":"ac4d418b","timestamp":"2026-03-21T19:36:22.371Z","message":{"role":"toolResult","toolCallId":"call_xIszkSQswnQGZ9hiPIKLJX1k|fc_0f9932afa4a686050169bef33637b4819b949195556403b1e8","toolName":"read","content":[{"type":"text","text":"import * as fs from \"fs/promises\";\nimport * as path from \"path\";\nimport * as tar from \"tar\";\n\n/**\n * Returns the absolute path to the fixture directory for a given scenario name.\n */\nexport function getFixturePath(scenario: string): string {\n  return path.resolve(__dirname, \"../fixtures/scenarios\", scenario);\n}\n\n/**\n * Packs a scenario directory into a .tar.gz bundle archive.\n *\n * @param scenarioDir - Absolute or relative path to the directory to pack.\n * @param outputPath  - Absolute or relative path for the output .tar.gz file.\n * @returns The resolved output path.\n */\nexport async function createTestBundle(\n  scenarioDir: string,\n  outputPath: string\n): Promise<string> {\n  const absoluteScenarioDir = path.resolve(scenarioDir);\n  const absoluteOutputPath = path.resolve(outputPath);\n\n  const scenarioStats = await fs.stat(absoluteScenarioDir).catch(() => null);\n  if (!scenarioStats?.isDirectory()) {\n    throw new Error(`Scenario directory does not exist: ${absoluteScenarioDir}`);\n  }\n\n  await fs.mkdir(path.dirname(absoluteOutputPath), { recursive: true });\n\n  // Collect entries relative to the parent of scenarioDir so that the\n  // archive contains the scenario folder itself at its root.\n  const parentDir = path.dirname(absoluteScenarioDir);\n  const scenarioName = path.basename(absoluteScenarioDir);\n\n  await tar.c(\n    {\n      gzip: true,\n      file: absoluteOutputPath,\n      cwd: parentDir,\n    },\n    [scenarioName]\n  );\n\n  return absoluteOutputPath;\n}\n"}],"isError":false,"timestamp":1774121782371}}
+{"type":"message","id":"7fb2f28f","parentId":"ddc622ac","timestamp":"2026-03-21T19:36:22.371Z","message":{"role":"toolResult","toolCallId":"call_r2dWRWUxpWztMjPDJfvNrbGd|fc_0f9932afa4a686050169bef33637bc819bb2b999f8549d3db3","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect, beforeAll, afterAll } from 'vitest';\nimport * as fs from 'fs';\nimport * as path from 'path';\nimport * as os from 'os';\nimport { analyzeBundlePipeline, cleanupPipelineResult } from '../../../src/pipeline/analyze.js';\nimport { createTestBundle, getFixturePath } from '../../helpers/create-test-bundle.js';\n\nlet tmpDir: string;\nlet wrongDbBundlePath: string;\nlet realisticFormatBundlePath: string;\n\nbeforeAll(async () => {\n  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'sbi-real-bundle-'));\n\n  wrongDbBundlePath = await createTestBundle(\n    getFixturePath('wrong-db-endpoint'),\n    path.join(tmpDir, 'wrong-db-endpoint.tar.gz'),\n  );\n\n  realisticFormatBundlePath = await createTestBundle(\n    getFixturePath('realistic-bundle-format'),\n    path.join(tmpDir, 'realistic-bundle-format.tar.gz'),\n  );\n});\n\nafterAll(() => {\n  fs.rmSync(tmpDir, { recursive: true, force: true });\n});\n\nasync function runPipeline(bundlePath: string) {\n  const result = await analyzeBundlePipeline(bundlePath, { noAi: true });\n  afterAll(() => cleanupPipelineResult(result));\n  return result;\n}\n\ndescribe('Real bundle regression corpus', () => {\n  it('wrong-db-endpoint archive ranks dns-failure above generic connectivity-failure', async () => {\n    const result = await runPipeline(wrongDbBundlePath);\n    const topHypothesis = result.findings.find((finding) =>\n      finding.id.startsWith('finding:hypothesis:'),\n    );\n\n    expect(topHypothesis).toBeDefined();\n    expect(topHypothesis!.id).toContain('finding:hypothesis:dns-failure:');\n  });\n\n  it('wrong-db-endpoint archive does not emit numeric-only service evidence', async () => {\n    const result = await runPipeline(wrongDbBundlePath);\n    const combinedEvidence = result.findings\n      .flatMap((finding) => finding.evidence)\n      .map((evidence) => `${evidence.path} ${evidence.note}`)\n      .join(' ');\n\n    expect(combinedEvidence).not.toContain('cluster-resources/services/default/5432.yaml');\n    expect(combinedEvidence).not.toMatch(/hostname '\\s*5432\\s*'/i);\n    expect(combinedEvidence).not.toMatch(/service '\\s*5432\\s*'/i);\n  });\n\n  it('wrong-db-endpoint top hypothesis reasoning explains why it beat the runner-up', async () => {\n    const result = await runPipeline(wrongDbBundlePath);\n    const topHypothesis = result.findings.find((finding) =>\n      finding.id.startsWith('finding:hypothesis:'),\n    );\n\n    expect(topHypothesis).toBeDefined();\n    expect(topHypothesis!.reasoningSummary).toContain('Preferred over runner-up');\n  });\n\n  it('realistic Troubleshoot-format archive still parses successfully as a regression corpus bundle', async () => {\n    const result = await runPipeline(realisticFormatBundlePath);\n\n    expect(result.profile.analyzerCount).toBeGreaterThan(0);\n    expect(result.profile.resourceCount).toBeGreaterThan(0);\n    expect(result.profile.eventCount).toBeGreaterThan(0);\n    expect(result.profile.logFileCount).toBeGreaterThan(0);\n  });\n});\n"}],"isError":false,"timestamp":1774121782371}}
+{"type":"message","id":"3cc301a5","parentId":"7fb2f28f","timestamp":"2026-03-21T19:36:22.371Z","message":{"role":"toolResult","toolCallId":"call_uyw1Zrh3LrqSrRID11bqPAJu|fc_0f9932afa4a686050169bef33637cc819b91b0066ef846fc92","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect, beforeAll, afterAll } from 'vitest';\nimport * as fs from 'fs';\nimport * as path from 'path';\nimport * as os from 'os';\nimport { analyzeBundlePipeline, cleanupPipelineResult } from '../../../src/pipeline/analyze.js';\nimport { writePipelineResult, writeTraceFile } from '../../../src/cli/output.js';\nimport { createTestBundle, getFixturePath } from '../../helpers/create-test-bundle.js';\n\n// ---------------------------------------------------------------------------\n// Setup — build .tar.gz archives for each scenario once\n// ---------------------------------------------------------------------------\n\nlet tmpDir: string;\nlet wrongDbBundlePath: string;\nlet missingSecretBundlePath: string;\nlet badImageTagBundlePath: string;\n\nbeforeAll(async () => {\n  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'sbi-integration-'));\n\n  wrongDbBundlePath = await createTestBundle(\n    getFixturePath('wrong-db-endpoint'),\n    path.join(tmpDir, 'wrong-db-endpoint.tar.gz'),\n  );\n\n  missingSecretBundlePath = await createTestBundle(\n    getFixturePath('missing-secret-crashloop'),\n    path.join(tmpDir, 'missing-secret-crashloop.tar.gz'),\n  );\n\n  badImageTagBundlePath = await createTestBundle(\n    getFixturePath('bad-image-tag'),\n    path.join(tmpDir, 'bad-image-tag.tar.gz'),\n  );\n});\n\nafterAll(() => {\n  fs.rmSync(tmpDir, { recursive: true, force: true });\n});\n\n// ---------------------------------------------------------------------------\n// Helper to run pipeline and auto-cleanup\n// ---------------------------------------------------------------------------\n\nasync function runPipeline(bundlePath: string, verbose = false) {\n  const result = await analyzeBundlePipeline(bundlePath, { verbose });\n  afterAll(() => cleanupPipelineResult(result));\n  return result;\n}\n\n// ---------------------------------------------------------------------------\n// Tests\n// ---------------------------------------------------------------------------\n\ndescribe('Pipeline Integration', () => {\n  describe('wrong-db-endpoint scenario', () => {\n    it('produces a profile with expected artifact counts', async () => {\n      const result = await runPipeline(wrongDbBundlePath);\n\n      expect(result.profile.analyzerCount).toBeGreaterThan(0);\n      expect(result.profile.resourceCount).toBeGreaterThan(0);\n      expect(result.profile.eventCount).toBeGreaterThan(0);\n      expect(result.profile.logFileCount).toBeGreaterThan(0);\n    });\n\n    it('includes the default namespace', async () => {\n      const result = await runPipeline(wrongDbBundlePath);\n      expect(result.profile.namespaces).toContain('default');\n    });\n\n    it('parses analyzer results with at least one warn entry', async () => {\n      const result = await runPipeline(wrongDbBundlePath);\n      const warns = result.analyzerResults.filter((r) => r.isWarn);\n      expect(warns.length).toBeGreaterThan(0);\n    });\n\n    it('parses K8s resources including at least one Pod', async () => {\n      const result = await runPipeline(wrongDbBundlePath);\n      const pods = result.resources.filter((r) => r.kind === 'Pod');\n      expect(pods.length).toBeGreaterThan(0);\n    });\n\n    it('parses events with at least one Warning', async () => {\n      const result = await runPipeline(wrongDbBundlePath);\n      const warnings = result.events.filter((e) => e.type === 'Warning');\n      expect(warnings.length).toBeGreaterThan(0);\n    });\n\n    it('parses log files', async () => {\n      const result = await runPipeline(wrongDbBundlePath);\n      expect(result.logs.length).toBeGreaterThan(0);\n    });\n  });\n\n  describe('missing-secret-crashloop scenario', () => {\n    it('identifies CrashLoopBackOff pod in resources', async () => {\n      const result = await runPipeline(missingSecretBundlePath);\n      const pods = result.resources.filter((r) => r.kind === 'Pod');\n      const crashLoopPod = pods.find((p) =>\n        JSON.stringify(p.status).includes('CrashLoopBackOff'),\n      );\n      expect(crashLoopPod).toBeDefined();\n    });\n\n    it('produces analyzer error results for missing secret', async () => {\n      const result = await runPipeline(missingSecretBundlePath);\n      const errors = result.analyzerResults.filter((r) => r.isFail);\n      expect(errors.length).toBeGreaterThan(0);\n    });\n\n    it('includes FailedMount or BackOff events', async () => {\n      const result = await runPipeline(missingSecretBundlePath);\n      const reasons = result.events.map((e) => e.reason);\n      const hasFailedMount = reasons.includes('FailedMount');\n      const hasBackOff = reasons.includes('BackOff');\n      expect(hasFailedMount || hasBackOff).toBe(true);\n    });\n  });\n\n  describe('bad-image-tag scenario', () => {\n\n[323 more lines in file. Use offset=121 to continue.]"}],"isError":false,"timestamp":1774121782371}}
