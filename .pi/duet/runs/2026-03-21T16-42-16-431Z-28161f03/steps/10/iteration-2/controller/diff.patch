+{"type":"message","id":"23dc4b61","parentId":"602ffee4","timestamp":"2026-03-21T19:31:34.828Z","message":{"role":"toolResult","toolCallId":"call_r5D8QkUoz8GQEs6b2cCCABv7|fc_0f9932afa4a686050169bef216b8f8819bad461ba74020b3f7","toolName":"read","content":[{"type":"text","text":"import { Command, CommanderError, InvalidArgumentError } from 'commander';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport type OutputFormat = 'json' | 'text' | 'summary' | 'markdown' | 'html';\n\nexport interface ParsedArgs {\n  bundlePath: string;\n  outputDir?: string;\n  format: OutputFormat;\n  verbose: boolean;\n  trace: boolean;\n  debug: boolean;\n  noAi: boolean;\n  /** When true, launch the interactive TUI instead of printing to stdout. */\n  tui: boolean;\n}\n\n// ---------------------------------------------------------------------------\n// Validators\n// ---------------------------------------------------------------------------\n\nconst VALID_FORMATS: OutputFormat[] = ['json', 'text', 'summary', 'markdown', 'html'];\n\nfunction validateFormat(value: string): OutputFormat {\n  if (!VALID_FORMATS.includes(value as OutputFormat)) {\n    throw new InvalidArgumentError(\n      `Invalid format \"${value}\". Must be one of: ${VALID_FORMATS.join(', ')}.`,\n    );\n  }\n  return value as OutputFormat;\n}\n\n// ---------------------------------------------------------------------------\n// parseArgs\n// ---------------------------------------------------------------------------\n\n/**\n * Parses command-line arguments using Commander.\n *\n * Uses `exitOverride()` so that `--help`/`--version` and invalid arguments\n * throw a {@link CommanderError} instead of calling `process.exit` directly.\n * The caller (typically the CLI entry point) is responsible for catching\n * these errors and exiting appropriately.\n *\n * @param argv - Raw argument vector. Defaults to `process.argv`.\n *               In tests, pass `['node', 'sbi', 'analyze', '<bundle>', ...]`.\n * @throws {CommanderError} when `--help` or `--version` is requested (code 0)\n *         or when required arguments are missing/invalid (code 1).\n */\nexport function parseArgs(argv: string[] = process.argv): ParsedArgs {\n  let bundlePath = '';\n  let capturedOpts: {\n    outputDir?: string;\n    format?: OutputFormat;\n    verbose?: boolean;\n    trace?: boolean;\n    debug?: boolean;\n    /** Commander --no-ai stores the negation under property `ai` */\n    ai?: boolean;\n    tui?: boolean;\n  } = {};\n\n  const program = new Command();\n\n  // Prevent Commander from calling process.exit; throw CommanderError instead\n  program.exitOverride();\n\n  program\n    .name('sbi')\n    .description(\n      'Support Bundle Investigator — evidence-backed diagnosis from support bundles',\n    )\n    .version('0.1.0');\n\n  const analyzeCmd = new Command('analyze');\n  analyzeCmd\n    .description('Analyze a support bundle .tar.gz archive')\n    .argument('<bundle-path>', 'Path to the support bundle .tar.gz file')\n    .option(\n      '--output-dir <dir>',\n      'Directory to write output artifacts (findings.json, report.md, report.html, optional trace.json)',\n    )\n    .option(\n      '--format <format>',\n      'Output format: json | text | summary | markdown | html (default: text)',\n      validateFormat,\n      'text' as OutputFormat,\n    )\n    .option('--verbose', 'Enable verbose pipeline logging', false)\n    .option('--trace', 'Write a JSON trace file to the output directory', false)\n    .option('--debug', 'Include debug-oriented provenance fields in machine-readable output', false)\n    .option('--no-ai', 'Disable AI features and run in heuristic-only mode')\n    .option('--tui', 'Launch interactive terminal UI for investigation results', false)\n    .exitOverride()\n    .action((bp: string, opts: typeof capturedOpts) => {\n      bundlePath = bp;\n      capturedOpts = opts;\n    });\n\n  program.addCommand(analyzeCmd);\n  program.parse(argv);\n\n  if (!bundlePath) {\n    // No subcommand was matched — show help and throw\n    throw new CommanderError(\n      1,\n      'commander.missingArgument',\n      'Missing required argument: bundle-path. Run `sbi analyze --help` for usage.',\n    );\n  }\n\n  return {\n    bundlePath,\n    outputDir: capturedOpts.outputDir,\n    format: capturedOpts.format ?? 'text',\n    verbose: capturedOpts.verbose ?? false,\n    trace: capturedOpts.trace ?? false,\n    debug: capturedOpts.debug ?? false,\n    // Commander's --no-ai sets `ai` to false; absence means AI is not disabled\n    noAi: capturedOpts.ai === false,\n    tui: capturedOpts.tui ?? false,\n  };\n}\n\n/**\n * Re-export so callers can do instance checks without importing commander directly.\n */\nexport { CommanderError };\n"}],"isError":false,"timestamp":1774121494828}}
+{"type":"message","id":"18b26dcf","parentId":"23dc4b61","timestamp":"2026-03-21T19:31:34.828Z","message":{"role":"toolResult","toolCallId":"call_INhO6fvCVoL9mpDpXSCD3wrK|fc_0f9932afa4a686050169bef216b908819b8f1f0b6acbf45bde","toolName":"read","content":[{"type":"text","text":"import { parseArgs, CommanderError } from './cli.js';\nimport { analyzeBundlePipeline, cleanupPipelineResult } from '../pipeline/analyze.js';\nimport { writePipelineResult, writeTraceFile } from './output.js';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport interface RunCliOptions {\n  /**\n   * Lazy loader for the TUI module.  Provided only by the CLI binary entry\n   * point (`src/cli/run.ts`) where the relative import path to `dist/tui/`\n   * is stable.  Omitted when `runCli` is called from the library entry\n   * (`src/index.ts`) or from tests.\n   */\n  loadTUI?: () => Promise<{\n    renderTUI: (bundlePath: string, options: Record<string, unknown>) => Promise<void>;\n  }>;\n}\n\n// ---------------------------------------------------------------------------\n// runCli\n// ---------------------------------------------------------------------------\n\n/**\n * Runs the SBI CLI for the provided argv vector and returns the intended exit\n * code instead of terminating the process directly.\n *\n * @param argv    - Raw argument vector (defaults to `process.argv`).\n * @param options - Optional dependency-injection options (e.g. TUI loader).\n */\nexport async function runCli(\n  argv: string[] = process.argv,\n  options: RunCliOptions = {},\n): Promise<number> {\n  let args;\n  let result: Awaited<ReturnType<typeof analyzeBundlePipeline>> | undefined;\n\n  try {\n    args = parseArgs(argv);\n  } catch (err) {\n    if (err instanceof CommanderError) {\n      // exitCode 0 = --help / --version (output already printed by Commander)\n      return err.exitCode;\n    }\n\n    console.error((err as Error).message);\n    return 1;\n  }\n\n  // ── TUI mode ─────────────────────────────────────────────────────────────\n  if (args.tui) {\n    if (!options.loadTUI) {\n      console.error('Error: --tui is only supported when running via the sbi CLI binary.');\n      return 1;\n    }\n\n    try {\n      const { renderTUI } = await options.loadTUI();\n      await renderTUI(args.bundlePath, {\n        outputDir: args.outputDir,\n        verbose: args.verbose,\n        noAi: args.noAi,\n        trace: args.trace,\n        debug: args.debug,\n      });\n      return 0;\n    } catch (err) {\n      console.error('Error:', (err as Error).message);\n      return 1;\n    }\n  }\n\n  // ── Standard pipeline mode ────────────────────────────────────────────────\n  try {\n    result = await analyzeBundlePipeline(args.bundlePath, {\n      outputDir: args.outputDir,\n      verbose: args.verbose,\n      trace: args.trace,\n      debug: args.debug,\n      noAi: args.noAi,\n    });\n\n    await writePipelineResult(result, {\n      format: args.format,\n      outputDir: args.outputDir,\n      verbose: args.verbose,\n      debug: args.debug,\n    });\n\n    if (args.trace && args.outputDir) {\n      await writeTraceFile(result.trace, args.outputDir);\n    }\n\n    return 0;\n  } catch (err) {\n    console.error('Error:', (err as Error).message);\n    return 1;\n  } finally {\n    if (result) {\n      await cleanupPipelineResult(result);\n    }\n  }\n}\n"}],"isError":false,"timestamp":1774121494828}}
+{"type":"message","id":"52027bed","parentId":"18b26dcf","timestamp":"2026-03-21T19:31:34.829Z","message":{"role":"toolResult","toolCallId":"call_nz34zRYQ3qz9SKSlwua6Sn1v|fc_0f9932afa4a686050169bef216b90c819ba7bd39c46294ee2a","toolName":"read","content":[{"type":"text","text":"import * as fsp from 'fs/promises';\nimport * as path from 'path';\nimport type { BundleProfile } from '../types/index.js';\nimport type { InvestigationTrace } from '../pipeline/trace.js';\nimport type { PipelineResult } from '../pipeline/analyze.js';\nimport {\n  buildReport,\n  generateJsonReport,\n  generateMarkdownReport,\n  generateHtmlReport,\n  writeJsonReport,\n} from '../reporters/index.js';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport interface OutputOptions {\n  format: 'json' | 'text' | 'summary' | 'markdown' | 'html';\n  outputDir?: string;\n  verbose?: boolean;\n  debug?: boolean;\n}\n\n// ---------------------------------------------------------------------------\n// Console output\n// ---------------------------------------------------------------------------\n\n/**\n * Prints a human-readable summary of the bundle profile to stdout.\n */\nexport function printProfileSummary(profile: BundleProfile): void {\n  const { manifest, analyzerCount, logFileCount, resourceCount, eventCount } = profile;\n\n  console.log('');\n  console.log('═══════════════════════════════════════════════════════');\n  console.log('  Support Bundle Profile');\n  console.log('═══════════════════════════════════════════════════════');\n  console.log(`  Bundle:       ${manifest.bundlePath}`);\n  console.log(`  Files:        ${manifest.files.length}`);\n  console.log(`  Analyzers:    ${analyzerCount}`);\n  console.log(`  Resources:    ${resourceCount}`);\n  console.log(`  Events:       ${eventCount}`);\n  console.log(`  Log files:    ${logFileCount}`);\n  console.log('');\n\n  if (profile.namespaces.length > 0) {\n    console.log(`  Namespaces:   ${profile.namespaces.join(', ')}`);\n  }\n\n  if (profile.workloads.length > 0) {\n    console.log('');\n    console.log('  Workloads:');\n    for (const wl of profile.workloads) {\n      console.log(`    - [${wl.kind}] ${wl.namespace}/${wl.name}`);\n    }\n  }\n\n  if (profile.coverageGaps.length > 0) {\n    console.log('');\n    console.log('  Coverage gaps:');\n    for (const gap of profile.coverageGaps) {\n      console.log(`    ⚠  ${gap}`);\n    }\n  }\n\n  console.log('═══════════════════════════════════════════════════════');\n  console.log('');\n}\n\n// ---------------------------------------------------------------------------\n// File output\n// ---------------------------------------------------------------------------\n\n/**\n * Writes the investigation trace to a JSON file in `outputDir`.\n */\nexport async function writeTraceFile(\n  trace: InvestigationTrace,\n  outputDir: string,\n): Promise<void> {\n  await fsp.mkdir(outputDir, { recursive: true });\n  const traceFile = path.join(outputDir, 'trace.json');\n  await fsp.writeFile(traceFile, JSON.stringify(trace, null, 2), 'utf-8');\n}\n\n/**\n * Prints a text summary of analysis results to stdout.\n *\n * @deprecated Prefer `writePipelineResult` which now uses the Markdown reporter.\n *             Kept for backward-compatible re-exports.\n */\nexport function printTextSummary(result: PipelineResult): void {\n  printProfileSummary(result.profile);\n\n  const errors = result.analyzerResults.filter((r) => r.isFail);\n  const warns = result.analyzerResults.filter((r) => r.isWarn);\n\n  if (errors.length > 0) {\n    console.log('  ❌  Analyzer Errors:');\n    for (const e of errors) {\n      console.log(`    [${e.name}] ${e.title}`);\n      if (e.message) console.log(`      ${e.message}`);\n    }\n    console.log('');\n  }\n\n  if (warns.length > 0) {\n    console.log('  ⚠   Analyzer Warnings:');\n    for (const w of warns) {\n      console.log(`    [${w.name}] ${w.title}`);\n      if (w.message) console.log(`      ${w.message}`);\n    }\n    console.log('');\n  }\n}\n\n/**\n * Writes the pipeline result to disk or prints to stdout depending on the\n * output options.\n *\n * When `outputDir` is set, always writes all three report files:\n *   - `findings.json`  — full structured report (via JSON reporter)\n *   - `report.md`      — human-readable Markdown report\n *   - `report.html`    — self-contained HTML report with embedded CSS\n *\n * When `outputDir` is not set, format controls stdout output:\n *   - `json`           — prints full JSON report to stdout\n *   - `text`           — prints Markdown report to stdout\n *   - `markdown`       — prints Markdown report to stdout\n *   - `html`           — prints HTML report to stdout\n *   - `summary`        — prints bundle profile summary to stdout\n */\nexport async function writePipelineResult(\n  result: PipelineResult,\n  options: OutputOptions,\n): Promise<void> {\n  const { format, outputDir } = options;\n  const includeProvenance = options.debug === true || result.debug === true;\n\n  if (outputDir) {\n    // Always write all three report files when an output directory is provided.\n    const resolvedDir = path.resolve(outputDir);\n    await fsp.mkdir(resolvedDir, { recursive: true });\n\n    const report = buildReport(result);\n\n    await writeJsonReport(report, resolvedDir, { includeProvenance });\n\n    const mdPath = path.join(resolvedDir, 'report.md');\n    await fsp.writeFile(mdPath, generateMarkdownReport(report), 'utf-8');\n\n    const htmlPath = path.join(resolvedDir, 'report.html');\n    await fsp.writeFile(htmlPath, generateHtmlReport(report), 'utf-8');\n\n    console.log(`Reports written to ${resolvedDir}: findings.json, report.md, report.html`);\n    return;\n  }\n\n  // No outputDir — print to stdout based on format.\n  if (format === 'summary') {\n    printProfileSummary(result.profile);\n    return;\n  }\n\n  const report = buildReport(result);\n\n  if (format === 'json') {\n    console.log(generateJsonReport(report, { includeProvenance }));\n  } else if (format === 'html') {\n    console.log(generateHtmlReport(report));\n  } else {\n    // 'text' | 'markdown'\n    console.log(generateMarkdownReport(report));\n  }\n}\n"}],"isError":false,"timestamp":1774121494829}}
+{"type":"message","id":"167115e4","parentId":"52027bed","timestamp":"2026-03-21T19:31:34.829Z","message":{"role":"toolResult","toolCallId":"call_L51i8HjLGGdc2hlPyuKQo6Lc|fc_0f9932afa4a686050169bef216b914819b9d721015459bdd00","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from 'vitest';\nimport { parseArgs, CommanderError } from '../cli.js';\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Builds a process.argv-style array for the `analyze` subcommand.\n *\n * Commander expects argv[0] = node binary, argv[1] = script path.\n */\nfunction argv(...args: string[]): string[] {\n  return ['node', 'sbi', ...args];\n}\n\n// ---------------------------------------------------------------------------\n// parseArgs — successful cases\n// ---------------------------------------------------------------------------\n\ndescribe('parseArgs()', () => {\n  it('extracts bundle path from arguments', () => {\n    const result = parseArgs(argv('analyze', 'my-bundle.tar.gz'));\n    expect(result.bundlePath).toBe('my-bundle.tar.gz');\n  });\n\n  it('defaults to text format when --format is omitted', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz'));\n    expect(result.format).toBe('text');\n  });\n\n  it('defaults verbose to false when --verbose is omitted', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz'));\n    expect(result.verbose).toBe(false);\n  });\n\n  it('defaults trace to false when --trace is omitted', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz'));\n    expect(result.trace).toBe(false);\n  });\n\n  it('defaults debug to false when --debug is omitted', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz'));\n    expect(result.debug).toBe(false);\n  });\n\n  it('accepts --output-dir flag', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--output-dir', '/tmp/out'));\n    expect(result.outputDir).toBe('/tmp/out');\n  });\n\n  it('accepts --format json flag', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--format', 'json'));\n    expect(result.format).toBe('json');\n  });\n\n  it('accepts --format text flag', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--format', 'text'));\n    expect(result.format).toBe('text');\n  });\n\n  it('accepts --format summary flag', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--format', 'summary'));\n    expect(result.format).toBe('summary');\n  });\n\n  it('accepts --format markdown flag', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--format', 'markdown'));\n    expect(result.format).toBe('markdown');\n  });\n\n  it('accepts --format html flag', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--format', 'html'));\n    expect(result.format).toBe('html');\n  });\n\n  it('accepts --verbose flag', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--verbose'));\n    expect(result.verbose).toBe(true);\n  });\n\n  it('accepts --trace flag', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--trace'));\n    expect(result.trace).toBe(true);\n  });\n\n  it('accepts --debug flag', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--debug'));\n    expect(result.debug).toBe(true);\n  });\n\n  it('accepts all flags together', () => {\n    const result = parseArgs(\n      argv(\n        'analyze',\n        'bundle.tar.gz',\n        '--output-dir',\n        '/tmp/sbi-out',\n        '--format',\n        'json',\n        '--verbose',\n        '--trace',\n        '--debug',\n      ),\n    );\n    expect(result.bundlePath).toBe('bundle.tar.gz');\n    expect(result.outputDir).toBe('/tmp/sbi-out');\n    expect(result.format).toBe('json');\n    expect(result.verbose).toBe(true);\n    expect(result.trace).toBe(true);\n    expect(result.debug).toBe(true);\n  });\n\n  it('defaults noAi to false when --no-ai is omitted', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz'));\n    expect(result.noAi).toBe(false);\n  });\n\n  it('sets noAi to true when --no-ai flag is passed', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--no-ai'));\n    expect(result.noAi).toBe(true);\n  });\n\n  it('accepts --no-ai together with other flags', () => {\n    const result = parseArgs(\n      argv('analyze', 'bundle.tar.gz', '--verbose', '--no-ai', '--format', 'json'),\n    );\n    expect(result.noAi).toBe(true);\n    expect(result.verbose).toBe(true);\n    expect(result.format).toBe('json');\n  });\n\n  // ── Error cases ─────────────────────────────────────────────────────────\n\n  it('rejects missing bundle path (no analyze subcommand)', () => {\n    expect(() => parseArgs(argv())).toThrow();\n  });\n\n  it('shows help with --help flag (throws CommanderError with code 0)', () => {\n    let error: unknown;\n    try {\n      parseArgs(argv('analyze', '--help'));\n    } catch (err) {\n      error = err;\n    }\n    expect(error).toBeInstanceOf(CommanderError);\n    expect((error as CommanderError).exitCode).toBe(0);\n  });\n\n  it('rejects invalid --format value', () => {\n    expect(() =>\n      parseArgs(argv('analyze', 'bundle.tar.gz', '--format', 'xml')),\n    ).toThrow();\n  });\n\n  // ── --tui flag ───────────────────────────────────────────────────────────\n\n  it('defaults tui to false when --tui is omitted', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz'));\n    expect(result.tui).toBe(false);\n  });\n\n  it('sets tui to true when --tui flag is passed', () => {\n    const result = parseArgs(argv('analyze', 'bundle.tar.gz', '--tui'));\n    expect(result.tui).toBe(true);\n  });\n\n  it('accepts --tui together with other flags', () => {\n    const result = parseArgs(\n      argv('analyze', 'bundle.tar.gz', '--tui', '--verbose', '--no-ai'),\n    );\n    expect(result.tui).toBe(true);\n    expect(result.verbose).toBe(true);\n    expect(result.noAi).toBe(true);\n  });\n});\n"}],"isError":false,"timestamp":1774121494829}}
