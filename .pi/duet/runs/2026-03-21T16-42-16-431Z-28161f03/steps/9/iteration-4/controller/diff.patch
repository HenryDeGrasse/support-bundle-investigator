-----------------------------------------\n\nexport type PipelineStepStatus = 'started' | 'completed';\n\nexport interface PipelineProgressEvent {\n  /** Name of the pipeline step (matches trace step names: 'extract', 'profile', 'parse-analyzers', 'parse-resources', 'parse-events', 'parse-logs', 'ai-index', 'build-graph', 'investigate'). */\n  step: string;\n  /** Whether the step just started or just completed. */\n  status: PipelineStepStatus;\n  /** Number of artifacts processed (only set when status is 'completed'). */\n  artifactsProcessed?: number;\n  /** Optional detail message for sub-step progress (e.g. per-seed AI investigation). */\n  detail?: string;\n}\n\nexport interface PipelineOptions {\n  outputDir?: string;\n  format?: 'json' | 'text' | 'summary' | 'markdown' | 'html';\n  verbose?: boolean;\n  trace?: boolean;\n  /** When true, include debug-oriented fields such as finding provenance in machine-readable outputs. */\n  debug?: boolean;\n  /** When true, AI features are disabled regardless of API key presence. */\n  noAi?: boolean;\n  /** Optional explicit cassette directory override for AI record/replay mode. */\n  cassetteDir?: string;\n  /** Optional callback invoked when each pipeline step starts and completes. */\n  onProgress?: (event: PipelineProgressEvent) => void;\n}\n\n/**\n * AI mode label describing how the AI layer was configured for this run.\n *\n * - `'cloud'` — LLM calls go to OpenAI (or another cloud provider).\n * - `'local'` — LLM calls go to a local server (Ollama, llama.cpp, etc.).\n * - `'off'`   — AI features disabled (heuristic-only mode).\n */\nexport type AIMode = 'cloud' | 'local' | 'off';\n\nexport interface PipelineResult {\n  profile: BundleProfile;\n  analyzerResults: AnalyzerResult[];\n  resources: K8sResource[];\n  events: K8sEvent[];\n  logs: LogFile[];\n  /** Verified, deduplicated findings produced by the investigation pipeline. */\n  findings: Finding[];\n  /** Causal tree built from findings and 'causes' graph edges. */\n  findingTree: FindingTreeNode[];\n  graph: InvestigationGraphImpl;\n  trace: InvestigationTrace;\n  /** How the AI layer was configured: 'cloud', 'local', or 'off'. */\n  aiMode: AIMode;\n  /** Whether debug-oriented output fields should be preserved in downstream report serialization. */\n  debug?: boolean;\n}\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfunction log(message: string, verbose: boolean): void {\n  if (verbose) {\n    console.log(`[pipeline] ${message}`);\n  }\n}\n\nfunction emitProgress(options: PipelineOptions, event: PipelineProgressEvent): void {\n  options.onProgress?.(event);\n}\n\nfunction resolveCassetteDir(options: PipelineOptions): string {\n  const explicit = options.cassetteDir?.trim();\n  if (explicit !== undefined && explicit.length > 0) {\n    return path.resolve(explicit);\n  }\n\n  const envOverride = process.env['SBI_CASSETTE_DIR']?.trim();\n  if (envOverride !== undefined && envOverride.length > 0) {\n    return path.resolve(envOverride);\n  }\n\n  if (options.outputDir !== undefined && options.outputDir.trim().length > 0) {\n    return path.resolve(options.outputDir, 'cassettes');\n  }\n\n  return path.resolve(os.tmpdir(), 'sbi-cassettes');\n}\n\nfunction buildSeedCategoryBreakdown(\n  seeds: ReadonlyArray<{ category: string }>,\n): Record<string, number> {\n  return seeds.reduce<Record<string, number>>((counts, seed) => {\n    counts[seed.category] = (counts[seed.category] ?? 0) + 1;\n    return counts;\n  }, {});\n}\n\nfunction computeConfidenceStats(findings: ReadonlyArray<Pick<Finding, 'confidence'>>): ConfidenceStats {\n  if (findings.length === 0) {\n    return { min: 0, max: 0, mean: 0, median: 0 };\n  }\n\n  const confidences = findings\n    .map((finding) => finding.confidence)\n    .sort((left, right) => left - right);\n  const min = confidences[0] ?? 0;\n  const max = confidences[confidences.length - 1] ?? 0;\n  const mean = confidences.reduce((sum, value) => sum + value, 0) / confidences.length;\n  const middle = Math.floor(confidences.length / 2);\n  const median = confidences.length % 2 === 0\n    ? ((confidences[middle - 1] ?? 0) + (confidences[middle] ?? 0)) / 2\n    : (confidences[middle] ?? 0);\n\n  return {\n    min,\n    max,\n    mean,\n    median,\n  };\n}\n\nfunction zeroRetrievalStats(): RetrievalStats {\n  return {\n    graphChunks: 0,\n    lexicalChunks: 0,\n    semanticChunks: 0,\n    mergedChunks: 0,\n  };\n}\n\nfunction addInvestigationEvidenceNode(\n  graph: InvestigationGraphImpl,\n  nodeId: string,\n  evidence: Evidence,\n): boolean {\n  if (graph.getNode(nodeId)) {\n    return false;\n  }\n\n  graph.addNode({\n    id: nodeId,\n    type: 'evidence',\n    data: evidence,\n    metadata: {\n      category: evidence.artifactType ?? 'unknown',\n      timestamp: evidence.timestamp,\n      derived: true,\n    },\n  });\n\n  return true;\n\n[625 more lines in file. Use offset=221 to continue.]"}],"isError":false,"timestamp":1774120018741}}
+{"type":"message","id":"e39f814d","parentId":"d85c518f","timestamp":"2026-03-21T19:06:58.742Z","message":{"role":"toolResult","toolCallId":"call_SFQiFsumJj5OOckeklh4d4HP|fc_0f9932afa4a686050169beec5279d8819b9f59d02746e0418c","toolName":"read","content":[{"type":"text","text":"import type { Finding } from '../types/index.js';\n\n// ---------------------------------------------------------------------------\n// SpecRecommendation\n// ---------------------------------------------------------------------------\n\n/**\n * A recommendation to improve the support bundle specification, generated\n * from evidence gaps and heuristic findings discovered during investigation.\n *\n * - `collector`  — suggests adding or expanding a data collector so future\n *                  bundles contain the missing artifact class.\n * - `analyzer`   — suggests adding a deterministic analyzer to replace a\n *                  heuristic finding (improves precision and repeatability).\n * - `redaction`  — suggests adding a redaction rule when sensitive data paths\n *                  appear in evidence but no existing rule covers them.\n */\nexport type SpecRecommendationType = 'collector' | 'analyzer' | 'redaction';\n\nexport interface SpecRecommendation {\n  /** The category of spec improvement being suggested. */\n  type: SpecRecommendationType;\n  /**\n   * Human-readable description of the recommended spec change.\n   * Should be concise and actionable (one or two sentences).\n   */\n  description: string;\n  /**\n   * Explanation of why this recommendation was generated — which evidence gap\n   * or heuristic finding triggered it, so the suggestion is traceable.\n   */\n  rationale: string;\n}\n\n// ---------------------------------------------------------------------------\n// ReportOptions\n// ---------------------------------------------------------------------------\n\nexport type ReportFormat = 'markdown' | 'html' | 'json';\n\n/**\n * Configuration options controlling how a report is written to disk.\n *\n * - `format`        — output format (default: `'markdown'`)\n * - `outputDir`     — directory where the report file will be written\n *                     (default: current working directory)\n * - `includeTrace`  — when `true`, the full investigation trace is appended\n *                     as a separate section / field in the report\n */\nexport interface ReportOptions {\n  format?: ReportFormat;\n  outputDir?: string;\n  includeTrace?: boolean;\n}\n\n// ---------------------------------------------------------------------------\n// InvestigationReport\n// ---------------------------------------------------------------------------\n\n/**\n * The top-level output of the reporting layer.\n *\n * All fields are serialisation-safe (no class instances, no functions) so the\n * report can be written to JSON, Markdown, or HTML without transformation.\n */\nexport interface InvestigationReport {\n  /**\n   * High-level narrative written for a human reader — typically 2–4 sentences\n   * summarising the most critical finding, the overall confidence, and the\n   * recommended immediate action.\n   */\n  executiveSummary: string;\n\n  /**\n   * Verified, deduplicated findings sorted by severity then confidence\n   * (highest first).  This is the primary payload for report consumers.\n   */\n  findings: Finding[];\n\n  /**\n   * The single most likely root cause for the observed symptoms.  Derived\n   * from the highest-ranked finding; may be `null` when no findings exist.\n   */\n  rootCause: string | null;\n\n  /**\n   * Flat list of all evidence references cited across every finding, with\n   * duplicates removed.  Useful for report sections that list all touched\n   * files in one place.\n   */\n  evidenceReferences: Array<{ path: string; note: string }>;\n\n  /**\n   * Union of `contradictionsChecked` strings across all findings, with\n   * duplicates removed.  Surfaces the \"what we checked and ruled out\"\n   * narrative for the reader.\n   */\n  contradictions: string[];\n\n  /**\n   * Consolidated recommended next steps drawn from `recommendedAction` on\n   * every finding (highest-severity first).  Duplicates are removed.\n   */\n  nextSteps: string[];\n\n  /**\n   * Union of `missingEvidence` strings across all findings, with duplicates\n   * removed.  Tells the reader what additional data would improve confidence.\n   */\n  missingEvidence: string[];\n\n  /**\n   * Suggestions for improving the support bundle spec — collectors, analyzers,\n   * or redaction rules that should be added to prevent evidence gaps in future\n   * bundles.  Empty when the investigation found sufficient coverage.\n   */\n  specRecommendations: SpecRecommendation[];\n}\n"}],"isError":false,"timestamp":1774120018741}}
+{"type":"message","id":"0c965642","parentId":"e39f814d","timestamp":"2026-03-21T19:06:58.742Z","message":{"role":"toolResult","toolCallId":"call_lwPq4nhTu2wXStnTzm1iyjD9|fc_0f9932afa4a686050169beec5279dc819bb5a094b6a51727ef","toolName":"read","content":[{"type":"text","text":"import type { PipelineResult } from '../pipeline/analyze.js';\nimport type { Finding } from '../types/index.js';\nimport type { InvestigationReport } from './types.js';\nimport { generateSpecRecommendations } from './spec-recommender.js';\nimport { cleanEvidencePath, humanizeTitle } from './display-helpers.js';\n\n// ---------------------------------------------------------------------------\n// AI finding helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Returns `true` when a finding was produced by the AI investigator.\n *\n * AI findings carry IDs prefixed with `finding:ai:`, assigned by\n * `convertAIFindings` in the AI investigator.\n */\nexport function isAIFinding(finding: Finding): boolean {\n  return finding.id.startsWith('finding:ai:');\n}\n\n/**\n * Returns the number of distinct `artifactType` values across all evidence\n * items in a finding.\n *\n * A value of 2 or more means the finding corroborates evidence from at least\n * two different artifact categories (e.g., log + kubernetes-resource), which\n * indicates cross-source correlation.\n */\nfunction countDistinctArtifactTypes(finding: Finding): number {\n  const types = new Set<string>();\n  for (const ev of finding.evidence) {\n    if (ev.artifactType !== undefined && ev.artifactType.trim().length > 0) {\n      types.add(ev.artifactType);\n    }\n  }\n  return types.size;\n}\n\n// ---------------------------------------------------------------------------\n// Internal helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Generates a concise, human-readable executive summary from the ranked list\n * of findings and the bundle profile.\n *\n * When no findings are present the summary states that no significant issues\n * were detected.  When findings are present the summary names the top finding,\n * states the overall count and highest severity level, and quotes the\n * recommended action so a reader can act immediately.\n *\n * When AI-augmented findings are present, the summary appends a sentence\n * noting AI analysis was used along with the count of AI findings.\n */\nfunction generateExecutiveSummary(findings: Finding[]): string {\n  if (findings.length === 0) {\n    return (\n      'No significant issues were identified in this support bundle. ' +\n      'All investigated conditions appear normal.'\n    );\n  }\n\n  const topFinding = findings[0]!;\n  const criticalCount = findings.filter((f) => f.severity === 'critical').length;\n  const highCount = findings.filter((f) => f.severity === 'high').length;\n\n  const severitySummary =\n    criticalCount > 0\n      ? `${criticalCount} critical issue${criticalCount > 1 ? 's' : ''} require${criticalCount === 1 ? 's' : ''} immediate attention.`\n      : highCount > 0\n        ? `${highCount} high-severity issue${highCount > 1 ? 's' : ''} ${highCount === 1 ? 'was' : 'were'} found.`\n        : '';\n\n  const confidencePct = Math.round(topFinding.confidence * 100);\n\n  const aiFindings = findings.filter(isAIFinding);\n  const aiFindingCount = aiFindings.length;\n  const crossSourceAIFindingCount = aiFindings.filter(\n    (finding) => countDistinctArtifactTypes(finding) >= 2,\n  ).length;\n  const aiNote =\n    aiFindingCount > 0\n      ? crossSourceAIFindingCount > 0\n        ? `AI-augmented analysis contributed ${aiFindingCount} finding${aiFindingCount > 1 ? 's' : ''}, including ${crossSourceAIFindingCount} with cross-source evidence correlation.`\n        : `AI-augmented analysis contributed ${aiFindingCount} finding${aiFindingCount > 1 ? 's' : ''}.`\n      : '';\n\n  return [\n    `Investigation identified ${findings.length} finding${findings.length > 1 ? 's' : ''}.`,\n    severitySummary,\n    `Most significant: ${humanizeTitle(topFinding.title)} (confidence: ${confidencePct}%).`,\n    `Recommended action: ${topFinding.recommendedAction}`,\n    aiNote,\n  ]\n    .filter(Boolean)\n    .join(' ');\n}\n\n/**\n * Derives a root-cause string from the verified findings list.\n *\n * Selection logic (in priority order):\n * 1. AI findings with evidence spanning 2+ distinct `artifactType` values\n *    (cross-source correlation — most trustworthy causal explanation).\n * 2. All other findings (first by severity+confidence ordering, which callers\n *    are expected to preserve before passing findings here).\n *\n * Returns `null` when there are no findings.\n */\nfunction deriveRootCause(findings: Finding[]): string | null {\n  if (findings.length === 0) return null;\n\n  // Prefer cross-source AI findings (evidence from 2+ distinct artifact types)\n  const crossSourceAI = findings.filter(\n    (f) => isAIFinding(f) && countDistinctArtifactTypes(f) >= 2,\n  );\n  if (crossSourceAI.length > 0) {\n    return crossSourceAI[0]!.reasoningSummary;\n  }\n\n  // Fall back to the highest-ranked finding (callers sort by severity desc, confidence desc)\n  return findings[0]!.reasoningSummary;\n}\n\n/**\n * Collects all evidence references across findings, deduplicating by path.\n * The first note encountered for a given path is retained.\n */\nfunction collectEvidenceReferences(\n  findings: Finding[],\n): Array<{ path: string; note: string }> {\n  const seen = new Set<string>();\n  const refs: Array<{ path: string; note: string }> = [];\n\n  for (const finding of findings) {\n    for (const ev of finding.evidence) {\n      const cleanedPath = cleanEvidencePath(ev.path);\n      if (!seen.has(cleanedPath)) {\n        seen.add(cleanedPath);\n        refs.push({ path: cleanedPath, note: ev.note });\n      }\n    }\n  }\n\n  return refs;\n}\n\n/**\n * Generic helper: flattens a string field from every finding, deduplicating\n * by exact string equality while preserving insertion order.\n */\nfunction collectDeduped(\n  getItems: (finding: Finding) => string[],\n  findings: Finding[],\n): string[] {\n  const seen = new Set<string>();\n  const result: string[] = [];\n\n  for (const finding of findings) {\n    for (const item of getItems(finding)) {\n      if (!seen.has(item)) {\n        seen.add(item);\n        result.push(item);\n      }\n    }\n  }\n\n  return result;\n}\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\n/**\n * Assembles an {@link InvestigationReport} from a completed\n * {@link PipelineResult}.\n *\n * The function:\n * 1. Generates an **executive summary** naming the most critical finding,\n *    the total finding count, and the recommended immediate action.\n * 2. Passes the already-ranked `findings[]` through unchanged (the\n *    orchestrator sorts them by severity then confidence).\n * 3. Derives the **root cause** from the highest-ranked finding's\n *    `reasoningSummary`.\n * 4. Collects deduplicated **evidence references**, **contradictions**,\n *    **next steps**, and **missing evidence** across all findings.\n * 5. Calls {@link generateSpecRecommendations} to produce collector,\n *    analyzer, and redaction suggestions from evidence gaps and the bundle\n *    profile's coverage gaps.\n *\n * All fields in the returned report are serialisation-safe (no class\n * instances, no functions) so the result can be passed directly to any of\n * the three reporters.\n *\n * @param result - The completed pipeline result containing findings, profile,\n *                 and all parsed bundle data.\n * @returns A fully assembled {@link InvestigationReport}.\n */\nexport function buildReport(result: PipelineResult): InvestigationReport {\n  const { findings, profile } = result;\n\n  const executiveSummary = generateExecutiveSummary(findings);\n  const rootCause = deriveRootCause(findings);\n  const specRecommendations = generateSpecRecommendations(findings, profile);\n  const evidenceReferences = collectEvidenceReferences(findings);\n  const contradictions = collectDeduped((f) => f.contradictionsChecked, findings);\n  const nextSteps = collectDeduped((f) => [f.recommendedAction], findings);\n  const missingEvidence = collectDeduped((f) => f.missingEvidence, findings);\n\n  return {\n    executiveSummary,\n    findings,\n    rootCause,\n    evidenceReferences,\n    contradictions,\n    nextSteps,\n    missingEvidence,\n    specRecommendations,\n  };\n}\n"}],"isError":false,"timestamp":1774120018741}}
