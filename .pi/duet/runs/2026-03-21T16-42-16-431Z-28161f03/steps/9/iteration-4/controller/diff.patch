"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":233609,"output":558,"cacheRead":0,"cacheWrite":0,"totalTokens":234167,"cost":{"input":0.5840225,"output":0.00837,"cacheRead":0,"cacheWrite":0,"total":0.5923925}},"stopReason":"toolUse","timestamp":1774119993389,"responseId":"resp_0f9932afa4a686050169beec3a1a4c819b9ebf9c5082530a75"}}
+{"type":"message","id":"ffe626a7","parentId":"c97f2fe9","timestamp":"2026-03-21T19:06:58.740Z","message":{"role":"toolResult","toolCallId":"call_6UJtVXm8bSZtjTwh1wsq9Vly|fc_0f9932afa4a686050169beec527990819bb038f1f596ed2341","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// LLM Client\n// ---------------------------------------------------------------------------\n//\n// Thin wrapper around the OpenAI chat completions API for structured AI\n// investigations.\n//\n// Design principles:\n// - Never throws — all API/network/parse errors are caught, logged with\n//   console.warn, and returned as empty findings arrays.\n// - Uses JSON mode (response_format: { type: 'json_object' }) to ensure\n//   the model returns valid JSON that can be parsed and validated.\n// - Validates the parsed response through `validateAIFindings` before\n//   returning — invalid findings are dropped, not thrown.\n\nimport OpenAI from 'openai';\nimport type { AIConfig } from './config.js';\nimport type { AIFinding } from './schemas.js';\nimport { validateAIFindings } from './schemas.js';\nimport type { HydeLLMClient } from './hyde.js';\n\n// ---------------------------------------------------------------------------\n// AIFindingResponse\n// ---------------------------------------------------------------------------\n\n/**\n * The response produced by a single LLM investigation call.\n *\n * On API failure, `findings` is empty and `rawResponse` is absent.\n * On JSON parse failure, `findings` is empty and `rawResponse` holds the\n * unparseable string for debugging.\n */\nexport interface AIFindingResponse {\n  /** Validated, sanitised findings. Empty when the call fails or returns nothing useful. */\n  findings: AIFinding[];\n  /** Raw JSON string returned by the model (present even on validation failure). */\n  rawResponse?: string;\n}\n\n/**\n * Shared interface for AI investigation clients.\n *\n * Implemented by the real {@link LLMClient} and by wrappers such as\n * `ReplayableLLMClient` that intercept investigation calls.\n */\nexport interface InvestigationLLMClient extends HydeLLMClient {\n  investigateSeed(\n    systemPrompt: string,\n    userPrompt: string,\n  ): Promise<AIFindingResponse>;\n}\n\n/**\n * Optional extension point for clients that need to know which seed is about\n * to be investigated before `investigateSeed()` is called.\n */\nexport interface SeedAwareInvestigationLLMClient extends InvestigationLLMClient {\n  setSeedContext(seedId: string, seedCategory: string): void;\n  clearSeedContext?(): void;\n}\n\n// ---------------------------------------------------------------------------\n// LLMClient\n// ---------------------------------------------------------------------------\n\n/**\n * Wraps the OpenAI chat completions API for structured K8s investigation.\n *\n * Implements {@link HydeLLMClient} so it can be passed directly to\n * `generateHypotheticalDocument` without any adapter.\n *\n * Instantiate with a loaded {@link AIConfig} (must have `enabled: true` and a\n * valid `apiKey`). If the config is disabled, callers should not construct\n * this class — use the `isAIEnabled` guard from `config.ts` first.\n *\n * Supports both cloud (OpenAI) and local (Ollama, llama.cpp, vLLM, LM Studio)\n * backends via the `llmUrl` config field. Local backends use an OpenAI-\n * compatible API, so the same client works for both.\n */\nexport class LLMClient implements InvestigationLLMClient {\n  private readonly client: OpenAI;\n  private readonly model: string;\n\n  constructor(config: AIConfig) {\n    this.client = new OpenAI({\n      apiKey: config.apiKey,\n      baseURL: config.llmUrl,\n    });\n    this.model = config.model;\n  }\n\n  getModel(): string {\n    return this.model;\n  }\n\n  /**\n   * Generates free-form text given a system and user prompt.\n   *\n   * Unlike `investigateSeed`, this method does NOT use JSON mode — the model\n   * response is returned as a plain string.\n   *\n   * **Does not swallow errors** — throws on network/API failure so that\n   * callers (e.g. `generateHypotheticalDocument`) can detect failure and apply\n   * their own fallback logic.\n   *\n   * @param systemPrompt - System-level context for the generation task.\n   * @param userPrompt   - User-facing prompt.\n   * @returns Generated text string.  Empty string if the model returns no content.\n   */\n  async generateText(systemPrompt: string, userPrompt: string): Promise<string> {\n    const response = await this.client.chat.completions.create({\n      model: this.model,\n      messages: [\n        { role: 'system', content: systemPrompt },\n        { role: 'user', content: userPrompt },\n      ],\n    });\n\n    return response.choices[0]?.message?.content ?? '';\n  }\n\n  /**\n   * Calls the LLM with a system + user prompt pair and returns structured\n   * findings.\n   *\n   * Uses `response_format: { type: 'json_object' }` so the model always\n   * returns a JSON object. The response is parsed and validated through\n   * {@link validateAIFindings} before being returned.\n   *\n   * **Graceful degradation**: any error (network, API, JSON parse, validation)\n   * is caught and logged via `console.warn`. The method always resolves, never\n   * rejects.\n   *\n   * @param systemPrompt - System prompt with grounding rules and playbook.\n   * @param userPrompt   - User prompt with hypothesis, chunks, and schema.\n   * @returns AIFindingResponse — validated findings + optional raw response.\n   */\n  async investigateSeed(\n    systemPrompt: string,\n    userPrompt: string,\n  ): Promise<AIFindingResponse> {\n    let rawResponse: string | undefined;\n\n    try {\n      const response = await this.client.chat.completions.create({\n        model: this.model,\n        response_format: { type: 'json_object' },\n        messages: [\n          { role: 'system', content: systemPrompt },\n          { role: 'user', content: userPrompt },\n        ],\n      });\n\n      rawResponse = response.choices[0]?.message?.content ?? '{}';\n\n      let parsed: unknown;\n      try {\n        parsed = JSON.parse(rawResponse);\n      } catch (parseError) {\n        console.warn(\n          `[LLMClient] Failed to parse JSON response: ${parseError instanceof Error ? parseError.message : String(parseError)}`,\n        );\n        return { findings: [], rawResponse };\n      }\n\n      // Extract the `findings` array from the parsed JSON object\n      const rawFindings =\n        parsed !== null &&\n        typeof parsed === 'object' &&\n        !Array.isArray(parsed) &&\n        'findings' in parsed\n          ? (parsed as Record<string, unknown>)['findings']\n          : [];\n\n      const findings = validateAIFindings(rawFindings);\n\n      return { findings, rawResponse };\n    } catch (error) {\n      console.warn(\n        `[LLMClient] API call failed: ${error instanceof Error ? error.message : String(error)}`,\n      );\n      return { findings: [] };\n    }\n  }\n}\n"}],"isError":false,"timestamp":1774120018740}}
+{"type":"message","id":"e78aed7a","parentId":"ffe626a7","timestamp":"2026-03-21T19:06:58.740Z","message":{"role":"toolResult","toolCallId":"call_Zmk47vUTBkOEDcRgubVSbHDE|fc_0f9932afa4a686050169beec5279a0819bbdf8275fdc54ae1a","toolName":"read","content":[{"type":"text","text":"import type {\n  AIFindingResponse,\n  InvestigationLLMClient,\n  SeedAwareInvestigationLLMClient,\n} from './llm-client.js';\nimport { cassetteSeedKey, type CassetteRecorder, getRecorderMode } from './recorder.js';\n\nexport interface SeedIdentity {\n  seedId: string;\n  seedCategory: string;\n}\n\n/**\n * Wraps an investigation LLM client with cassette record/replay behavior.\n *\n * - live: delegates directly to the inner client\n * - record: delegates, then stores the response keyed by current seed\n * - replay: returns cached responses only and never calls the inner client\n */\nexport class ReplayableLLMClient implements SeedAwareInvestigationLLMClient {\n  private currentSeed: SeedIdentity | undefined;\n\n  constructor(\n    private readonly inner: InvestigationLLMClient,\n    private readonly recorder: CassetteRecorder,\n    private readonly seedResolver: (system: string, user: string) => SeedIdentity,\n  ) {}\n\n  setSeedContext(seedId: string, seedCategory: string): void {\n    this.currentSeed = { seedId, seedCategory };\n  }\n\n  clearSeedContext(): void {\n    this.currentSeed = undefined;\n  }\n\n  async investigateSeed(\n    systemPrompt: string,\n    userPrompt: string,\n  ): Promise<AIFindingResponse> {\n    const seed = this.currentSeed ?? this.seedResolver(systemPrompt, userPrompt);\n\n    if (this.recorder.mode === 'replay') {\n      const cassette = this.recorder.replay(seed.seedId, seed.seedCategory);\n      if (cassette !== undefined) {\n        return {\n          findings: cassette.response.findings,\n          rawResponse: cassette.response.rawResponse,\n        };\n      }\n\n      console.warn(\n        `[ReplayableLLMClient] Missing cassette for ${cassetteSeedKey(seed.seedId, seed.seedCategory)} (${seed.seedId}, ${seed.seedCategory})`,\n      );\n      return { findings: [], rawResponse: undefined };\n    }\n\n    const response = await this.inner.investigateSeed(systemPrompt, userPrompt);\n\n    if (this.recorder.mode === 'record') {\n      this.recorder.record(\n        seed.seedId,\n        seed.seedCategory,\n        { system: systemPrompt, user: userPrompt },\n        { findings: response.findings, rawResponse: response.rawResponse ?? '' },\n        getInnerModel(this.inner),\n      );\n    }\n\n    return response;\n  }\n\n  async generateText(systemPrompt: string, userPrompt: string): Promise<string> {\n    if (this.recorder.mode === 'replay') {\n      return '';\n    }\n    return this.inner.generateText(systemPrompt, userPrompt);\n  }\n}\n\nfunction getInnerModel(client: InvestigationLLMClient): string {\n  const withModel = client as InvestigationLLMClient & { model?: string };\n  if (typeof withModel.model === 'string') {\n    return withModel.model;\n  }\n\n  const candidate = client as InvestigationLLMClient & { getModel?: () => string };\n  if (typeof candidate.getModel === 'function') {\n    return candidate.getModel();\n  }\n\n  return 'unknown';\n}\n\n/**\n * Default seed resolver used as a fallback when no explicit seed context was\n * provided. The AI investigator sets seed context directly, so this path is\n * only a safety net.\n */\nexport function defaultSeedResolver(systemPrompt: string, userPrompt: string): SeedIdentity {\n  const combined = `${systemPrompt}\\n${userPrompt}`;\n  const mode = getRecorderMode();\n  return {\n    seedId: `unresolved:${mode}:${combined.length}`,\n    seedCategory: 'unknown',\n  };\n}\n"}],"isError":false,"timestamp":1774120018740}}
+{"type":"message","id":"1dfd31d5","parentId":"e78aed7a","timestamp":"2026-03-21T19:06:58.741Z","message":{"role":"toolResult","toolCallId":"call_TmmYbunUos43Ob5hgEbvKfR4|fc_0f9932afa4a686050169beec5279b4819b8c0922393016a817","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect, vi, beforeEach } from 'vitest';\n\n// ---------------------------------------------------------------------------\n// Mock OpenAI module\n// ---------------------------------------------------------------------------\n//\n// `mockCreate` is defined at module scope so it can be configured per-test.\n// The vi.mock factory closes over it and returns a constructor that yields\n// an object whose `chat.completions.create` is the same `mockCreate` fn.\n\nconst mockCreate = vi.fn();\n\nvi.mock('openai', () => ({\n  default: vi.fn().mockImplementation(() => ({\n    chat: {\n      completions: {\n        create: mockCreate,\n      },\n    },\n  })),\n}));\n\nimport { LLMClient } from '../llm-client.js';\nimport type { AIConfig } from '../config.js';\n\n// ---------------------------------------------------------------------------\n// Fixtures\n// ---------------------------------------------------------------------------\n\nconst TEST_CONFIG: AIConfig = {\n  provider: 'openai',\n  apiKey: 'sk-test-key',\n  model: 'gpt-4o',\n  embeddingModel: 'text-embedding-3-small',\n  embeddingBackend: 'openai',\n  embeddingUrl: 'http://localhost:8080',\n  llmBackend: 'openai',\n  llmUrl: 'https://api.openai.com/v1',\n  tokenBudget: 100000,\n  enabled: true,\n};\n\nconst VALID_FINDING = {\n  title: 'CrashLoopBackOff: Pod api-server',\n  severity: 'critical',\n  confidence: 0.9,\n  affectedComponents: ['Pod/default/api-server'],\n  reasoningSummary:\n    'The api-server pod is in CrashLoopBackOff with 8 restarts confirmed by BackOff events.',\n  evidence: [\n    {\n      path: 'cluster-resources/pods/default/api-server.json',\n      note: 'Container app is in CrashLoopBackOff state',\n      lineRange: [12, 18],\n    },\n  ],\n  contradictionsChecked: [\n    'Pod confirmed in CrashLoopBackOff — restart count is non-zero',\n  ],\n  recommendedAction:\n    'Inspect container logs with `kubectl logs api-server -n default --previous`.',\n  missingEvidence: [],\n};\n\nfunction makeApiResponse(findings: unknown[]): { choices: { message: { content: string } }[] } {\n  return {\n    choices: [\n      {\n        message: {\n          content: JSON.stringify({ findings }),\n        },\n      },\n    ],\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Test setup\n// ---------------------------------------------------------------------------\n\nbeforeEach(() => {\n  mockCreate.mockReset();\n});\n\n// ---------------------------------------------------------------------------\n// Construction\n// ---------------------------------------------------------------------------\n\ndescribe('LLMClient — construction', () => {\n  it('can be instantiated with a valid AIConfig', () => {\n    expect(() => new LLMClient(TEST_CONFIG)).not.toThrow();\n  });\n});\n\n// ---------------------------------------------------------------------------\n// investigateSeed — happy path\n// ---------------------------------------------------------------------------\n\ndescribe('LLMClient.investigateSeed — happy path', () => {\n  it('returns validated findings from a well-formed API response', async () => {\n    mockCreate.mockResolvedValueOnce(makeApiResponse([VALID_FINDING]));\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(1);\n    expect(result.findings[0]!.title).toBe('CrashLoopBackOff: Pod api-server');\n    expect(result.findings[0]!.severity).toBe('critical');\n    expect(result.findings[0]!.confidence).toBe(0.9);\n  });\n\n  it('preserves evidence path and note in the returned finding', async () => {\n    mockCreate.mockResolvedValueOnce(makeApiResponse([VALID_FINDING]));\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings[0]!.evidence[0]!.path).toBe(\n      'cluster-resources/pods/default/api-server.json',\n    );\n    expect(result.findings[0]!.evidence[0]!.note).toBe(\n      'Container app is in CrashLoopBackOff state',\n    );\n    expect(result.findings[0]!.evidence[0]!.lineRange).toEqual([12, 18]);\n  });\n\n  it('preserves rawResponse in result', async () => {\n    const rawContent = JSON.stringify({ findings: [VALID_FINDING] });\n    mockCreate.mockResolvedValueOnce({\n      choices: [{ message: { content: rawContent } }],\n    });\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.rawResponse).toBe(rawContent);\n  });\n\n  it('returns multiple findings when API returns multiple', async () => {\n    const second = { ...VALID_FINDING, title: 'Second Finding', severity: 'high' };\n    mockCreate.mockResolvedValueOnce(makeApiResponse([VALID_FINDING, second]));\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(2);\n  });\n\n  it('clamps confidence above 1 to 1.0', async () => {\n    mockCreate.mockResolvedValueOnce(\n      makeApiResponse([{ ...VALID_FINDING, confidence: 1.5 }]),\n    );\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings[0]!.confidence).toBe(1.0);\n  });\n\n  it('clamps confidence below 0 to 0.0', async () => {\n    mockCreate.mockResolvedValueOnce(\n      makeApiResponse([{ ...VALID_FINDING, confidence: -0.2 }]),\n    );\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings[0]!.confidence).toBe(0.0);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// investigateSeed — empty and edge-case responses\n// ---------------------------------------------------------------------------\n\ndescribe('LLMClient.investigateSeed — empty responses', () => {\n  it('returns empty findings for empty findings array', async () => {\n    mockCreate.mockResolvedValueOnce(makeApiResponse([]));\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(0);\n  });\n\n  it('returns empty findings when API returns empty object', async () => {\n    mockCreate.mockResolvedValueOnce({\n      choices: [{ message: { content: '{}' } }],\n    });\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(0);\n  });\n\n  it('returns empty findings when choices array is empty', async () => {\n    mockCreate.mockResolvedValueOnce({ choices: [] });\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(0);\n  });\n\n  it('returns empty findings when message content is absent', async () => {\n    mockCreate.mockResolvedValueOnce({\n      choices: [{ message: {} }],\n    });\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(0);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// investigateSeed — graceful degradation\n// ---------------------------------------------------------------------------\n\ndescribe('LLMClient.investigateSeed — graceful degradation', () => {\n  it('returns empty findings on API error without throwing', async () => {\n    mockCreate.mockRejectedValueOnce(new Error('OpenAI API error: 401 Unauthorized'));\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(0);\n  });\n\n  it('returns empty findings on network timeout without throwing', async () => {\n    mockCreate.mockRejectedValueOnce(new Error('Request timeout'));\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(0);\n  });\n\n  it('returns empty findings on rate-limit error without throwing', async () => {\n    mockCreate.mockRejectedValueOnce(new Error('Rate limit exceeded'));\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(0);\n  });\n\n  it('returns empty findings when API returns malformed JSON', async () => {\n    mockCreate.mockResolvedValueOnce({\n      choices: [{ message: { content: 'not valid json {{{' } }],\n    });\n\n    const client = new LLMClient(TEST_CONFIG);\n    const result = await client.investigateSeed('system', 'user');\n\n    expect(result.findings).toHaveLength(0);\n    expect(result.rawResponse).toBe('not valid json {{{');\n  });\n\n[93 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1774120018741}}
+{"type":"message","id":"0357e5f7","parentId":"1dfd31d5","timestamp":"2026-03-21T19:06:58.741Z","message":{"role":"toolResult","toolCallId":"call_vFAUdITVo94q74goQmV1DHCO|fc_0f9932afa4a686050169beec5279c0819b958ac2574cfef5f7","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// AI Investigator\n// ---------------------------------------------------------------------------\n//\n// Implements an AI-powered investigation flow that augments the heuristic\n// pipeline with graph traversal and lexical retrieval.\n//\n// Design principles:\n// - Graph-first: `getRelatedChunks` provides the deterministic precision floor.\n// - Lexical expansion: `LexicalSearchIndex.search` adds supplementary evidence.\n// - Grounded findings: every AI finding must cite evidence from provided chunks.\n// - Graceful degradation: LLM errors are caught and logged; the pipeline\n//   continues with remaining seeds rather than aborting.\n// - Category-specific playbooks: each seed's category routes to the right\n//   investigation playbook via `buildInvestigationPrompt`.\n\nimport type { Finding, Evidence, GraphEdge } from '../types/index.js';\nimport type { InvestigatorContext, InvestigatorResult, InvestigationSeed } from './types.js';\nimport type {\n  InvestigationLLMClient,\n  SeedAwareInvestigationLLMClient,\n} from '../ai/llm-client.js';\nimport type { IndexedChunk } from '../ai/chunk-indexer.js';\nimport type { ResourceRelationshipGraph } from '../graph/resource-graph.js';\nimport type { LexicalSearchIndex } from '../ai/lexical-search.js';\nimport type { AIFinding, AIFindingEvidence } from '../ai/schemas.js';\nimport type { EmbeddingClientInterface } from '../ai/embeddings.js';\nimport type { VectorStore } from '../ai/vector-store.js';\nimport type { DiagnosticGraph } from '../graph/diagnostic-graph.js';\nimport { validateAIFindings } from '../ai/schemas.js';\nimport { getRelatedChunks } from '../graph/resource-graph.js';\nimport type { GraphScoredChunk } from '../graph/resource-graph.js';\nimport { traverseForChunks, RETRIEVAL_EDGE_TYPES, isDiagnosticGraph } from '../graph/traversal.js';\nimport { buildInvestigationPrompt } from '../ai/prompts.js';\nimport { estimateTokens } from '../ai/chunk-indexer.js';\nimport { generateHypotheticalDocument } from '../ai/hyde.js';\nimport { applyFindingProvenance } from './finding-provenance.js';\n\n// ---------------------------------------------------------------------------\n// Constants\n// ---------------------------------------------------------------------------\n\n/** Maximum number of seeds to investigate per AI invocation (configurable). */\nexport const DEFAULT_MAX_SEEDS = 10;\n\n/**\n * Maximum number of chunks sent to the LLM per seed call.\n *\n * Graph hits are included first (highest precision), then lexical hits fill\n * the remaining slots. Capped to keep the context window manageable.\n */\nconst MAX_CHUNKS_PER_SEED = 20;\n\n/** Number of lexical search results to retrieve per seed. */\nconst LEXICAL_TOP_K = 10;\n\n// ---------------------------------------------------------------------------\n// Seed-specific graph traversal parameters\n// ---------------------------------------------------------------------------\n\n/**\n * Hard cap on the number of graph nodes returned from traversal, regardless\n * of depth. Prevents breadth explosion in large, well-connected graphs.\n *\n * 30 nodes covers:\n * - 1 starting pod\n * - 5-8 direct deps (secrets, configmaps, events, deployment)\n * - 10-15 depth-2 nodes (sibling pods, remote services)\n * - 5-10 depth-3/4 nodes (remote pod deps)\n */\nexport const MAX_GRAPH_NODES = 30;\n\n/**\n * Minimum edge weight for graph traversal. Edges below this threshold are\n * not followed. Prunes near-zero temporal-correlation edges (those at the\n * extreme end of the 60-second window) while preserving all structural edges\n * (which default to weight 1.0).\n *\n * At 0.1, a temporal-correlation edge is pruned only when the time delta\n * exceeds ~54 seconds (weight = 1 - 54/60 = 0.1). Everything closer passes.\n */\nexport const GRAPH_MIN_WEIGHT = 0.1;\n\n/**\n * Returns the optimal graph traversal depth for a seed based on its category.\n *\n * Depth is tuned per category based on the typical K8s graph path length\n * from the seed's starting node to the evidence that explains the failure:\n *\n * | Category | Depth | Reasoning |\n * |---|---|---|\n * | kubernetes | 3 | Pod → deps(1) → Deployment/sibling-pods(2) → sibling-events(3) |\n * | connectivity | 4 | Pod → ConfigMap(1) → remote-Service(2) → remote-Pod(3) → remote-deps(4) |\n * | configuration | 2 | Pod → Secret/ConfigMap(1) → ExternalSecret(2). Direct refs only. |\n * | log | 2 | Pod → deps(1) → owner(2). BM25 handles log-to-evidence correlation. |\n *\n * Returns 3 as a safe default for any unrecognised category.\n */\nexport function maxDepthForSeed(seed: InvestigationSeed): number {\n  switch (seed.category) {\n    case 'kubernetes':     return 3;\n    case 'connectivity':   return 4;\n    case 'configuration':  return 2;\n    case 'log':            return 2;\n    default:               return 3;\n  }\n}\n\n/**\n * Number of semantic (vector) search results to retrieve per seed.\n *\n * Semantic hits are appended at lower priority than graph/lexical hits and are\n * capped separately to limit noise contribution to the merged context.\n */\nconst SEMANTIC_TOP_K = 5;\n\n/**\n * Default token budget for merged context sent to the LLM per seed call.\n *\n * Set to ~80 % of a 128 k-token context window (128 × 1 024 × 0.8 ≈ 104 k).\n * Lower-priority chunks (those ranked later by RRF) fall back to their\n * {@link IndexedChunk.summary} content once the cumulative estimated token\n * count would exceed this limit.\n *\n * Exported so callers can override the budget for testing or for models with\n * different context window sizes.\n */\nexport const DEFAULT_TOKEN_BUDGET = 100_000;\n\n// ---------------------------------------------------------------------------\n// AIInvestigatorDeps\n// ---------------------------------------------------------------------------\n\n/**\n * External dependencies required by the AI investigator.\n *\n * The four required deps (llmClient, chunkIndex, resourceGraph, lexicalIndex)\n * form the deterministic precision floor. The two optional deps\n * (embeddingClient, vectorStore) add semantic expansion — if absent,\n * investigation proceeds with graph + lexical results only.\n */\nexport interface AIInvestigatorDeps {\n  /** LLM client for structured investigation calls. */\n  llmClient: InvestigationLLMClient;\n  /** Pre-built flat chunk index from `buildChunkIndex`. */\n  chunkIndex: IndexedChunk[];\n  /** Pre-built K8s resource relationship graph (backward-compat adapter). */\n  resourceGraph: ResourceRelationshipGraph;\n  /**\n   * Unified DiagnosticGraph with label-selector, service-selector, temporal,\n   * and causal edges. When present, graph retrieval uses the richer\n   * `traverseForChunks` instead of the legacy `getRelatedChunks` BFS.\n   */\n  diagnosticGraph?: DiagnosticGraph;\n  /** Pre-built lexical inverted index from `LexicalSearchIndex.build`. */\n  lexicalIndex: LexicalSearchIndex;\n  /**\n   * Optional embedding client for semantic query expansion.\n   *\n   * When present, the seed hypothesis is embedded and the resulting vector is\n   * used to retrieve semantically similar chunks from `vectorStore`. Semantic\n   * hits are appended at lower priority than graph and lexical hits.\n   *\n   * If absent (or if embedding fails), investigation continues without semantic\n   * expansion.\n   */\n  embeddingClient?: EmbeddingClientInterface;\n  /**\n   * Optional pre-built vector store populated with chunk embeddings.\n   *\n   * Only consulted when `embeddingClient` is also present. If absent, semantic\n   * retrieval is skipped.\n   */\n  vectorStore?: VectorStore;\n  /**\n   * Maximum tokens of chunk context sent to the LLM per seed investigation.\n   *\n   * Defaults to {@link DEFAULT_TOKEN_BUDGET} (~100K). Reduce for local models\n   * with smaller context windows (e.g. 20,000 for 32K context models).\n   */\n  tokenBudget?: number;\n  /**\n   * When `true`, log per-seed retrieval statistics to stdout.\n   *\n   * Output format:\n   * `[AIInvestigator] Seed: {hypothesis} → {N} graph, {M} lexical, {K} semantic chunks across {T} artifact types`\n   */\n  verbose?: boolean;\n  /**\n   * Optional callback invoked before each seed investigation begins.\n   * Used by the TUI to show per-seed progress during the AI phase.\n   */\n  onSeedProgress?: (\n    seedIndex: number,\n    seedTotal: number,\n    seedLabel: string,\n  ) => void;\n}\n\n// ---------------------------------------------------------------------------\n// Shared counter type\n// ---------------------------------------------------------------------------\n\ninterface Counter {\n  value: number;\n}\n\n// ---------------------------------------------------------------------------\n// DiagnosticGraph seed → node ID resolution\n// ---------------------------------------------------------------------------\n\n/**\n * Resolves a seed to one or more starting node IDs in the DiagnosticGraph.\n *\n * Strategy:\n * 1. Parse `Pod/<ns>/<name>` components from the seed source (from seed.id or\n *    hypothesis text) to get concrete K8s node IDs.\n * 2. Fall back to identifier extraction from the hypothesis text: look for\n *    known resource names that appear as graph nodes.\n * 3. If nothing matches, return an empty array (caller falls back to BFS path).\n *\n * Node ID format in DiagnosticGraph: `{Kind}:{namespace}/{name}`\n */\nfunction resolveSeedStartNodes(\n  seed: InvestigationSeed,\n  graph: DiagnosticGraph,\n): string[] {\n  const nodeIds: string[] = [];\n\n  // Extract Pod/namespace/name patterns from the seed source or hypothesis\n  const combinedText = `${seed.source} ${seed.hypothesis}`;\n\n  // Pattern: Pod/<namespace>/<name> from seed.source (set by seed generator)\n  const podPattern = /Pod\\/([^/\\s]+)\\/([^/\\s,]+)/g;\n  let match: RegExpExecArray | null;\n  while ((match = podPattern.exec(combinedText)) !== null) {\n    const ns = match[1]!;\n    const name = match[2]!;\n    const nodeId = `Pod:${ns}/${name}`;\n    if (graph.getNode(nodeId) && !nodeIds.includes(nodeId)) nodeIds.push(nodeId);\n\n[775 more lines in file. Use offset=241 to continue.]"}],"isError":false,"timestamp":1774120018741}}
+{"type":"message","id":"f2b8552e","parentId":"0357e5f7","timestamp":"2026-03-21T19:06:58.741Z","message":{"role":"toolResult","toolCallId":"call_UwGPcSdOk4SUUNYHYvUIyKDv|fc_0f9932afa4a686050169beec5279c8819bb9ec567d0f560a69","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n\n/**\n * What a targeted investigator produces after examining its seeds.\n *\n * - `findings` — evidence-backed diagnosis entries\n * - `edges`    — new graph relationships discovered during investigation\n */\nexport interface InvestigatorResult {\n  findings: Finding[];\n  edges: GraphEdge[];\n  metadata?: {\n    retrievalStats?: {\n      graphChunks: number;\n      lexicalChunks: number;\n      semanticChunks: number;\n      mergedChunks: number;\n    };\n  };\n}\n"}],"isError":false,"timestamp":1774120018741}}
+{"type":"message","id":"4ae52b40","parentId":"f2b8552e","timestamp":"2026-03-21T19:06:58.741Z","message":{"role":"toolResult","toolCallId":"call_F4tMRW61I0DWxcd8fo4Rfkti|fc_0f9932afa4a686050169beec5279cc819b8b08e02cb7a08658","toolName":"read","content":[{"type":"text","text":"import type { BundleProfile } from '../types/index.js';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport interface RetrievalStats {\n  graphChunks: number;\n  lexicalChunks: number;\n  semanticChunks: number;\n  mergedChunks: number;\n}\n\nexport interface ConfidenceStats {\n  min: number;\n  max: number;\n  mean: number;\n  median: number;\n}\n\nexport interface HypothesisStats {\n  generated: number;\n  verified: number;\n  converted: number;\n}\n\nexport interface TraceStep {\n  name: string;\n  startedAt: string;\n  completedAt?: string;\n  artifactsProcessed: number;\n  errors?: string[];\n  seedCount?: number;\n  seedCategories?: Record<string, number>;\n  retrievalStats?: RetrievalStats;\n  confidenceStats?: ConfidenceStats;\n  hypothesisStats?: HypothesisStats;\n}\n\nexport interface InvestigationTrace {\n  bundlePath: string;\n  startedAt: string;\n  completedAt?: string;\n  steps: TraceStep[];\n  profile?: BundleProfile;\n  metadata?: Record<string, unknown>;\n}\n\n// ---------------------------------------------------------------------------\n// Factory\n// ---------------------------------------------------------------------------\n\n/**\n * Creates a new investigation trace for the given bundle path.\n */\nexport function createTrace(bundlePath: string): InvestigationTrace {\n  return {\n    bundlePath,\n    startedAt: new Date().toISOString(),\n    steps: [],\n  };\n}\n\n/**\n * Records the start of a new pipeline step and returns its index.\n *\n * The returned index should be passed to {@link completeTraceStep} when the\n * step finishes.\n */\nexport function startTraceStep(trace: InvestigationTrace, name: string): number {\n  const step: TraceStep = {\n    name,\n    startedAt: new Date().toISOString(),\n    artifactsProcessed: 0,\n  };\n  trace.steps.push(step);\n  return trace.steps.length - 1;\n}\n\n/**\n * Marks a trace step as completed, recording the finish time, artifact count\n * and any errors encountered.\n */\nexport function completeTraceStep(\n  trace: InvestigationTrace,\n  stepIndex: number,\n  artifactsProcessed: number,\n  errors?: string[],\n): void {\n  const step = trace.steps[stepIndex];\n  if (!step) return;\n\n  step.completedAt = new Date().toISOString();\n  step.artifactsProcessed = artifactsProcessed;\n  if (errors && errors.length > 0) {\n    step.errors = errors;\n  }\n}\n\n/**\n * Marks the entire trace as completed.\n */\nexport function completeTrace(\n  trace: InvestigationTrace,\n  profile?: BundleProfile,\n  metadata?: Record<string, unknown>,\n): void {\n  trace.completedAt = new Date().toISOString();\n  if (profile) {\n    trace.profile = profile;\n  }\n  if (metadata && Object.keys(metadata).length > 0) {\n    trace.metadata = metadata;\n  }\n}\n"}],"isError":false,"timestamp":1774120018741}}
