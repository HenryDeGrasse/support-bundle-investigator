+{"type":"message","id":"b0c4e939","parentId":"4e68ef18","timestamp":"2026-03-21T20:06:22.978Z","message":{"role":"toolResult","toolCallId":"call_d3TFEUEkq1ut4a0F17NYVhRm|fc_0f9932afa4a686050169befa3ed3d0819bb08aabf2dd2405b3","toolName":"read","content":[{"type":"text","text":"{\n  \"name\": \"support-bundle-investigator\",\n  \"version\": \"0.1.0\",\n  \"description\": \"CLI-first, local-first tool that takes a Troubleshoot support bundle .tar.gz and produces evidence-backed diagnosis\",\n  \"main\": \"dist/index.js\",\n  \"module\": \"dist/index.mjs\",\n  \"types\": \"dist/index.d.ts\",\n  \"bin\": {\n    \"sbi\": \"dist/cli/run.mjs\",\n    \"rat\": \"dist/cli/rat.mjs\"\n  },\n  \"scripts\": {\n    \"lint\": \"eslint \\\"src/**/*.ts\\\" \\\"src/**/*.tsx\\\" \\\"test/**/*.ts\\\" --max-warnings 0\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"test\": \"vitest run\",\n    \"unit\": \"vitest run\",\n    \"build\": \"tsup\",\n    \"benchmark:hypotheses\": \"node scripts/benchmark-hypotheses.mjs\",\n    \"rat\": \"npm run build && node dist/cli/rat.mjs\"\n  },\n  \"devDependencies\": {\n    \"@types/js-yaml\": \"^4.0.9\",\n    \"@types/node\": \"^25.5.0\",\n    \"@types/react\": \"^19.2.14\",\n    \"@types/tar\": \"^6.1.13\",\n    \"@typescript-eslint/eslint-plugin\": \"^7.0.0\",\n    \"@typescript-eslint/parser\": \"^7.0.0\",\n    \"eslint\": \"^8.57.0\",\n    \"tsup\": \"^8.0.0\",\n    \"typescript\": \"^5.4.0\",\n    \"vitest\": \"^2.0.0\"\n  },\n  \"dependencies\": {\n    \"commander\": \"^12.0.0\",\n    \"glob\": \"^11.0.0\",\n    \"ink\": \"^6.8.0\",\n    \"ink-spinner\": \"^5.0.0\",\n    \"js-yaml\": \"^4.1.0\",\n    \"openai\": \"^6.31.0\",\n    \"react\": \"^19.2.4\",\n    \"tar\": \"^7.0.0\"\n  }\n}\n"}],"isError":false,"timestamp":1774123582977}}
+{"type":"message","id":"e5b801d4","parentId":"b0c4e939","timestamp":"2026-03-21T20:06:22.978Z","message":{"role":"toolResult","toolCallId":"call_kX1vpAk2c0qseVPjQN9sg33r|fc_0f9932afa4a686050169befa3ed3e0819b86e84c0b785e8937","toolName":"read","content":[{"type":"text","text":"import * as fs from \"fs/promises\";\nimport * as path from \"path\";\nimport * as tar from \"tar\";\n\n/**\n * Returns the absolute path to the fixture directory for a given scenario name.\n */\nexport function getFixturePath(scenario: string): string {\n  return path.resolve(__dirname, \"../fixtures/scenarios\", scenario);\n}\n\n/**\n * Packs a scenario directory into a .tar.gz bundle archive.\n *\n * @param scenarioDir - Absolute or relative path to the directory to pack.\n * @param outputPath  - Absolute or relative path for the output .tar.gz file.\n * @returns The resolved output path.\n */\nexport async function createTestBundle(\n  scenarioDir: string,\n  outputPath: string\n): Promise<string> {\n  const absoluteScenarioDir = path.resolve(scenarioDir);\n  const absoluteOutputPath = path.resolve(outputPath);\n\n  const scenarioStats = await fs.stat(absoluteScenarioDir).catch(() => null);\n  if (!scenarioStats?.isDirectory()) {\n    throw new Error(`Scenario directory does not exist: ${absoluteScenarioDir}`);\n  }\n\n  await fs.mkdir(path.dirname(absoluteOutputPath), { recursive: true });\n\n  // Collect entries relative to the parent of scenarioDir so that the\n  // archive contains the scenario folder itself at its root.\n  const parentDir = path.dirname(absoluteScenarioDir);\n  const scenarioName = path.basename(absoluteScenarioDir);\n\n  await tar.c(\n    {\n      gzip: true,\n      file: absoluteOutputPath,\n      cwd: parentDir,\n    },\n    [scenarioName]\n  );\n\n  return absoluteOutputPath;\n}\n"}],"isError":false,"timestamp":1774123582978}}
+{"type":"message","id":"3ebb20da","parentId":"e5b801d4","timestamp":"2026-03-21T20:06:22.978Z","message":{"role":"toolResult","toolCallId":"call_iFChVjbO99ztxNRWwG2X98CE|fc_0f9932afa4a686050169befa3ed3e8819b98ab6953af8385b7","toolName":"read","content":[{"type":"text","text":"import type { EvalReport, ScenarioEvalResult } from './evaluate.js';\n\nfunction escapeMarkdownCell(value: string): string {\n  return value\n    .replace(/\\|/g, '\\\\|')\n    .replace(/\\r?\\n|\\r/g, ' ')\n    .trim();\n}\n\nfunction formatPass(pass: boolean): string {\n  return pass ? 'PASS' : 'FAIL';\n}\n\nfunction formatPercent(value: number): string {\n  return `${(value * 100).toFixed(1)}%`;\n}\n\nfunction formatConfidence(value: number): string {\n  return value > 0 ? `${value.toFixed(2)}` : 'n/a';\n}\n\nfunction formatMode(mode: ScenarioEvalResult['mode']): string {\n  return mode === 'ai' ? 'AI' : 'Heuristic';\n}\n\nfunction buildSummary(report: EvalReport) {\n  const scenarioEntries = Object.entries(report.scenarios)\n    .sort(([left], [right]) => left.localeCompare(right))\n    .map(([scenario, result]) => ({\n      scenario,\n      displayName: result.displayName,\n      pass: result.pass,\n      score: result.score,\n      topFinding: result.topFinding,\n      expectedPattern: result.expectedPattern,\n      confidence: result.confidence,\n      evidenceCount: result.evidenceCount,\n      mode: result.mode,\n      checksPassed: result.checks.filter((check) => check.pass).length,\n      checksTotal: result.checks.length,\n    }));\n\n  return {\n    timestamp: report.timestamp,\n    overallPass: report.overallPass,\n    overallScore: report.overallScore,\n    scenarioCount: scenarioEntries.length,\n    passedScenarioCount: scenarioEntries.filter((entry) => entry.pass).length,\n    failedScenarioCount: scenarioEntries.filter((entry) => !entry.pass).length,\n    scenarios: scenarioEntries,\n  };\n}\n\nexport function generateScorecard(report: EvalReport): string {\n  const summary = buildSummary(report);\n  const lines: string[] = [\n    '# Golden Eval Scorecard',\n    '',\n    `Generated: ${summary.timestamp}`,\n    '',\n    `Overall Pass: ${summary.overallPass ? 'YES' : 'NO'}`,\n    `Overall Score: ${formatPercent(summary.overallScore)}`,\n    `Scenario Count: ${summary.scenarioCount}`,\n    '',\n    '| Scenario | Pass/Fail | Score% | Top Finding | Expected Pattern | Confidence | Evidence Count | Heuristic/AI |',\n    '| --- | --- | ---: | --- | --- | ---: | ---: | --- |',\n  ];\n\n  for (const entry of summary.scenarios) {\n    lines.push(\n      `| ${escapeMarkdownCell(entry.scenario)} | ${formatPass(entry.pass)} | ${formatPercent(entry.score)} | ${escapeMarkdownCell(entry.topFinding)} | ${escapeMarkdownCell(entry.expectedPattern)} | ${formatConfidence(entry.confidence)} | ${entry.evidenceCount} | ${formatMode(entry.mode)} |`,\n    );\n  }\n\n  lines.push('', '## JSON Summary', '', '```json', JSON.stringify(summary, null, 2), '```');\n\n  return lines.join('\\n');\n}\n"}],"isError":false,"timestamp":1774123582978}}
+{"type":"message","id":"ad021490","parentId":"3ebb20da","timestamp":"2026-03-21T20:06:22.978Z","message":{"role":"toolResult","toolCallId":"call_nESacQwseOy0meqReH3oGen1|fc_0f9932afa4a686050169befa3ed3f0819ba2cb832256f415e6","toolName":"read","content":[{"type":"text","text":"import { parseArgs, CommanderError } from './cli.js';\nimport { analyzeBundlePipeline, cleanupPipelineResult } from '../pipeline/analyze.js';\nimport { writePipelineResult, writeTraceFile, writeProvenanceFile } from './output.js';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport interface RunCliOptions {\n  /**\n   * Lazy loader for the TUI module.  Provided only by the CLI binary entry\n   * point (`src/cli/run.ts`) where the relative import path to `dist/tui/`\n   * is stable.  Omitted when `runCli` is called from the library entry\n   * (`src/index.ts`) or from tests.\n   */\n  loadTUI?: () => Promise<{\n    renderTUI: (bundlePath: string, options: Record<string, unknown>) => Promise<void>;\n  }>;\n}\n\nfunction formatDebugValue(value: string | number | undefined): string {\n  if (value === undefined) {\n    return '-';\n  }\n\n  const rendered = typeof value === 'number' ? value.toFixed(2) : value;\n  return rendered.length > 36 ? `${rendered.slice(0, 33)}...` : rendered;\n}\n\nfunction emitDebugFindingSummary(\n  findings: Awaited<ReturnType<typeof analyzeBundlePipeline>>['findings'],\n): void {\n  console.error('');\n  console.error('Debug finding provenance summary');\n  console.error('Finding ID                      | Investigator   | Seed                                 | Δconf | Merge history');\n  console.error('------------------------------- | -------------- | ------------------------------------ | ----- | -------------');\n\n  if (findings.length === 0) {\n    console.error('(no findings)');\n    return;\n  }\n\n  for (const finding of findings) {\n    const provenance = finding.provenance;\n    console.error(\n      [\n        formatDebugValue(finding.id).padEnd(31),\n        formatDebugValue(provenance?.investigator).padEnd(14),\n        formatDebugValue(provenance?.seedId).padEnd(36),\n        formatDebugValue(provenance?.confidenceDelta).padEnd(5),\n        formatDebugValue(provenance?.mergedFrom?.join(', ')),\n      ].join(' | '),\n    );\n  }\n}\n\n// ---------------------------------------------------------------------------\n// runCli\n// ---------------------------------------------------------------------------\n\n/**\n * Runs the SBI CLI for the provided argv vector and returns the intended exit\n * code instead of terminating the process directly.\n *\n * @param argv    - Raw argument vector (defaults to `process.argv`).\n * @param options - Optional dependency-injection options (e.g. TUI loader).\n */\nexport async function runCli(\n  argv: string[] = process.argv,\n  options: RunCliOptions = {},\n): Promise<number> {\n  let args;\n  let result: Awaited<ReturnType<typeof analyzeBundlePipeline>> | undefined;\n\n  try {\n    args = parseArgs(argv);\n  } catch (err) {\n    if (err instanceof CommanderError) {\n      // exitCode 0 = --help / --version (output already printed by Commander)\n      return err.exitCode;\n    }\n\n    console.error((err as Error).message);\n    return 1;\n  }\n\n  // ── TUI mode ─────────────────────────────────────────────────────────────\n  if (args.tui) {\n    if (!options.loadTUI) {\n      console.error('Error: --tui is only supported when running via the sbi CLI binary.');\n      return 1;\n    }\n\n    try {\n      const { renderTUI } = await options.loadTUI();\n      await renderTUI(args.bundlePath, {\n        outputDir: args.outputDir,\n        verbose: args.verbose,\n        noAi: args.noAi,\n        trace: args.trace,\n        debug: args.debug,\n      });\n      return 0;\n    } catch (err) {\n      console.error('Error:', (err as Error).message);\n      return 1;\n    }\n  }\n\n  // ── Standard pipeline mode ────────────────────────────────────────────────\n  try {\n    const verbose = args.verbose || args.debug;\n    const trace = args.trace || args.debug;\n\n    result = await analyzeBundlePipeline(args.bundlePath, {\n      outputDir: args.outputDir,\n      verbose,\n      trace,\n      debug: args.debug,\n      noAi: args.noAi,\n    });\n\n    await writePipelineResult(result, {\n      format: args.format,\n      outputDir: args.outputDir,\n      verbose,\n      debug: args.debug,\n    });\n\n    if (trace && args.outputDir) {\n      await writeTraceFile(result.trace, args.outputDir);\n    }\n\n    if (args.debug && args.outputDir) {\n      await writeProvenanceFile(result.findings, args.outputDir);\n    }\n\n    if (args.debug) {\n      emitDebugFindingSummary(result.findings);\n    }\n\n    return 0;\n  } catch (err) {\n    console.error('Error:', (err as Error).message);\n    return 1;\n  } finally {\n    if (result) {\n      await cleanupPipelineResult(result);\n    }\n  }\n}\n"}],"isError":false,"timestamp":1774123582978}}
