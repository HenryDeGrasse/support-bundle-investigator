e(f.absolutePath)));\\n  const helmFiles = profile.manifest.files.filter((f) => f.category === 'helm-release');\\n  const helmBatches = await Promise.all(helmFiles.map((f) => parseHelmReleaseFile(f.absolutePath)));\\n  const helmReleases = helmBatches.flat();\\n\\n  const resourceSourceFiles = new Map();\\n  for (let i = 0; i < resourceFiles.length; i++) {\\n    const file = resourceFiles[i]!;\\n    const batch = resourceBatches[i] ?? [];\\n    for (const resource of batch) resourceSourceFiles.set(resource, file.relativePath);\\n  }\\n\\n  const seeds = generateSeeds({\\n    analyzerResults,\\n    resources,\\n    events,\\n    logs,\\n    profile,\\n    resourceSourceFiles,\\n    helmReleases,\\n  });\\n\\n  fs.rmSync(tmpDir, { recursive: true, force: true });\\n  return seeds;\\n}\\n\\ndescribe('scratch cassette seeds', () => {\\n  it('prints seeds for bad-image-tag and missing-secret-crashloop', async () => {\\n    for (const scenario of ['bad-image-tag', 'missing-secret-crashloop']) {\\n      const seeds = await loadSeeds(scenario);\\n      console.log(`SCENARIO=${scenario}`);\\n      console.log(JSON.stringify(seeds, null, 2));\\n    }\\n  });\\n});\\n\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":581,"output":1235,"cacheRead":175360,"cacheWrite":0,"totalTokens":177176,"cost":{"input":0.0014525,"output":0.018525,"cacheRead":0.04384,"cacheWrite":0,"total":0.0638175}},"stopReason":"toolUse","timestamp":1774117236713,"responseId":"resp_0f9932afa4a686050169bee1751bcc819b9057df912554b7e5"}}
