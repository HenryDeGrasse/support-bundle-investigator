+{"type":"message","id":"d7a68f18","parentId":"ee92e535","timestamp":"2026-03-21T18:20:27.479Z","message":{"role":"toolResult","toolCallId":"call_RDyqqV1gTTJ7nQ5y2mAtDUoQ|fc_0f9932afa4a686050169bee16b4b98819b97419463a5051435","toolName":"read","content":[{"type":"text","text":"import type { InvestigationSeed, InvestigatorContext, SeedCategory } from './types.js';\nimport { extractPodStatus, getContainerErrors } from '../parsers/index.js';\nimport type { AnalyzerResult, K8sEvent, K8sResource } from '../types/index.js';\nimport type { LogFile } from '../parsers/index.js';\n\n// ---------------------------------------------------------------------------\n// Internal type guard\n// ---------------------------------------------------------------------------\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === 'object' && value !== null && !Array.isArray(value);\n}\n\n// ---------------------------------------------------------------------------\n// Priority constants  (0–100 range; higher = more urgent)\n// ---------------------------------------------------------------------------\n\n/** Pod is looping on crash — highest urgency */\nconst PRIORITY_CRASHLOOP = 90;\n/** Pod is stuck on image pull — highest urgency */\nconst PRIORITY_IMAGE_PULL = 90;\n/** Analyzer reported an error-severity finding */\nconst PRIORITY_ERROR_ANALYZER = 80;\n/** Node is NotReady — affects all pod scheduling on that node */\nconst PRIORITY_NODE_NOT_READY = 85;\n/** Analyzer reported a warn-severity finding */\nconst PRIORITY_WARN_ANALYZER = 60;\n/** Node has a pressure condition (MemoryPressure, DiskPressure, PIDPressure) */\nconst PRIORITY_NODE_PRESSURE = 70;\n/** Node taint may block pod scheduling */\nconst PRIORITY_NODE_TAINT = 75;\n/** Pod is not ready but not crashing or pulling */\nconst PRIORITY_POD_NOT_READY = 50;\n/** Base priority for a high-importance log file seed */\nconst PRIORITY_HIGH_LOG_BASE = 45;\n/** Warning Kubernetes event */\nconst PRIORITY_WARNING_EVENT = 30;\n\n/** Minimum log importance score [0, 1] required to produce a log seed */\nconst LOG_IMPORTANCE_THRESHOLD = 0.3;\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Infers the {@link SeedCategory} from an analyzer result by matching\n * keywords in the name, title, and message.\n */\nfunction categoryFromAnalyzer(result: AnalyzerResult): SeedCategory {\n  const text = `${result.name} ${result.title} ${result.message}`.toLowerCase();\n\n  if (/database|endpoint|connectivity|connection|dns|no such host|tcp|network|unreachable/.test(text)) {\n    return 'connectivity';\n  }\n  if (/secret|credential|config|env|envfrom|mount|volume|missing/.test(text)) {\n    return 'configuration';\n  }\n  return 'kubernetes';\n}\n\n// ---------------------------------------------------------------------------\n// Source 1: Analyzer results with error / warn severity\n// ---------------------------------------------------------------------------\n\nfunction seedsFromAnalyzers(\n  analyzerResults: AnalyzerResult[],\n  makeId: (prefix: string) => string,\n): InvestigationSeed[] {\n  return analyzerResults\n    .filter((r) => r.severity === 'error' || r.severity === 'warn')\n    .map((r) => ({\n      id: makeId('analyzer'),\n      hypothesis: r.title || r.message || r.name,\n      source: `analyzer:${r.name}`,\n      category: categoryFromAnalyzer(r),\n      priority: r.severity === 'error' ? PRIORITY_ERROR_ANALYZER : PRIORITY_WARN_ANALYZER,\n    }));\n}\n\n// ---------------------------------------------------------------------------\n// Source 2: Pod health heuristics\n// ---------------------------------------------------------------------------\n\n/**\n * Inspects every `Pod` resource and emits seeds for:\n * - CrashLoopBackOff containers (highest priority)\n * - ImagePullBackOff / ErrImagePull containers (highest priority)\n * - Not-ready pods without the above errors (medium priority)\n */\nfunction seedsFromPods(\n  resources: K8sResource[],\n  makeId: (prefix: string) => string,\n): InvestigationSeed[] {\n  const seeds: InvestigationSeed[] = [];\n\n  for (const resource of resources) {\n    if (resource.kind !== 'Pod') continue;\n\n    const podStatus = extractPodStatus(resource);\n    if (!podStatus) continue;\n\n    const name = resource.metadata.name;\n    const ns = resource.metadata.namespace ?? 'default';\n    const containerErrors = getContainerErrors(resource);\n\n    // ── CrashLoopBackOff ────────────────────────────────────────────────────\n    const crashLoop = containerErrors.find((e) => e.reason === 'CrashLoopBackOff');\n    if (crashLoop) {\n      seeds.push({\n        id: makeId('pod'),\n        hypothesis: `Pod ${name} is in CrashLoopBackOff (container: ${crashLoop.container}, namespace: ${ns})`,\n        source: `pod:${ns}/${name}`,\n        category: 'kubernetes',\n        priority: PRIORITY_CRASHLOOP,\n      });\n      continue; // Don't double-count as not-ready\n    }\n\n    // ── ImagePullBackOff / ErrImagePull ─────────────────────────────────────\n    const imagePull = containerErrors.find(\n      (e) => e.reason === 'ImagePullBackOff' || e.reason === 'ErrImagePull',\n    );\n    if (imagePull) {\n      seeds.push({\n        id: makeId('pod'),\n        hypothesis: `Pod ${name} is in ${imagePull.reason} (container: ${imagePull.container}, namespace: ${ns})`,\n        source: `pod:${ns}/${name}`,\n        category: 'kubernetes',\n        priority: PRIORITY_IMAGE_PULL,\n      });\n      continue; // Don't double-count as not-ready\n    }\n\n    // ── Not-ready (readiness probe failure, dependency issue, etc.) ──────────\n    const readyCond = podStatus.conditions.find((c) => c.type === 'Ready');\n    if (readyCond && readyCond.status === 'False') {\n      seeds.push({\n        id: makeId('pod'),\n        hypothesis: `Pod ${name} is not ready in namespace ${ns}`,\n        source: `pod:${ns}/${name}`,\n        category: 'kubernetes',\n        priority: PRIORITY_POD_NOT_READY,\n      });\n    }\n  }\n\n  return seeds;\n}\n\n// ---------------------------------------------------------------------------\n// Source 3: High-importance log files\n// ---------------------------------------------------------------------------\n\n/**\n * Emits a log seed for any log file whose importance score meets the\n * {@link LOG_IMPORTANCE_THRESHOLD}.  Priority is scaled slightly above the\n * base value when the log is extremely dense with errors.\n */\nfunction seedsFromLogs(\n  logs: LogFile[],\n  makeId: (prefix: string) => string,\n): InvestigationSeed[] {\n  return logs\n    .filter((l) => l.importance >= LOG_IMPORTANCE_THRESHOLD)\n    .map((l) => ({\n      id: makeId('log'),\n      hypothesis: `Log file ${l.path} contains significant errors or warnings (importance: ${l.importance.toFixed(2)})`,\n      source: `log:${l.path}`,\n      category: 'log' as SeedCategory,\n      // Scale up to PRIORITY_HIGH_LOG_BASE + 10 for importance=1.0\n      priority: Math.round(PRIORITY_HIGH_LOG_BASE + l.importance * 10),\n    }));\n}\n\n// ---------------------------------------------------------------------------\n// Source 4: Warning events\n// ---------------------------------------------------------------------------\n\nfunction seedsFromEvents(\n  events: K8sEvent[],\n  makeId: (prefix: string) => string,\n): InvestigationSeed[] {\n  return events\n    .filter((e) => e.type === 'Warning')\n    .map((e) => ({\n      id: makeId('event'),\n      hypothesis: `Kubernetes warning event: ${e.reason} on ${e.involvedObject.kind}/${e.involvedObject.name}: ${e.message.slice(0, 100)}`,\n      source: `event:${e.reason}:${e.involvedObject.name}`,\n      category: 'kubernetes' as SeedCategory,\n      priority: PRIORITY_WARNING_EVENT,\n    }));\n}\n\n// ---------------------------------------------------------------------------\n// Source 5: Node health conditions\n// ---------------------------------------------------------------------------\n\n/**\n * Scans Node resources for unhealthy conditions and blocking taints and emits\n * seeds for:\n * - `Ready=False`         (NodeNotReady — highest node-level urgency)\n * - `MemoryPressure=True` (memory pressure on the node)\n * - `DiskPressure=True`   (disk pressure on the node)\n * - `PIDPressure=True`    (PID pressure on the node)\n * - `NoSchedule/NoExecute` taints that may block pod scheduling\n *\n * Healthy, untainted nodes produce no seeds.\n */\nfunction seedsFromNodes(\n  resources: K8sResource[],\n  makeId: (prefix: string) => string,\n): InvestigationSeed[] {\n  const seeds: InvestigationSeed[] = [];\n\n  for (const resource of resources) {\n    if (resource.kind !== 'Node') continue;\n    if (!isRecord(resource.status)) continue;\n\n    const nodeName = resource.metadata.name;\n    const rawConditions = resource.status['conditions'];\n    if (!Array.isArray(rawConditions)) continue;\n\n    for (const rawCond of rawConditions) {\n      if (!isRecord(rawCond)) continue;\n      const type = typeof rawCond['type'] === 'string' ? rawCond['type'] : '';\n      const status = typeof rawCond['status'] === 'string' ? rawCond['status'] : '';\n\n      if (type === 'Ready' && status === 'False') {\n        seeds.push({\n          id: makeId('node'),\n          hypothesis: `Node ${nodeName} is NotReady — pods cannot be scheduled or will be evicted`,\n          source: `node:${nodeName}`,\n          category: 'kubernetes',\n          priority: PRIORITY_NODE_NOT_READY,\n        });\n      } else if (type === 'MemoryPressure' && status === 'True') {\n        seeds.push({\n          id: makeId('node'),\n          hypothesis: `Node ${nodeName} has MemoryPressure — pods may be throttled or evicted`,\n          source: `node:${nodeName}`,\n          category: 'kubernetes',\n          priority: PRIORITY_NODE_PRESSURE,\n        });\n      } else if (type === 'DiskPressure' && status === 'True') {\n        seeds.push({\n          id: makeId('node'),\n          hypothesis: `Node ${nodeName} has DiskPressure — pods may fail to start due to insufficient disk space`,\n          source: `node:${nodeName}`,\n          category: 'kubernetes',\n          priority: PRIORITY_NODE_PRESSURE,\n        });\n      } else if (type === 'PIDPressure' && status === 'True') {\n        seeds.push({\n          id: makeId('node'),\n          hypothesis: `Node ${nodeName} has PIDPressure — new processes may fail to start`,\n          source: `node:${nodeName}`,\n          category: 'kubernetes',\n          priority: PRIORITY_NODE_PRESSURE,\n        });\n      }\n    }\n\n    if (isRecord(resource.spec)) {\n      const rawTaints = resource.spec['taints'];\n      if (Array.isArray(rawTaints)) {\n        for (const rawTaint of rawTaints) {\n          if (!isRecord(rawTaint)) continue;\n          const key = typeof rawTaint['key'] === 'string' ? rawTaint['key'] : '';\n          const effect = typeof rawTaint['effect'] === 'string' ? rawTaint['effect'] : '';\n          const value = typeof rawTaint['value'] === 'string' ? rawTaint['value'] : undefined;\n          if (!key || (effect !== 'NoSchedule' && effect !== 'NoExecute')) continue;\n\n          const taintLabel = value ? `${key}=${value}` : key;\n          seeds.push({\n            id: makeId('node'),\n            hypothesis:\n              `Node ${nodeName} has taint ${taintLabel}:${effect} — pods without a matching toleration may fail to schedule`,\n            source: `node:${nodeName}`,\n            category: 'kubernetes',\n            priority: PRIORITY_NODE_TAINT,\n          });\n        }\n      }\n    }\n  }\n\n  return seeds;\n}\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\n/**\n * Generates investigation seeds from all available sources in the context.\n *\n * Seeds are created from five sources:\n * 1. Analyzer results with `error` or `warn` severity\n * 2. Pod health heuristics (CrashLoopBackOff, ImagePullBackOff, not-ready)\n * 3. Log files whose importance score exceeds the threshold\n * 4. Warning-type Kubernetes events\n * 5. Node health conditions and blocking taints (NotReady, pressure conditions, NoSchedule/NoExecute)\n *\n * The returned array is sorted by {@link InvestigationSeed.priority}\n * descending — highest-priority (most actionable) seeds come first.\n */\nexport function generateSeeds(context: InvestigatorContext): InvestigationSeed[] {\n  let counter = 0;\n  const makeId = (prefix: string): string => `seed:${prefix}:${counter++}`;\n\n  const seeds: InvestigationSeed[] = [\n    ...seedsFromAnalyzers(context.analyzerResults, makeId),\n    ...seedsFromPods(context.resources, makeId),\n    ...seedsFromNodes(context.resources, makeId),\n    ...seedsFromLogs(context.logs, makeId),\n    ...seedsFromEvents(context.events, makeId),\n  ];\n\n  // Sort by priority descending (highest first)\n\n[3 more lines in file. Use offset=321 to continue.]"}],"isError":false,"timestamp":1774117227478}}
+{"type":"message","id":"0567e093","parentId":"d7a68f18","timestamp":"2026-03-21T18:20:27.479Z","message":{"role":"toolResult","toolCallId":"call_4hrFY075mwrj14750YTHrThR|fc_0f9932afa4a686050169bee16b4ba0819b8a73f0343f1e1ea9","toolName":"read","content":[{"type":"text","text":"import * as fs from \"fs/promises\";\nimport * as path from \"path\";\nimport * as tar from \"tar\";\n\n/**\n * Returns the absolute path to the fixture directory for a given scenario name.\n */\nexport function getFixturePath(scenario: string): string {\n  return path.resolve(__dirname, \"../fixtures/scenarios\", scenario);\n}\n\n/**\n * Packs a scenario directory into a .tar.gz bundle archive.\n *\n * @param scenarioDir - Absolute or relative path to the directory to pack.\n * @param outputPath  - Absolute or relative path for the output .tar.gz file.\n * @returns The resolved output path.\n */\nexport async function createTestBundle(\n  scenarioDir: string,\n  outputPath: string\n): Promise<string> {\n  const absoluteScenarioDir = path.resolve(scenarioDir);\n  const absoluteOutputPath = path.resolve(outputPath);\n\n  const scenarioStats = await fs.stat(absoluteScenarioDir).catch(() => null);\n  if (!scenarioStats?.isDirectory()) {\n    throw new Error(`Scenario directory does not exist: ${absoluteScenarioDir}`);\n  }\n\n  await fs.mkdir(path.dirname(absoluteOutputPath), { recursive: true });\n\n  // Collect entries relative to the parent of scenarioDir so that the\n  // archive contains the scenario folder itself at its root.\n  const parentDir = path.dirname(absoluteScenarioDir);\n  const scenarioName = path.basename(absoluteScenarioDir);\n\n  await tar.c(\n    {\n      gzip: true,\n      file: absoluteOutputPath,\n      cwd: parentDir,\n    },\n    [scenarioName]\n  );\n\n  return absoluteOutputPath;\n}\n"}],"isError":false,"timestamp":1774117227478}}
+{"type":"message","id":"aee154ff","parentId":"0567e093","timestamp":"2026-03-21T18:20:27.479Z","message":{"role":"toolResult","toolCallId":"call_sgj6kbYeyVdjC3HlGdvIEwGX|fc_0f9932afa4a686050169bee16b4d9c819bab8b77a911339eef","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// Golden Set Evaluator\n// ---------------------------------------------------------------------------\n//\n// Scores pipeline results against golden expectations. Returns a structured\n// report that can be serialised to JSON for nightly CI artifacts.\n\nimport type { Finding } from '../../src/types/index.js';\nimport type { ScenarioExpectation } from './expectations.js';\n\nexport interface EvalDetail {\n  check: string;\n  pass: boolean;\n  detail: string;\n}\n\nexport type EvalMode = 'heuristic' | 'ai';\n\nexport interface ScenarioEvalResult {\n  scenario: string;\n  displayName: string;\n  pass: boolean;\n  score: number;\n  checks: EvalDetail[];\n  topFinding: string;\n  expectedPattern: string;\n  confidence: number;\n  evidenceCount: number;\n  mode: EvalMode;\n}\n\nexport interface EvalReport {\n  timestamp: string;\n  scenarios: Record<string, ScenarioEvalResult>;\n  overallPass: boolean;\n  overallScore: number;\n}\n\nfunction allFindingsText(findings: Finding[]): string {\n  return findings\n    .map((f) => [\n      f.title,\n      f.reasoningSummary,\n      ...f.evidence.map((e) => `${e.path} ${e.note}`),\n    ].join(' '))\n    .join(' ');\n}\n\nfunction summarizeExpectedPattern(expectation: ScenarioExpectation): string {\n  return expectation.topFindingMustMatch\n    .map((pattern) => pattern.source)\n    .join(' || ');\n}\n\nexport function evaluateScenario(\n  scenarioName: string,\n  expectation: ScenarioExpectation,\n  findings: Finding[],\n  mode: EvalMode = 'heuristic',\n): ScenarioEvalResult {\n  const checks: EvalDetail[] = [];\n  const top = findings[0];\n\n  // 1. Minimum findings count\n  checks.push({\n    check: 'minFindings',\n    pass: findings.length >= expectation.minFindings,\n    detail: `Expected >= ${expectation.minFindings}, got ${findings.length}`,\n  });\n\n  // 2. Top finding title matches\n  const topTitleMatch =\n    top !== undefined &&\n    expectation.topFindingMustMatch.some((re) => re.test(top.title));\n  checks.push({\n    check: 'topFindingTitle',\n    pass: topTitleMatch,\n    detail: top\n      ? `Top finding: \"${top.title}\"`\n      : 'No findings produced',\n  });\n\n  // 3. Top finding severity\n  const topSeverityMatch =\n    top !== undefined &&\n    expectation.topFindingSeverity.includes(top.severity);\n  checks.push({\n    check: 'topFindingSeverity',\n    pass: topSeverityMatch,\n    detail: top\n      ? `Got \"${top.severity}\", expected one of [${expectation.topFindingSeverity.join(', ')}]`\n      : 'No findings',\n  });\n\n  // 4. Top finding confidence\n  const topConfMatch =\n    top !== undefined &&\n    top.confidence >= expectation.topFindingMinConfidence;\n  checks.push({\n    check: 'topFindingConfidence',\n    pass: topConfMatch,\n    detail: top\n      ? `Got ${(top.confidence * 100).toFixed(0)}%, min ${(expectation.topFindingMinConfidence * 100).toFixed(0)}%`\n      : 'No findings',\n  });\n\n  // 5. Evidence citation coverage\n  const allPaths = findings.flatMap((f) => f.evidence.map((e) => e.path));\n  for (const pattern of expectation.mustCiteEvidence) {\n    const cited = allPaths.some((p) => pattern.test(p));\n    checks.push({\n      check: `mustCiteEvidence: ${pattern.source}`,\n      pass: cited,\n      detail: cited ? 'Found matching evidence path' : `No evidence path matches /${pattern.source}/`,\n    });\n  }\n\n  // 6. No hallucinations\n  const fullText = allFindingsText(findings);\n  for (const pattern of expectation.mustNotHallucinate) {\n    const found = pattern.test(fullText);\n    checks.push({\n      check: `mustNotHallucinate: ${pattern.source}`,\n      pass: !found,\n      detail: found\n        ? `HALLUCINATION DETECTED: /${pattern.source}/ found in findings text`\n        : 'Clean — pattern not found',\n    });\n  }\n\n  // 7. Root cause match\n  const rootCauseText = top?.reasoningSummary ?? '';\n  const rootCauseMatch = expectation.rootCauseMustMatch.some((re) =>\n    re.test(rootCauseText),\n  );\n  checks.push({\n    check: 'rootCauseMatch',\n    pass: rootCauseMatch,\n    detail: rootCauseMatch\n      ? 'Root cause reasoning matches expected pattern'\n      : `Root cause \"${rootCauseText.slice(0, 100)}\" did not match any expected pattern`,\n  });\n\n  // 8. Required identifiers\n  for (const id of expectation.mustMentionIdentifiers) {\n    const mentioned = fullText.toLowerCase().includes(id.toLowerCase());\n    checks.push({\n      check: `mustMention: ${id}`,\n      pass: mentioned,\n      detail: mentioned ? `Found \"${id}\"` : `\"${id}\" not found in any finding`,\n    });\n  }\n\n  const passCount = checks.filter((c) => c.pass).length;\n  const score = checks.length > 0 ? passCount / checks.length : 0;\n\n  return {\n    scenario: scenarioName,\n    displayName: expectation.name,\n    pass: checks.every((c) => c.pass),\n    score,\n    checks,\n    topFinding: top?.title ?? 'No findings produced',\n    expectedPattern: summarizeExpectedPattern(expectation),\n    confidence: top?.confidence ?? 0,\n    evidenceCount: findings.reduce((sum, finding) => sum + finding.evidence.length, 0),\n    mode,\n  };\n}\n\nexport function buildEvalReport(\n  results: Record<string, ScenarioEvalResult>,\n): EvalReport {\n  const scenarios = results;\n  const allResults = Object.values(scenarios);\n  const overallPass = allResults.every((r) => r.pass);\n  const overallScore =\n    allResults.length > 0\n      ? allResults.reduce((sum, r) => sum + r.score, 0) / allResults.length\n      : 0;\n\n  return {\n    timestamp: new Date().toISOString(),\n    scenarios,\n    overallPass,\n    overallScore,\n  };\n}\n"}],"isError":false,"timestamp":1774117227479}}
+{"type":"message","id":"278bb872","parentId":"aee154ff","timestamp":"2026-03-21T18:20:27.479Z","message":{"role":"toolResult","toolCallId":"call_GNMp9LZFfnjR3nzNFvhq8rzD|fc_0f9932afa4a686050169bee16b4da4819b906f51f31df0216f","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// Golden Set Expectations\n// ---------------------------------------------------------------------------\n//\n// Defines structural expectations for each scenario. These are NOT about\n// exact LLM wording — they verify that the correct root cause appears, that\n// evidence is cited from the right artifacts, and that no hallucinations\n// appear.\n\nimport type { FindingSeverity } from '../../src/types/index.js';\n\nexport interface ScenarioExpectation {\n  /** Human-readable scenario name. */\n  name: string;\n  /** Minimum number of findings the pipeline should produce. */\n  minFindings: number;\n  /** Top finding title must match one of these patterns. */\n  topFindingMustMatch: RegExp[];\n  /** Acceptable severities for the top finding. */\n  topFindingSeverity: FindingSeverity[];\n  /** Minimum confidence for the top finding. */\n  topFindingMinConfidence: number;\n  /**\n   * Evidence paths across all findings must include at least one match\n   * per pattern.\n   */\n  mustCiteEvidence: RegExp[];\n  /**\n   * No finding title or reasoning should match these patterns.\n   * Catches hallucinations of wrong failure modes.\n   */\n  mustNotHallucinate: RegExp[];\n  /**\n   * Root cause (reasoning of top finding) must match at least one pattern.\n   */\n  rootCauseMustMatch: RegExp[];\n  /**\n   * Key identifiers that must appear somewhere in findings (titles,\n   * reasoning, evidence notes).\n   */\n  mustMentionIdentifiers: string[];\n}\n\nexport const GOLDEN_EXPECTATIONS: Record<string, ScenarioExpectation> = {\n  'bad-image-tag': {\n    name: 'Bad Image Tag (ImagePullBackOff)',\n    minFindings: 1,\n    topFindingMustMatch: [\n      /image.*pull/i,\n      /ImagePullBackOff/i,\n      /ErrImagePull/i,\n      /image.*tag/i,\n    ],\n    topFindingSeverity: ['critical'],\n    // Hypothesis evidence for image-pull-failure uses events + pod-status only\n    // (no log evidence in collector), giving 0.74 confidence.  Step 1 correctly\n    // routes the log finding through hypothesis dedup (Pod-based components),\n    // so the hypothesis becomes the top finding.  Step 5 will further tune this.\n    topFindingMinConfidence: 0.74,\n    mustCiteEvidence: [\n      /pods/i,\n      /events/i,\n    ],\n    mustNotHallucinate: [\n      /^CrashLoopBackOff$/i, // wrong failure mode (exact match)\n      /missing.*secret/i,     // wrong failure mode\n    ],\n    rootCauseMustMatch: [\n      /image/i,\n      /v999\\.99\\.99|pull|tag|registry/i,\n    ],\n    mustMentionIdentifiers: ['app-pod', 'myapp:v999.99.99'],\n  },\n\n  'missing-secret-crashloop': {\n    name: 'Missing Secret CrashLoop',\n    minFindings: 1,\n    topFindingMustMatch: [\n      /CrashLoopBackOff/i,\n      /missing.*secret/i,\n      /app-credentials/i,\n      // New hypothesis rootCause format (title is now just the rootCause string)\n      /kubernetes secret.*absent|required.*kubernetes secret|secret.*absent|secret.*fail/i,\n    ],\n    topFindingSeverity: ['critical'],\n    topFindingMinConfidence: 0.85,\n    mustCiteEvidence: [\n      /pods/i,\n      /events/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n    ],\n    rootCauseMustMatch: [\n      /secret|app-credentials|CrashLoop|FailedMount/i,\n    ],\n    mustMentionIdentifiers: ['app-pod', 'app-credentials'],\n  },\n\n  'ghost-service': {\n    name: 'Ghost Service (Cross-Namespace DNS Failure)',\n    minFindings: 2,\n    topFindingMustMatch: [\n      /CrashLoopBackOff/i,\n      /dns/i,\n      /api-service\\.staging/i,\n      /no such host/i,\n    ],\n    // In heuristic mode the CrashLoop symptom currently sorts above the DNS\n    // hypothesis. If ranking changes later, the namespace-mismatch DNS finding\n    // is still acceptable as the top finding for this scenario.\n    topFindingSeverity: ['critical', 'high'],\n    topFindingMinConfidence: 0.8,\n    mustCiteEvidence: [\n      /pods/i,\n      /events/i,\n      /services/i,\n      /staging/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n      /persistentvolumeclaim|storageclass/i,\n      /OOMKilled/i,\n    ],\n    rootCauseMustMatch: [\n      /crashloop|backoff|restart/i,\n      /dns|no such host|api-service\\.staging|namespace/i,\n    ],\n    mustMentionIdentifiers: ['web-app-pod', 'api-service.staging', 'staging'],\n  },\n\n  'network-policy-deny': {\n    name: 'NetworkPolicy Deny-All Egress',\n    minFindings: 3,\n    topFindingMustMatch: [\n      /NetworkPolicy/i,\n      /deny-all-egress/i,\n      /egress/i,\n      /payments-api/i,\n    ],\n    topFindingSeverity: ['high'],\n    topFindingMinConfidence: 0.9,\n    mustCiteEvidence: [\n      /networkpolicies/i,\n      /pods/i,\n      /services/i,\n      /logs/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n      /CrashLoopBackOff/i,\n      /missing.*secret/i,\n    ],\n    rootCauseMustMatch: [\n      /networkpolicy|deny|egress|outbound/i,\n      /payments-api|service|port 8443/i,\n    ],\n    mustMentionIdentifiers: ['api-client-pod', 'deny-all-egress', 'payments-api'],\n  },\n\n  'helm-release-failure': {\n    name: 'Helm Release Failure (Failed Hook CrashLoop)',\n    minFindings: 1,\n    topFindingMustMatch: [\n      /CrashLoopBackOff/i,\n      /storefront-hook-pod/i,\n      /hook/i,\n    ],\n    topFindingSeverity: ['critical'],\n    topFindingMinConfidence: 0.95,\n    mustCiteEvidence: [\n      /pods/i,\n      /events/i,\n    ],\n    mustNotHallucinate: [\n      /ImagePullBackOff/i,\n      /missing.*secret/i,\n      /NetworkPolicy/i,\n    ],\n    rootCauseMustMatch: [\n      /crashloop|backoff|restart/i,\n      /migrate-hook|storefront-hook-pod/i,\n    ],\n 