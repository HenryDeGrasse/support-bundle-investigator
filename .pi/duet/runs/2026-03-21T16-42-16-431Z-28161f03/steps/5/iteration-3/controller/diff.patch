 {"type":"message","id":"7ec2ae26","parentId":"e169838a","timestamp":"2026-03-21T18:02:24.164Z","message":{"role":"toolResult","toolCallId":"call_y2fQw3FeMi8l3ep70y7oLGUn|fc_0f9932afa4a686050169bedd301ef8819b8ee1f25211b262f6","toolName":"read","content":[{"type":"text","text":"import type { EvalReport, ScenarioEvalResult } from './evaluate.js';\n\nfunction escapeMarkdownCell(value: string): string {\n  return value\n    .replace(/\\|/g, '\\\\|')\n    .replace(/\\r?\\n|\\r/g, ' ')\n    .trim();\n}\n\nfunction formatPass(pass: boolean): string {\n  return pass ? 'PASS' : 'FAIL';\n}\n\nfunction formatPercent(value: number): string {\n  return `${(value * 100).toFixed(1)}%`;\n}\n\nfunction formatConfidence(value: number): string {\n  return value > 0 ? `${value.toFixed(2)}` : 'n/a';\n}\n\nfunction formatMode(mode: ScenarioEvalResult['mode']): string {\n  return mode === 'ai' ? 'AI' : 'Heuristic';\n}\n\nfunction buildSummary(report: EvalReport) {\n  const scenarioEntries = Object.entries(report.scenarios)\n    .sort(([left], [right]) => left.localeCompare(right))\n    .map(([scenario, result]) => ({\n      scenario,\n      displayName: result.displayName,\n      pass: result.pass,\n      score: result.score,\n      topFinding: result.topFinding,\n      expectedPattern: result.expectedPattern,\n      confidence: result.confidence,\n      evidenceCount: result.evidenceCount,\n      mode: result.mode,\n      checksPassed: result.checks.filter((check) => check.pass).length,\n      checksTotal: result.checks.length,\n    }));\n\n  return {\n    timestamp: report.timestamp,\n    overallPass: report.overallPass,\n    overallScore: report.overallScore,\n    scenarioCount: scenarioEntries.length,\n    passedScenarioCount: scenarioEntries.filter((entry) => entry.pass).length,\n    failedScenarioCount: scenarioEntries.filter((entry) => !entry.pass).length,\n    scenarios: scenarioEntries,\n  };\n}\n\nexport function generateScorecard(report: EvalReport): string {\n  const summary = buildSummary(report);\n  const lines: string[] = [\n    '# Golden Eval Scorecard',\n    '',\n    `Generated: ${summary.timestamp}`,\n    '',\n    `Overall Pass: ${summary.overallPass ? 'YES' : 'NO'}`,\n    `Overall Score: ${formatPercent(summary.overallScore)}`,\n    `Scenario Count: ${summary.scenarioCount}`,\n    '',\n    '| Scenario | Pass/Fail | Score% | Top Finding | Expected Pattern | Confidence | Evidence Count | Heuristic/AI |',\n    '| --- | --- | ---: | --- | --- | ---: | ---: | --- |',\n  ];\n\n  for (const entry of summary.scenarios) {\n    lines.push(\n      `| ${escapeMarkdownCell(entry.scenario)} | ${formatPass(entry.pass)} | ${formatPercent(entry.score)} | ${escapeMarkdownCell(entry.topFinding)} | ${escapeMarkdownCell(entry.expectedPattern)} | ${formatConfidence(entry.confidence)} | ${entry.evidenceCount} | ${formatMode(entry.mode)} |`,\n    );\n  }\n\n  lines.push('', '## JSON Summary', '', '```json', JSON.stringify(summary, null, 2), '```');\n\n  return lines.join('\\n');\n}\n"}],"isError":false,"timestamp":1774116144164}}
 {"type":"message","id":"25b24515","parentId":"7ec2ae26","timestamp":"2026-03-21T18:02:24.164Z","message":{"role":"toolResult","toolCallId":"call_2javiVjrDgdbDjE2Szhzncdn|fc_0f9932afa4a686050169bedd301f08819baad1eff6089b5b6c","toolName":"read","content":[{"type":"text","text":"import { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport * as fs from 'fs';\nimport * as os from 'os';\nimport * as path from 'path';\n\nimport { analyzeBundlePipeline, cleanupPipelineResult } from '../../../src/pipeline/analyze.js';\nimport type { PipelineResult } from '../../../src/pipeline/analyze.js';\nimport { createTestBundle, getFixturePath } from '../../helpers/create-test-bundle.js';\nimport { GOLDEN_EXPECTATIONS } from '../expectations.js';\nimport { buildEvalReport, evaluateScenario } from '../evaluate.js';\nimport { generateScorecard } from '../scorecard.js';\n\nlet tmpDir: string;\nconst results: Record<string, PipelineResult> = {};\n\nbeforeAll(async () => {\n  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'sbi-scorecard-'));\n\n  for (const scenario of Object.keys(GOLDEN_EXPECTATIONS)) {\n    const bundlePath = await createTestBundle(\n      getFixturePath(scenario),\n      path.join(tmpDir, `${scenario}.tar.gz`),\n    );\n    results[scenario] = await analyzeBundlePipeline(bundlePath, { noAi: true });\n  }\n});\n\nafterAll(async () => {\n  for (const result of Object.values(results)) {\n    await cleanupPipelineResult(result);\n  }\n  fs.rmSync(tmpDir, { recursive: true, force: true });\n});\n\ndescribe('Golden Evaluation: scorecard', () => {\n  it('generates a markdown scorecard with a machine-readable JSON summary', () => {\n    const scenarioResults: Record<string, ReturnType<typeof evaluateScenario>> = {};\n\n    for (const [scenario, expectation] of Object.entries(GOLDEN_EXPECTATIONS)) {\n      scenarioResults[scenario] = evaluateScenario(scenario, expectation, results[scenario]!.findings);\n    }\n\n    const report = buildEvalReport(scenarioResults);\n    const scorecard = generateScorecard(report);\n\n    expect(scorecard).toContain('# Golden Eval Scorecard');\n    expect(scorecard).toContain(\n      '| Scenario | Pass/Fail | Score% | Top Finding | Expected Pattern | Confidence | Evidence Count | Heuristic/AI |',\n    );\n    expect(scorecard).toContain('| --- | --- | ---: | --- | --- | ---: | ---: | --- |');\n    expect(scorecard).toContain('## JSON Summary');\n    expect(scorecard).not.toContain('undefined');\n\n    for (const scenario of Object.keys(GOLDEN_EXPECTATIONS)) {\n      expect(scorecard).toContain(`| ${scenario} |`);\n    }\n\n    const jsonBlockMatch = scorecard.match(/```json\\n([\\s\\S]+?)\\n```/);\n    expect(jsonBlockMatch).not.toBeNull();\n\n    const summary = JSON.parse(jsonBlockMatch![1]!) as {\n      overallScore: number;\n      scenarioCount: number;\n      scenarios: Array<{ scenario: string }>;\n    };\n\n    expect(summary.scenarioCount).toBe(Object.keys(GOLDEN_EXPECTATIONS).length);\n    expect(summary.scenarios).toHaveLength(Object.keys(GOLDEN_EXPECTATIONS).length);\n    expect(summary.overallScore).toBeGreaterThan(0.9);\n  });\n});\n"}],"isError":false,"timestamp":1774116144164}}
