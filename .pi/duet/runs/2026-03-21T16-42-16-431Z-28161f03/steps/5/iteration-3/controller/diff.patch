es","provider":"openai-codex","model":"gpt-5.4","usage":{"input":19773,"output":235,"cacheRead":24832,"cacheWrite":0,"totalTokens":44840,"cost":{"input":0.049432500000000004,"output":0.003525,"cacheRead":0.006208,"cacheWrite":0,"total":0.0591655}},"stopReason":"toolUse","timestamp":1774116239753,"responseId":"resp_0f9932afa4a686050169bedd901658819b9b6d188b997d51c8"}}
+{"type":"message","id":"37a5732c","parentId":"db0b86e7","timestamp":"2026-03-21T18:04:07.622Z","message":{"role":"toolResult","toolCallId":"call_hLnWIrhO9ZJDlzngyCWJGMXC|fc_0f9932afa4a686050169bedd978460819b9559195ed5f322fc","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// LLM Response Recorder / Replay\n// ---------------------------------------------------------------------------\n//\n// Provides record/replay for LLM investigation calls so nightly CI can\n// capture real API responses and PR CI can replay them deterministically.\n//\n// Mode is controlled via `SBI_AI_MODE` environment variable:\n//   - `live`   — real API calls, no recording (default)\n//   - `record` — real API calls, save cassettes to disk\n//   - `replay` — load cassettes, match by seed key, return cached response\n//\n// Cassettes are keyed by a hash of seed.id + seed.category so that prompt\n// refactoring does not invalidate recordings. If a seed has no matching\n// cassette during replay, the call returns empty findings (not an error).\n\nimport * as fsp from 'fs/promises';\nimport * as path from 'path';\nimport * as crypto from 'crypto';\nimport type { AIFinding } from './schemas.js';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport type RecorderMode = 'live' | 'record' | 'replay';\n\nexport interface Cassette {\n  seedKey: string;\n  seedId: string;\n  seedCategory: string;\n  request: { system: string; user: string };\n  response: { findings: AIFinding[]; rawResponse: string };\n  model: string;\n  timestamp: string;\n}\n\nexport interface CassetteStore {\n  version: string;\n  cassettes: Record<string, Cassette>;\n}\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\n/**\n * Computes a stable cassette key from a seed's identity fields.\n *\n * Uses `seed.id + seed.category` so that prompt text changes don't\n * invalidate recordings — only seed identity matters.\n */\nexport function cassetteSeedKey(seedId: string, seedCategory: string): string {\n  const hash = crypto\n    .createHash('sha256')\n    .update(`${seedId}::${seedCategory}`)\n    .digest('hex')\n    .slice(0, 16);\n  return `${seedCategory}:${hash}`;\n}\n\n/**\n * Reads the `SBI_AI_MODE` environment variable and normalises it to a\n * valid {@link RecorderMode}. Defaults to `'live'`.\n */\nexport function getRecorderMode(): RecorderMode {\n  const raw = (process.env['SBI_AI_MODE'] ?? 'live').trim().toLowerCase();\n  if (raw === 'record' || raw === 'replay') return raw;\n  return 'live';\n}\n\n// ---------------------------------------------------------------------------\n// CassetteRecorder\n// ---------------------------------------------------------------------------\n\n/**\n * Records and replays LLM investigation call responses.\n *\n * ### Recording flow (nightly CI)\n * ```typescript\n * const recorder = new CassetteRecorder('record', './test/cassettes');\n * // After each real LLM call:\n * recorder.record(seedId, seedCategory, request, response, model);\n * // At the end:\n * await recorder.flush();\n * ```\n *\n * ### Replay flow (PR CI)\n * ```typescript\n * const recorder = new CassetteRecorder('replay', './test/cassettes');\n * await recorder.load();\n * // Instead of calling the LLM:\n * const cached = recorder.replay(seedId, seedCategory);\n * if (cached) { use cached.response } else { skip or warn }\n * ```\n */\nexport class CassetteRecorder {\n  readonly mode: RecorderMode;\n  private readonly dir: string;\n  private store: CassetteStore;\n\n  constructor(mode: RecorderMode, cassetteDir: string) {\n    this.mode = mode;\n    this.dir = cassetteDir;\n    this.store = { version: '1', cassettes: {} };\n  }\n\n  /** Returns the file path for the consolidated cassette store. */\n  get storePath(): string {\n    return path.join(this.dir, 'cassettes.json');\n  }\n\n  /** Number of cassettes currently held in memory. */\n  get size(): number {\n    return Object.keys(this.store.cassettes).length;\n  }\n\n  /**\n   * Records a single LLM call.\n   *\n   * Only takes effect in `record` mode; no-ops in other modes.\n   */\n  record(\n    seedId: string,\n    seedCategory: string,\n    request: { system: string; user: string },\n    response: { findings: AIFinding[]; rawResponse: string },\n    model: string,\n  ): void {\n    if (this.mode !== 'record') return;\n\n    const key = cassetteSeedKey(seedId, seedCategory);\n    this.store.cassettes[key] = {\n      seedKey: key,\n      seedId,\n      seedCategory,\n      request,\n      response,\n      model,\n      timestamp: new Date().toISOString(),\n    };\n  }\n\n  /**\n   * Retrieves a cached response for the given seed identity.\n   *\n   * Returns `undefined` when no matching cassette exists.\n   */\n  replay(\n    seedId: string,\n    seedCategory: string,\n  ): Cassette | undefined {\n    const key = cassetteSeedKey(seedId, seedCategory);\n    return this.store.cassettes[key];\n  }\n\n  /**\n   * Loads cassettes from disk into memory.\n   *\n   * Safe to call in any mode — silently returns if the file doesn't exist.\n   */\n  async load(): Promise<void> {\n    try {\n      const raw = await fsp.readFile(this.storePath, 'utf-8');\n      const parsed = JSON.parse(raw) as CassetteStore;\n      if (parsed.version === '1' && typeof parsed.cassettes === 'object') {\n        this.store = parsed;\n      }\n    } catch {\n      // File not found or parse error — start with empty store\n      this.store = { version: '1', cassettes: {} };\n    }\n  }\n\n  /**\n   * Writes all recorded cassettes to disk.\n   *\n   * Only takes effect in `record` mode; no-ops in other modes.\n   */\n  async flush(): Promise<void> {\n    if (this.mode !== 'record') return;\n\n    await fsp.mkdir(this.dir, { recursive: true });\n    await fsp.writeFile(\n      this.storePath,\n      JSON.stringify(this.store, null, 2),\n      'utf-8',\n    );\n  }\n\n  /** Returns all stored cassette keys (for diagnostics). */\n  keys(): string[] {\n    return Object.keys(this.store.cassettes);\n  }\n\n  /** Checks if a cassette exists for the given seed. */\n  has(seedId: string, seedCategory: string): boolean {\n    return this.replay(seedId, seedCategory) !== undefined;\n  }\n}\n"}],"isError":false,"timestamp":1774116247622}}
+{"type":"message","id":"d659c9f0","parentId":"37a5732c","timestamp":"2026-03-21T18:04:07.622Z","message":{"role":"toolResult","toolCallId":"call_Spy8rTry8ijARo4U5cQKCelw|fc_0f9932afa4a686050169bedd97846c819b8f66019f66f27722","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// AI Configuration\n// ---------------------------------------------------------------------------\n//\n// Reads AI provider settings from environment variables and optional CLI\n// overrides. AI is enabled only when a valid API key is present AND the\n// caller has not explicitly opted out with --no-ai.\n//\n// Environment variables:\n//   OPENAI_API_KEY         — OpenAI API key (required for AI features)\n//   SBI_AI_MODEL           — Chat completion model (default: gpt-4o)\n//   SBI_LLM_BACKEND        — LLM backend (default: openai)\n//                            Values: openai | local\n//   SBI_LLM_URL            — LLM endpoint URL (default: https://api.openai.com/v1)\n//                            For local backends (Ollama, llama.cpp, vLLM):\n//                              http://localhost:11434/v1\n//   SBI_TOKEN_BUDGET        — Max tokens of context per AI seed call (default: 100000)\n//   SBI_EMBEDDING_MODEL    — Embedding model     (default: text-embedding-3-small)\n//   SBI_EMBEDDING_BACKEND  — Embedding backend   (default: local)\n//                            Values: local | openai | none\n//   SBI_EMBEDDING_URL      — Local embedding endpoint (default: http://localhost:8080)\n//                            Used when SBI_EMBEDDING_BACKEND=local\n\nexport type AIProvider = 'openai' | 'none';\n\n/**\n * Backend to use for LLM chat completions.\n *\n * - `openai` — OpenAI API (default). Requires OPENAI_API_KEY.\n * - `local`  — Any OpenAI-compatible local server (Ollama, llama.cpp,\n *              vLLM, LM Studio). Uses SBI_LLM_URL as the base endpoint.\n *              OPENAI_API_KEY can be any non-empty string (local servers\n *              typically don't validate it).\n */\nexport type LLMBackend = 'openai' | 'local';\n\n/**\n * Backend to use for text embeddings.\n *\n * - `local`  — Local HTTP embedding service (TEI or Ollama). Preferred for\n *              offline / on-premise deployments. Falls back to Ollama when\n *              TEI is unavailable.\n * - `openai` — OpenAI Embeddings API (requires OPENAI_API_KEY).\n * - `none`   — Disable embeddings entirely; graph + BM25 retrieval only.\n */\nexport type EmbeddingBackend = 'local' | 'openai' | 'none';\n\nexport interface AIConfig {\n  /** AI provider. 'none' means AI features are disabled. */\n  provider: AIProvider;\n  /** API key for the chosen provider. Empty string when AI is disabled. */\n  apiKey: string;\n  /** Chat completion model identifier. */\n  model: string;\n  /**\n   * LLM backend to use for chat completions.\n   *\n   * Defaults to 'openai'. When 'local', the system connects to a local\n   * OpenAI-compatible server at `llmUrl`.\n   */\n  llmBackend: LLMBackend;\n  /**\n   * Base URL for the LLM API.\n   *\n   * Defaults to 'https://api.openai.com/v1' for cloud, or the value of\n   * SBI_LLM_URL for local backends.\n   */\n  llmUrl: string;\n  /**\n   * Maximum tokens of chunk context sent to the LLM per seed investigation.\n   *\n   * Defaults to 100,000 (~80% of a 128K context window). Reduce for local\n   * models with smaller context windows (e.g. 20,000 for 32K models).\n   */\n  tokenBudget: number;\n  /** Text embedding model identifier. */\n  embeddingModel: string;\n  /**\n   * Embedding backend to use.\n   *\n   * Defaults to 'local' so the system prefers a locally-running embedding\n   * service (TEI or Ollama) over the OpenAI API.\n   */\n  embeddingBackend: EmbeddingBackend;\n  /**\n   * Base URL for the local embedding service.\n   *\n   * Used when `embeddingBackend === 'local'`.  Defaults to\n   * `http://localhost:8080` (HuggingFace TEI default port).\n   */\n  embeddingUrl: string;\n  /** Whether AI features are active for this run. */\n  enabled: boolean;\n}\n\nexport interface LoadAIConfigOverrides {\n  /** When true, disable AI features regardless of environment variables. */\n  noAi?: boolean;\n  /** Override the AI provider. Accepts `openai` or `none`. */\n  aiProvider?: string;\n}\n\nfunction resolveRequestedProvider(aiProvider?: string): AIProvider {\n  const normalized = aiProvider?.trim().toLowerCase();\n\n  if (normalized === 'none') {\n    return 'none';\n  }\n\n  return 'openai';\n}\n\nfunction resolveLLMBackend(raw: string | undefined): LLMBackend {\n  const normalized = raw?.trim().toLowerCase();\n  if (normalized === 'local') return 'local';\n  return 'openai'; // default\n}\n\nfunction resolveEmbeddingBackend(raw: string | undefined): EmbeddingBackend {\n  const normalized = raw?.trim().toLowerCase();\n  if (normalized === 'openai') return 'openai';\n  if (normalized === 'none') return 'none';\n  return 'local'; // default\n}\n\n/** Default LLM base URL for OpenAI cloud. */\nconst OPENAI_DEFAULT_URL = 'https://api.openai.com/v1';\n\n/** Default LLM base URL for local backends (Ollama). */\nconst LOCAL_LLM_DEFAULT_URL = 'http://localhost:11434/v1';\n\n/**\n * Loads AI configuration from environment variables, applying optional\n * overrides from CLI flags.\n *\n * AI is enabled when:\n *  - `noAi` is NOT set to true, AND\n *  - The requested provider is not `none`, AND\n *  - Either:\n *    - A non-empty `OPENAI_API_KEY` env var is present (cloud mode), OR\n *    - `SBI_LLM_BACKEND=local` is set (local mode — any API key accepted,\n *      since local servers typically don't validate keys).\n */\nexport function loadAIConfig(overrides: LoadAIConfigOverrides = {}): AIConfig {\n  const { noAi = false, aiProvider } = overrides;\n\n  const apiKey = process.env['OPENAI_API_KEY'] ?? '';\n  const model = process.env['SBI_AI_MODEL'] ?? 'gpt-4o';\n  const llmBackend = resolveLLMBackend(process.env['SBI_LLM_BACKEND']);\n  const embeddingModel = process.env['SBI_EMBEDDING_MODEL'] ?? 'text-embedding-3-small';\n  const embeddingBackend = resolveEmbeddingBackend(process.env['SBI_EMBEDDING_BACKEND']);\n  const embeddingUrl = process.env['SBI_EMBEDDING_URL'] ?? 'http://localhost:8080';\n  const requestedProvider = resolveRequestedProvider(aiProvider);\n\n  // Resolve LLM URL: explicit env var > backend-specific default\n  const llmUrlEnv = process.env['SBI_LLM_URL'] ?? '';\n  const llmUrl = llmUrlEnv.trim().length > 0\n    ? llmUrlEnv.trim()\n    : llmBackend === 'local'\n      ? LOCAL_LLM_DEFAULT_URL\n      : OPENAI_DEFAULT_URL;\n\n  // Token budget: explicit env var > default 100K\n  const tokenBudgetEnv = process.env['SBI_TOKEN_BUDGET'];\n  const tokenBudget = tokenBudgetEnv != null && tokenBudgetEnv.trim().length > 0\n    ? Math.max(1000, parseInt(tokenBudgetEnv, 10) || 100_000)\n    : 100_000;\n\n  const hasKey = apiKey.trim().length > 0;\n\n  // Local backends accept any API key (or a dummy key) since local servers\n  // typically don't validate authentication. Cloud mode requires a real key.\n  const enabled =\n    requestedProvider === 'openai' &&\n    !noAi &&\n    (hasKey || llmBackend === 'local');\n\n  const provider: AIProvider = enabled ? 'openai' : 'none';\n\n  // For local backends without an explicit key, use a placeholder so the\n  // OpenAI client constructor doesn't throw.\n  const effectiveApiKey = hasKey ? apiKey : (llmBackend === 'local' ? 'local' : '');\n\n  return {\n    provider,\n    apiKey: effectiveApiKey,\n    model,\n    llmBackend,\n    llmUrl,\n    tokenBudget,\n    embeddingModel,\n    embeddingBackend,\n    embeddingUrl,\n    enabled,\n  };\n}\n\n/**\n * Returns true when AI features are active for the given config.\n *\n * Convenience wrapper so callers avoid importing the full config shape just\n * to perform a boolean check.\n */\nexport function isAIEnabled(config: AIConfig): boolean {\n  return config.enabled;\n}\n"}],"isError":false,"timestamp":1774116247622}}
+{"type":"message","id":"727039ee","parentId":"d659c9f0","timestamp":"2026-03-21T18:04:07.623Z","message":{"role":"toolResult","toolCallId":"call_vdvMjkOwwQOFqdjlosEkrzNT|fc_0f9932afa4a686050169bedd978474819ba64429d82d09b390","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// LLM Client\n// ---------------------------------------------------------------------------\n//\n// Thin wrapper around the OpenAI chat completions API for structured AI\n// investigations.\n//\n// Design principles:\n// - Never throws — all API/network/parse errors are caught, logged with\n//   console.warn, and returned as empty findings arrays.\n// - Uses JSON mode (response_format: { type: 'json_object' }) to ensure\n//   the model returns valid JSON that can be parsed and validated.\n// - Validates the parsed response through `validateAIFindings` before\n//   returning — invalid findings are dropped, not thrown.\n\nimport OpenAI from 'openai';\nimport type { AIConfig } from './config.js';\nimport type { AIFinding } from './schemas.js';\nimport { validateAIFindings } from './schemas.js';\nimport type { HydeLLMClient } from './hyde.js';\n\n// ---------------------------------------------------------------------------\n// AIFindingResponse\n// ---------------------------------------------------------------------------\n\n/**\n * The response produced by a single LLM investigation call.\n *\n * On API failure, `findings` is empty and `rawResponse` is absent.\n * On JSON parse failure, `findings` is empty and `rawResponse` holds the\n * unparseable string for debugging.\n */\nexport interface AIFindingResponse {\n  /** Validated, sanitised findings. Empty when the call fails or returns nothing useful. */\n  findings: AIFinding[];\n  /** Raw JSON string returned by the model (present even on validation failure). */\n  rawResponse?: string;\n}\n\n// ---------------------------------------------------------------------------\n// LLMClient\n// ---------------------------------------------------------------------------\n\n/**\n * Wraps the OpenAI chat completions API for structured K8s investigation.\n *\n * Implements {@link HydeLLMClient} so it can be passed directly to\n * `generateHypotheticalDocument` without any adapter.\n *\n * Instantiate with a loaded {@link AIConfig} (must have `enabled: true` and a\n * valid `apiKey`). If the config is disabled, callers should not construct\n * this class — use the `isAIEnabled` guard from `config.ts` first.\n *\n * Supports both cloud (OpenAI) and local (Ollama, llama.cpp, vLLM, LM Studio)\n * backends via the `llmUrl` config field. Local backends use an OpenAI-\n * compatible API, so the same client works for both.\n */\nexport class LLMClient implements HydeLLMClient {\n  private readonly client: OpenAI;\n  private readonly model: string;\n\n  constructor(config: AIConfig) {\n    this.client = new OpenAI({\n      apiKey: config.apiKey,\n      baseURL: config.llmUrl,\n    });\n    this.model = config.model;\n  }\n\n  /**\n   * Generates free-form text given a system and user prompt.\n   *\n   * Unlike `investigateSeed`, this method does NOT use JSON mode — the model\n   * response is returned as a plain string.\n   *\n   * **Does not swallow errors** — throws on network/API failure so that\n   * callers (e.g. `generateHypotheticalDocument`) can detect failure and apply\n   * their own fallback logic.\n   *\n   * @param systemPrompt - System-level context for the generation task.\n   * @param userPrompt   - User-facing prompt.\n   * @returns Generated text string.  Empty string if the model returns no content.\n   */\n  async generateText(systemPrompt: string, userPrompt: string): Promise<string> {\n    const response = await this.client.chat.completions.create({\n      model: this.model,\n      messages: [\n        { role: 'system', content: systemPrompt },\n        { role: 'user', content: userPrompt },\n      ],\n    });\n\n    return response.choices[0]?.message?.content ?? '';\n  }\n\n  /**\n   * Calls the LLM with a system + user prompt pair and returns structured\n   * findings.\n   *\n   * Uses `response_format: { type: 'json_object' }` so the model always\n   * returns a JSON object. The response is parsed and validated through\n   * {@link validateAIFindings} before being returned.\n   *\n   * **Graceful degradation**: any error (network, API, JSON parse, validation)\n   * is caught and logged via `console.warn`. The method always resolves, never\n   * rejects.\n   *\n   * @param systemPrompt - System prompt with grounding rules and playbook.\n   * @param userPrompt   - User prompt with hypothesis, chunks, and schema.\n   * @returns AIFindingResponse — validated findings + optional raw response.\n   */\n  async investigateSeed(\n    systemPrompt: string,\n    userPrompt: string,\n  ): Promise<AIFindingResponse> {\n    let rawResponse: string | undefined;\n\n    try {\n      const response = await this.client.chat.completions.create({\n        model: this.model,\n        response_format: { type: 'json_object' },\n        messages: [\n          { role: 'system', content: systemPrompt },\n          { role: 'user', content: userPrompt },\n        ],\n      });\n\n      rawResponse = response.choices[0]?.message?.content ?? '{}';\n\n      let parsed: unknown;\n      try {\n        parsed = JSON.parse(rawResponse);\n      } catch (parseError) {\n        console.warn(\n          `[LLMClient] Failed to parse JSON response: ${parseError instanceof Error ? parseError.message : String(parseError)}`,\n        );\n        return { findings: [], rawResponse };\n      }\n\n      // Extract the `findings` array from the parsed JSON object\n      const rawFindings =\n        parsed !== null &&\n        typeof parsed === 'object' &&\n        !Array.isArray(parsed) &&\n        'findings' in parsed\n          ? (parsed as Record<string, unknown>)['findings']\n          : [];\n\n      const findings = validateAIFindings(rawFindings);\n\n      return { findings, rawResponse };\n    } catch (error) {\n      console.warn(\n        `[LLMClient] API call failed: ${error instanceof Error ? error.message : String(error)}`,\n      );\n      return { findings: [] };\n    }\n  }\n}\n"}],"isError":false,"timestamp":1774116247622}}
+{"type":"message","id":"cf4d0a02","parentId":"727039ee","timestamp":"2026-03-21T18:04:07.623Z","message":{"role":"toolResult","toolCallId":"call_l1exe1wj1BtLRpEMUHU3Cgc7|fc_0f9932afa4a686050169bedd978478819b8d98dce7c83be88d","toolName":"read","content":[{"type":"text","text":"// ---------------------------------------------------------------------------\n// AI Investigator\n// ---------------------------------------------------------------------------\n//\n// Implements an AI-powered investigation flow that augments the heuristic\n// pipeline with graph traversal and lexical retrieval.\n//\n// Design principles:\n// - Graph-first: `getRelatedChunks` provides the deterministic precision floor.\n// - Lexical expansion: `LexicalSearchIndex.search` adds supplementary evidence.\n// - Grounded findings: every AI finding must cite evidence from provided chunks.\n// - Graceful degradation: LLM errors are caught and logged; the pipeline\n//   continues with remaining seeds rather than aborting.\n// - Category-specific playbooks: each seed's category routes to the right\n//   investigation playbook via `buildInvestigationPrompt`.\n\nimport type { Finding, Evidence, GraphEdge } from '../types/index.js';\nimport type { InvestigatorContext, InvestigatorResult, InvestigationSeed } from './types.js';\nimport type { LLMClient } from '../ai/llm-client.js';\nimport type { IndexedChunk } from '../ai/chunk-indexer.js';\nimport type { ResourceRelationshipGraph } from '../graph/resource-graph.js';\nimport type { LexicalSearchIndex } from '../ai/lexical-search.js';\nimport type { AIFinding, AIFindingEvidence } from '../ai/schemas.js';\nimport type { EmbeddingClientInterface } from '../ai/embeddings.js';\nimport type { VectorStore } from '../ai/vector-store.js';\nimport type { DiagnosticGraph } from '../graph/diagnostic-graph.js';\nimport { validateAIFindings } from '../ai/schemas.js';\nimport { getRelatedChunks } from '../graph/resource-graph.js';\nimport type { GraphScoredChunk } from '../graph/resource-graph.js';\nimport { traverseForChunks, RETRIEVAL_EDGE_TYPES, isDiagnosticGraph } from '../graph/traversal.js';\nimport { buildInvestigationPrompt } from '../ai/prompts.js';\nimport { estimateTokens } from '../ai/chunk-indexer.js';\nimport { generateHypotheticalDocument } from '../ai/hyde.js';\n\n// ---------------------------------------------------------------------------\n// Constants\n// ---------------------------------------------------------------------------\n\n/** Maximum number of seeds to investigate per AI invocation (configurable). */\nexport const DEFAULT_MAX_SEEDS = 10;\n\n/**\n * Maximum number of chunks sent to the LLM per seed call.\n *\n * Graph hits are included first (highest precision), then lexical hits fill\n * the remaining slots. Capped to keep the context window manageable.\n */\nconst MAX_CHUNKS_PER_SEED = 20;\n\n/** Number of lexical search results to retrieve per seed. */\nconst LEXICAL_TOP_K = 10;\n\n// ---------------------------------------------------------------------------\n// Seed-specific graph traversal parameters\n// ---------------------------------------------------------------------------\n\n/**\n * Hard cap on the number of graph nodes returned from traversal, regardless\n * of depth. Prevents breadth explosion in large, well-connected graphs.\n *\n * 30 nodes covers:\n * - 1 starting pod\n * - 5-8 direct deps (secrets, configmaps, events, deployment)\n * - 10-15 depth-2 nodes (sibling pods, remote services)\n * - 5-10 depth-3/4 nodes (remote pod deps)\n */\nexport const MAX_GRAPH_NODES = 30;\n\n/**\n * Minimum edge weight for graph traversal. Edges below this threshold are\n * not followed. Prunes near-zero temporal-correlation edges (those at the\n * extreme end of the 60-second window) while preserving all structural edges\n * (which default to weight 1.0).\n *\n * At 0.1, a temporal-correlation edge is pruned only when the time delta\n * exceeds ~54 seconds (weight = 1 - 54/60 = 0.1). Everything closer passes.\n */\nexport const GRAPH_MIN_WEIGHT = 0.1;\n\n/**\n * Returns the optimal graph traversal depth for a seed based on its category.\n *\n * Depth is tuned per category based on the typical K8s graph path length\n * from the seed's starting node to the evidence that explains the failure:\n *\n * | Category | Depth | Reasoning |\n * |---|---|---|\n * | kubernetes | 3 | Pod → deps(1) → Deployment/sibling-pods(2) → sibling-events(3) |\n * | connectivity | 4 | Pod → ConfigMap(1) → remote-Service(2) → remote-Pod(3) → remote-deps(4) |\n * | configuration | 2 | Pod → Secret/ConfigMap(1) → ExternalSecret(2). Direct refs only. |\n * | log | 2 | Pod → deps(1) → owner(2). BM25 handles log-to-evidence correlation. |\n *\n * Returns 3 as a safe default for any unrecognised category.\n */\nexport function maxDepthForSeed(seed: InvestigationSeed): number {\n  switch (seed.category) {\n    case 'kubernetes':     return 3;\n    case 'connectivity':   return 4;\n    case 'configuration':  return 2;\n    case 'log':            return 2;\n    default:               return 3;\n  }\n}\n\n/**\n * Number of semantic (vector) search results to retrieve per seed.\n *\n * Semantic hits are appended at lower priority than graph/lexical hits and are\n * capped separately to limit noise contribution to the merged context.\n */\nconst SEMANTIC_TOP_K = 5;\n\n/**\n * Default token budget for merged context sent to the LLM per seed call.\n *\n * Set to ~80 % of a 128 k-token context window (128 × 1 024 × 0.8 ≈ 104 k).\n * Lower-priority chunks (those ranked later by RRF) fall back to their\n * {@link IndexedChunk.summary} content once the cumulative estimated token\n * count would exceed this limit.\n *\n * Exported so callers can override the budget for testing or for models with\n * different context window sizes.\n */\nexport const DEFAULT_TOKEN_BUDGET = 100_000;\n\n// ---------------------------------------------------------------------------\n// AIInvestigatorDeps\n// ---------------------------------------------------------------------------\n\n/**\n * External dependencies required by the AI investigator.\n *\n * The four required deps (llmClient, chunkIndex, resourceGraph, lexicalIndex)\n * form the deterministic precision floor. The two optional deps\n * (embeddingClient, vectorStore) add semantic expansion — if absent,\n * investigation proceeds with graph + lexical results only.\n */\nexport interface AIInvestigatorDeps {\n  /** LLM client for structured investigation calls. */\n  llmClient: LLMClient;\n  /** Pre-built flat chunk index from `buildChunkIndex`. */\n  chunkIndex: IndexedChunk[];\n  /** Pre-built K8s resource relationship graph (backward-compat adapter). */\n  resourceGraph: ResourceRelationshipGraph;\n  /**\n   * Unified DiagnosticGraph with label-selector, service-selector, temporal,\n   * and causal edges. When present, graph retrieval uses the richer\n   * `traverseForChunks` instead of the legacy `getRelatedChunks` BFS.\n   */\n  diagnosticGraph?: DiagnosticGraph;\n  /** Pre-built lexical inverted index from `LexicalSearchIndex.build`. */\n  lexicalIndex: LexicalSearchIndex;\n  /**\n   * Optional embedding client for semantic query expansion.\n   *\n   * When present, the seed hypothesis is embedded and the resulting vector is\n   * used to retrieve semantically similar chunks from `vectorStore`. Semantic\n   * hits are appended at lower priority than graph and lexical hits.\n   *\n   * If absent (or if embedding fails), investigation continues without semantic\n   * expansion.\n   */\n  embeddingClient?: EmbeddingClientInterface;\n  /**\n   * Optional pre-built vector store populated with chunk embeddings.\n   *\n   * Only consulted when `embeddingClient` is also present. If absent, semantic\n   * retrieval is skipped.\n   */\n  vectorStore?: VectorStore;\n  /**\n   * Maximum tokens of chunk context sent to the LLM per seed investigation.\n   *\n   * Defaults to {@link DEFAULT_TOKEN_BUDGET} (~100K). Reduce for local models\n   * with smaller context windows (e.g. 20,000 for 32K context models).\n   */\n  tokenBudget?: number;\n  /**\n   * When `true`, log per-seed retrieval statistics to stdout.\n   *\n   * Output format:\n   * `[AIInvestigator] Seed: {hypothesis} → {N} graph, {M} lexical, {K} semantic chunks across {T} artifact types`\n   */\n  verbose?: boolean;\n  /**\n   * Optional callback invoked before each seed investigation begins.\n   * Used by the TUI to show per-seed progress during the AI phase.\n   */\n  onSeedProgress?: (\n    seedIndex: number,\n    seedTotal: number,\n    seedLabel: string,\n  ) => void;\n}\n\n// ---------------------------------------------------------------------------\n// Shared counter type\n// ---------------------------------------------------------------------------\n\ninterface Counter {\n  value: number;\n}\n\n// ---------------------------------------------------------------------------\n// DiagnosticGraph seed → node ID resolution\n// ---------------------------------------------------------------------------\n\n/**\n * Resolves a seed to one or more starting node IDs in the DiagnosticGraph.\n *\n * Strategy:\n * 1. Parse `Pod/<ns>/<name>` components from the seed source (from seed.id or\n *    hypothesis text) to get concrete K8s node IDs.\n * 2. Fall back to identifier extraction from the hypothesis text: look for\n *    known resource names that appear as graph nodes.\n * 3. If nothing matches, return an empty array (caller falls back to BFS path).\n *\n * Node ID format in DiagnosticGraph: `{Kind}:{namespace}/{name}`\n */\nfunction resolveSeedStartNodes(\n  seed: InvestigationSeed,\n  graph: DiagnosticGraph,\n): string[] {\n  const nodeIds: string[] = [];\n\n  // Extract Pod/namespace/name patterns from the seed source or hypothesis\n  const combinedText = `${seed.source} ${seed.hypothesis}`;\n\n  // Pattern: Pod/<namespace>/<name> from seed.source (set by seed generator)\n  const podPattern = /Pod\\/([^/\\s]+)\\/([^/\\s,]+)/g;\n  let match: RegExpExecArray | null;\n  while ((match = podPattern.exec(combinedText)) !== null) {\n    const ns = match[1]!;\n    const name = match[2]!;\n    const nodeId = `Pod:${ns}/${name}`;\n    if (graph.getNode(nodeId) && !nodeIds.includes(nodeId)) nodeIds.push(nodeId);\n  }\n\n  // Pattern: extract bare resource names from seed hypothesis that match graph node names\n  if (nodeIds.length === 0) {\n    const hypothesis = seed.hypothesis.toLowerCase();\n    for (const [id, node] of graph.nodes) {\n      if (node.nodeType !== 'resource' && node.nodeType !== 'workload-group') continue;\n      const data = node.data as { name?: string };\n      const name = (data.name ?? '').toLowerCase();\n      if (name.length > 2 && hypothesis.includes(name)) {\n        if (!nodeIds.includes(id)) nodeIds.push(id);\n        if (nodeIds.length >= 3) break; // cap to avoid over-broad traversal\n      }\n    }\n  }\n\n  return nodeIds;\n}\n\nfunction nextFindingId(category: string, counter: Counter): string {\n  return `finding:ai:${category}:${counter.value++}`;\n}\n\nfunction nextEdgeId(counter: Counter): string {\n  return `edge:ai:${counter.value++}`;\n}\n\n// ---------------------------------------------------------------------------\n// affectedComponents normalization (7.3)\n// ---------------------------------------------------------------------------\n\n/**\n * Kind aliases used when normalizing LLM-generated component strings.\n *\n * Maps every lowercase variant the LLM might produce to the canonical\n * PascalCase Kubernetes Kind name.\n */\nconst KIND_ALIASES: Record<string, string> = {\n  pod: 'Pod',\n  deployment: 'Deployment',\n  statefulset: 'StatefulSet',\n  daemonset: 'DaemonSet',\n  replicaset: 'ReplicaSet',\n  service: 'Service',\n  secret: 'Secret',\n  configmap: 'ConfigMap',\n  persistentvolumeclaim: 'PersistentVolumeClaim',\n  pvc: 'PersistentVolumeClaim',\n  job: 'Job',\n  cronjob: 'CronJob',\n  ingress: 'Ingress',\n  namespace: 'Namespace',\n  node: 'Node',\n};\n\n/**\n * Normalizes a single `affectedComponents` entry from an LLM-generated AI\n * finding to the canonical `Kind/namespace/name` format used throughout the\n * pipeline.\n *\n * Handles the common LLM variant: lowercase kind prefix (e.g.\n * `pod/default/app-pod` → `Pod/default/app-pod`).  Already-correct entries\n * (`Pod/default/app-pod`) are returned unchanged.\n */\nfunction normalizeAffectedComponent(component: string): string {\n  const trimmed = component.trim();\n  const slashIdx = trimmed.indexOf('/');\n  if (slashIdx === -1) return trimmed; // no slash → can't infer Kind, leave as-is\n\n  const rawKind = trimmed.slice(0, slashIdx).toLowerCase();\n  const rest    = trimmed.slice(slashIdx + 1);\n\n  const canonical = KIND_ALIASES[rawKind];\n  if (canonical === undefined) return trimmed; // unknown kind, leave as-is\n\n  return `${canonical}/${rest}`;\n}\n\n// ---------------------------------------------------------------------------\n// Grounding score (7.1 + 7.2)\n// ---------------------------------------------------------------------------\n\n/** Confidence penalty applied per ungrounded evidence citation. */\nexport const UNGROUNDED_PENALTY = 0.10;\n\n/**\n * Applies a grounding penalty to a finding's confidence based on how many of\n * its evidence items cite paths that were actually retrieved.\n *\n * Rules:\n * - When `retrievedCount === 0` (nothing was retrieved for this seed) no\n *   grounding check is meaningful — return the confidence unchanged.\n * - When `retrievedCount > 0` and `groundedCount === 0` (the LLM cited ONLY\n *   paths not in the retrieved set), the finding is hallucinatory — return\n *   `null` to signal that the caller should drop it.\n * - Otherwise apply `-UNGROUNDED_PENALTY` per ungrounded citation and clamp\n *   the result to `[0, 1]`.\n *\n * @param confidence     - Raw confidence from the LLM (`[0, 1]`).\n * @param groundedCount  - Number of evidence items that matched a retrieved chunk.\n * @param ungroundedCount- Number of evidence items that did NOT match.\n * @param retrievedCount - Total number of chunks retrieved for this seed.\n * @returns Adjusted confidence, or `null` if the finding should be dropped.\n */\n\n[645 more lines in file. Use offset=341 to continue.]"}],"isError":false,"timestamp":1774116247623}}
+{"type":"message","id":"631f7cfa","parentId":"cf4d0a02","timestamp":"2026-03-21T18:04:07.623Z","message":{"role":"toolResult","toolCallId":"call_2fe5lKk3NGllDzlNY8W0A2MV|fc_0f9932afa4a686050169bedd978480819bb6b4ae8642869106","toolName":"read","content":[{"type":"text","text":"import * as fsp from 'fs/promises';\nimport * as os from 'os';\nimport * as path from 'path';\nimport { extractBundle, profileBundle } from '../ingestion/index.js';\nimport {\n  parseAnalyzerFile,\n  mergeAnalyzerResults,\n  parseResourceFile,\n  parseEventFile,\n  identifyLogFiles,\n  parseLogFile,\n  parseHelmReleaseFile,\n  sortEventsByTime,\n} from '../parsers/index.js';\nimport type { HelmRelease } from '../parsers/index.js';\nimport {\n  InvestigationGraphImpl,\n  buildDiagnosticGraph,\n  buildWorkloadGroups,\n  addTemporalCorrelationEdges,\n  addTemporalSequenceEdges,\n  asResourceRelationshipGraph,\n} from '../graph/index.js';\nimport type {\n  AnalyzerResult,\n  BundleProfile,\n  Evidence,\n  Finding,\n  FindingTreeNode,\n  K8sEvent,\n  K8sResource,\n} from '../types/index.js';\nimport type { LogFile } from '../parsers/index.js';\nimport { runInvestigation } from '../investigators/index.js';\nimport type { AIInvestigatorDeps } from '../investigators/index.js';\nimport { loadAIConfig, isAIEnabled, buildChunkIndex, LexicalSearchIndex, LLMClient, createEmbeddingClient, VectorStore, lateChunkEmbed } from '../ai/index.js';\nimport type { EmbeddingClientInterface, LateChunkEmbeddingClient } from '../ai/index.js';\nimport {\n  createTrace,\n  startTraceStep,\n  completeTraceStep,\n  completeTrace,\n} from './trace.js';\nimport type { InvestigationTrace } from './trace.js';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\nexport type PipelineStepStatus = 'started' | 'completed';\n\nexport interface PipelineProgressEvent {\n  /** Name of the pipeline step (matches trace step names: 'extract', 'profile', 'parse-analyzers', 'parse-resources', 'parse-events', 'parse-logs', 'ai-index', 'build-graph', 'investigate'). */\n  step: string;\n  /** Whether the step just started or just completed. */\n  status: PipelineStepStatus;\n  /** Number of artifacts processed (only set when status is 'completed'). */\n  artifactsProcessed?: number;\n  /** Optional detail message for sub-step progress (e.g. per-seed AI investigation). */\n  detail?: string;\n}\n\nexport interface PipelineOptions {\n  outputDir?: string;\n  format?: 'json' | 'text' | 'summary' | 'markdown' | 'html';\n  verbose?: boolean;\n  trace?: boolean;\n  /** When true, AI features are disabled regardless of API key presence. */\n  noAi?: boolean;\n  /** Optional callback invoked when each pipeline step starts and completes. */\n  onProgress?: (event: PipelineProgressEvent) => void;\n}\n\n/**\n * AI mode label describing how the AI layer was configured for this run.\n *\n * - `'cloud'` — LLM calls go to OpenAI (or another cloud provider).\n * - `'local'` — LLM calls go to a local server (Ollama, llama.cpp, etc.).\n * - `'off'`   — AI features disabled (heuristic-only mode).\n */\nexport type AIMode = 'cloud' | 'local' | 'off';\n\nexport interface PipelineResult {\n  profile: BundleProfile;\n  analyzerResults: AnalyzerResult[];\n  resources: K8sResource[];\n  events: K8sEvent[];\n  logs: LogFile[];\n  /** Verified, deduplicated findings produced by the investigation pipeline. */\n  findings: Finding[];\n  /** Causal tree built from findings and 'causes' graph edges. */\n  findingTree: FindingTreeNode[];\n  graph: InvestigationGraphImpl;\n  trace: InvestigationTrace;\n  /** How the AI layer was configured: 'cloud', 'local', or 'off'. */\n  aiMode: AIMode;\n}\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfunction log(message: string, verbose: boolean): void {\n  if (verbose) {\n    console.log(`[pipeline] ${message}`);\n  }\n}\n\nfunction emitProgress(options: PipelineOptions, event: PipelineProgressEvent): void {\n  options.onProgress?.(event);\n}\n\nfunction addInvestigationEvidenceNode(\n  graph: InvestigationGraphImpl,\n  nodeId: string,\n  evidence: Evidence,\n): boolean {\n  if (graph.getNode(nodeId)) {\n    return false;\n  }\n\n  graph.addNode({\n    id: nodeId,\n    type: 'evidence',\n    data: evidence,\n    metadata: {\n      category: evidence.artifactType ?? 'unknown',\n      timestamp: evidence.timestamp,\n      derived: true,\n    },\n  });\n\n  return true;\n}\n\nfunction addInvestigationEvidenceNodes(\n  graph: InvestigationGraphImpl,\n  findings: Finding[],\n): number {\n  let addedCount = 0;\n\n  for (const finding of findings) {\n    for (const evidence of finding.evidence) {\n      if (addInvestigationEvidenceNode(graph, `evidence:${evidence.path}`, evidence)) {\n        addedCount++;\n      }\n    }\n  }\n\n  return addedCount;\n}\n\nfunction ensureInvestigationEdgeEndpoints(\n  graph: InvestigationGraphImpl,\n  findings: Finding[],\n  investigationEdges: ReadonlyArray<{ source: string; target: string }>,\n): number {\n  let addedCount = 0;\n  const evidenceByPath = new Map<string, Evidence>();\n\n  for (const finding of findings) {\n    for (const evidence of finding.evidence) {\n      evidenceByPath.set(`evidence:${evidence.path}`, evidence);\n    }\n  }\n\n  for (const edge of investigationEdges) {\n    for (const nodeId of [edge.source, edge.target]) {\n      if (!nodeId.startsWith('evidence:') || graph.getNode(nodeId)) {\n        continue;\n      }\n\n      const basePath = nodeId.split(':').slice(0, 2).join(':');\n      const baseEvidence = evidenceByPath.get(basePath);\n      const placeholderEvidence: Evidence = baseEvidence\n        ? {\n            ...baseEvidence,\n            note: `${baseEvidence.note} (derived graph node: ${nodeId})`,\n          }\n        : {\n            path: nodeId.slice('evidence:'.length),\n            note: `Derived investigation evidence node for ${nodeId}`,\n            artifactType: 'unknown',\n          };\n\n      if (addInvestigationEvidenceNode(graph, nodeId, placeholderEvidence)) {\n        addedCount++;\n      }\n    }\n  }\n\n  return addedCount;\n}\n\n// ---------------------------------------------------------------------------\n// Pipeline\n// ---------------------------------------------------------------------------\n\n/**\n * Runs the full analysis pipeline on a support bundle archive.\n *\n * Steps:\n * 1. Extract bundle archive → BundleManifest\n * 2. Profile bundle → BundleProfile (classify artifacts)\n * 3. Parse analyzer files → AnalyzerResult[]\n * 4. Parse K8s resource files → K8sResource[]\n * 5. Parse event files → K8sEvent[]\n * 6. Parse log files → LogFile[]\n * 7. (AI only) Build chunk index + lexical index + LLM client → AIInvestigatorDeps\n * 8. Build the base investigation graph from parsed artifacts\n * 9. Run the investigation orchestrator → findings + graph updates\n * 10. Complete the investigation trace\n *\n * @param bundlePath - Path to the `.tar.gz` support bundle archive.\n * @param options    - Optional pipeline configuration.\n */\nexport async function analyzeBundlePipeline(\n  bundlePath: string,\n  options: PipelineOptions = {},\n): Promise<PipelineResult> {\n  const { verbose = false } = options;\n  const trace = createTrace(path.resolve(bundlePath));\n\n  // `outputDir` is reserved for user-facing artifacts (findings.json, report.md,\n  // report.html, trace.json).  Bundle extraction always uses an internal temp\n  // directory so cleanup does not delete user-requested outputs.\n\n  // ── 1. Extract bundle ─────────────────────────────────────────────────────\n  const step1 = startTraceStep(trace, 'extract');\n  emitProgress(options, { step: 'extract', status: 'started' });\n  log('Extracting bundle…', verbose);\n\n  const manifest = await extractBundle(bundlePath);\n\n  completeTraceStep(trace, step1, manifest.files.length);\n  emitProgress(options, { step: 'extract', status: 'completed', artifactsProcessed: manifest.files.length });\n  log(`Extracted ${manifest.files.length} files`, verbose);\n\n  // ── 2. Profile bundle ─────────────────────────────────────────────────────\n  const step2 = startTraceStep(trace, 'profile');\n  emitProgress(options, { step: 'profile', status: 'started' });\n  log('Profiling bundle…', verbose);\n\n  const profile = await profileBundle(manifest);\n\n  completeTraceStep(trace, step2, profile.manifest.files.length);\n  emitProgress(options, { step: 'profile', status: 'completed', artifactsProcessed: profile.manifest.files.length });\n  log(\n    `Profile: ${profile.analyzerCount} analyzers, ` +\n      `${profile.resourceCount} resources, ` +\n      `${profile.eventCount} events, ` +\n      `${profile.logFileCount} logs`,\n    verbose,\n  );\n\n  // ── 3. Parse analyzer files ───────────────────────────────────────────────\n  const step3 = startTraceStep(trace, 'parse-analyzers');\n  emitProgress(options, { step: 'parse-analyzers', status: 'started' });\n  log('Parsing analyzer files…', verbose);\n\n  const analyzerFiles = profile.manifest.files.filter((f) => f.category === 'analyzer');\n  const analyzerBatches = await Promise.all(\n    analyzerFiles.map((f) => parseAnalyzerFile(f.absolutePath)),\n  );\n  const analyzerResults = mergeAnalyzerResults(analyzerBatches);\n\n  completeTraceStep(trace, step3, analyzerResults.length);\n  emitProgress(options, { step: 'parse-analyzers', status: 'completed', artifactsProcessed: analyzerResults.length });\n  log(`Parsed ${analyzerResults.length} analyzer results`, verbose);\n\n  // ── 4. Parse K8s resource files ───────────────────────────────────────────\n  const step4 = startTraceStep(trace, 'parse-resources');\n  emitProgress(options, { step: 'parse-resources', status: 'started' });\n  log('Parsing Kubernetes resource files…', verbose);\n\n  const resourceFiles = profile.manifest.files.filter(\n    (f) => f.category === 'kubernetes-resource',\n  );\n  const resourceBatches = await Promise.all(\n    resourceFiles.map((f) => parseResourceFile(f.absolutePath)),\n  );\n  const resources = resourceBatches.flat();\n\n  // Build a source-file map so chunk IDs use actual bundle paths instead of\n  // fabricated per-resource paths.  Each resource keeps the reference identity\n  // from the batch, so Map lookup by reference works correctly.\n  const resourceSourceFiles = new Map<K8sResource, string>();\n  for (let i = 0; i < resourceFiles.length; i++) {\n    const file = resourceFiles[i]!;\n    const batch = resourceBatches[i] ?? [];\n    for (const resource of batch) {\n      resourceSourceFiles.set(resource, file.relativePath);\n    }\n  }\n\n  completeTraceStep(trace, step4, resources.length);\n  emitProgress(options, { step: 'parse-resources', status: 'completed', artifactsProcessed: resources.length });\n  log(`Parsed ${resources.length} K8s resources`, verbose);\n\n  // ── 5. Parse event files ─────────────────────────────────────────────────\n  const step5 = startTraceStep(trace, 'parse-events');\n  emitProgress(options, { step: 'parse-events', status: 'started' });\n  log('Parsing event files…', verbose);\n\n  const eventFiles = profile.manifest.files.filter((f) => f.category === 'event');\n  const eventBatches = await Promise.all(\n    eventFiles.map((f) => parseEventFile(f.absolutePath)),\n  );\n  const events = sortEventsByTime(eventBatches.flat());\n\n  completeTraceStep(trace, step5, events.length);\n  emitProgress(options, { step: 'parse-events', status: 'completed', artifactsProcessed: events.length });\n  log(`Parsed ${events.length} K8s events`, verbose);\n\n  // ── 6. Parse log files ────────────────────────────────────────────────────\n  const step6 = startTraceStep(trace, 'parse-logs');\n  emitProgress(options, { step: 'parse-logs', status: 'started' });\n  log('Parsing log files…', verbose);\n\n  const logEntries = identifyLogFiles(profile.manifest);\n  const logs = await Promise.all(logEntries.map((f) => parseLogFile(f.absolutePath)));\n\n  completeTraceStep(trace, step6, logs.length);\n  emitProgress(options, { step: 'parse-logs', status: 'completed', artifactsProcessed: logs.length });\n  log(`Parsed ${logs.length} log files`, verbose);\n\n  // ── 6b. Parse Helm release files ─────────────────────────────────────────\n  const helmFiles = profile.manifest.files.filter((f) => f.category === 'helm-release');\n  const helmBatches = await Promise.all(\n    helmFiles.map((f) => parseHelmReleaseFile(f.absolutePath)),\n  );\n  const helmReleases: HelmRelease[] = helmBatches.flat();\n  log(`Parsed ${helmReleases.length} Helm releases`, verbose);\n\n  // ── 7. Build AI chunk index and lexical index (optional, AI-gated) ────────\n  let aiDeps: AIInvestigatorDeps | undefined;\n\n  const aiConfig = loadAIConfig({ noAi: options.noAi });\n  if (isAIEnabled(aiConfig)) {\n    const stepAI = startTraceStep(trace, 'ai-index');\n\n[341 more lines in file. Use offset=341 to continue.]"}],"isError":false,"timestamp":1774116247623}}
