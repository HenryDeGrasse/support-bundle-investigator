+
+    // One occurrence of the common term 'default'
+    const commonChunk = makeChunk({
+      id: 'idf-common-chunk',
+      content: 'pod running in default namespace',
+      identifiers: [],
+      artifactCategory: 'kubernetes-resource',
+      summary: 'Common term chunk',
