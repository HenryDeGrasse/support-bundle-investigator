+{"type":"message","id":"342c31c0","parentId":"3e00b872","timestamp":"2026-03-21T13:38:53.575Z","message":{"role":"toolResult","toolCallId":"call_MiH5MdMBemXBsrheUPP3FkGX|fc_0e22c3c104fdf4860169be9f6d6998819bb92872081feac6a2","toolName":"read","content":[{"type":"text","text":"import type { HypothesisCategory } from './hypothesis-types.js';\n\n// ---------------------------------------------------------------------------\n// HypothesisTemplate types\n// ---------------------------------------------------------------------------\n\n/**\n * A rule describing evidence patterns that support or contradict a particular\n * hypothesis. Co-located with the template so that adding a new symptom type\n * requires no procedural code — just a new registry entry.\n */\nexport interface EvidenceRule {\n  /** Human-readable label for this rule (used in diagnostics / traces). */\n  label: string;\n  /**\n   * Regex pattern matched against evidence notes and finding titles.\n   * Case-insensitive matching is used.\n   */\n  pattern: string;\n  /** Whether the pattern is supporting or contradicting evidence. */\n  type: 'supporting' | 'contradicting';\n}\n\n/**\n * A single hypothesis definition within a template. Pure data — no code.\n */\nexport interface HypothesisDefinition {\n  /** Unique suffix appended to the symptom key to build the hypothesis id. */\n  idSuffix: string;\n  /** The root-cause category of this hypothesis. */\n  category: HypothesisCategory;\n  /** Human-readable root-cause description. */\n  rootCause: string;\n  /** Evidence rules co-located with this hypothesis. */\n  evidenceRules: EvidenceRule[];\n}\n\n/**\n * A declarative hypothesis template mapping a symptom pattern to a set of\n * competing hypotheses. Each template is pure data — adding a new template\n * requires no new TypeScript code, just a new entry in\n * {@link HYPOTHESIS_TEMPLATE_REGISTRY}.\n */\nexport interface HypothesisTemplate {\n  /** Unique identifier for this template (e.g. `'crashloop'`). */\n  id: string;\n  /** Human-readable name for this template. */\n  name: string;\n  /**\n   * Regex patterns matched against the finding text corpus (title + evidence\n   * + reasoning) to determine whether this template applies.\n   * Case-insensitive matching is used. If **any** pattern matches, the\n   * template is selected.\n   */\n  symptomPatterns: string[];\n  /**\n   * Description template for the symptom. Placeholders:\n   * - `{name}` — pod/resource name\n   * - `{namespace}` — Kubernetes namespace\n   */\n  symptomDescriptionTemplate: string;\n  /**\n   * Prefix used in the symptom key, e.g. `'pod-crashloop'` produces\n   * `pod-crashloop:default/app-pod`.\n   */\n  symptomKeyPrefix: string;\n  /** Competing hypothesis definitions for this symptom type. */\n  hypotheses: HypothesisDefinition[];\n}\n\n// ---------------------------------------------------------------------------\n// Template registry — all templates as data\n// ---------------------------------------------------------------------------\n\n/**\n * The global hypothesis template registry.\n *\n * Every entry defines one symptom type and its competing hypotheses purely as\n * data. Adding a new symptom type (e.g. `'oom-kill'`) requires **no** new\n * TypeScript code — just append a new entry to this array.\n *\n * Templates are evaluated in order; the first matching template wins.\n */\nexport const HYPOTHESIS_TEMPLATE_REGISTRY: readonly HypothesisTemplate[] = [\n  // ── CrashLoopBackOff ────────────────────────────────────────────────────\n  {\n    id: 'crashloop',\n    name: 'CrashLoopBackOff',\n    symptomPatterns: [\n      'crashloopbackoff',\n      'crashloop',\n      'back-off restarting failed container',\n    ],\n    symptomKeyPrefix: 'pod-crashloop',\n    symptomDescriptionTemplate:\n      \"Pod '{name}' is in CrashLoopBackOff in namespace '{namespace}'\",\n    hypotheses: [\n      {\n        idSuffix: 'missing-secret',\n        category: 'missing-secret',\n        rootCause:\n          'A required Kubernetes Secret or key is absent, causing the container to fail on startup',\n        evidenceRules: [\n          {\n            label: 'FailedMount event referencing Secret',\n            pattern: 'failedmount.*secret|secret.*not found|missing.*secret',\n            type: 'supporting',\n          },\n          {\n            label: 'Secret exists and is mounted',\n            pattern: 'secret.*mounted|secret.*found|secret.*exists',\n            type: 'contradicting',\n          },\n        ],\n      },\n      {\n        idSuffix: 'config-error',\n        category: 'config-error',\n        rootCause:\n          'A ConfigMap value or environment variable is misconfigured, causing the application to exit at startup',\n        evidenceRules: [\n          {\n            label: 'ConfigMap not found or key missing',\n            pattern: 'configmap.*not found|key.*missing|invalid.*config',\n            type: 'supporting',\n          },\n          {\n            label: 'ConfigMap is valid',\n            pattern: 'configmap.*valid|config.*correct',\n            type: 'contradicting',\n          },\n        ],\n      },\n      {\n        idSuffix: 'dns-failure',\n        category: 'dns-failure',\n        rootCause:\n          'A dependency hostname required during startup cannot be resolved, causing the application to fail and restart',\n        evidenceRules: [\n          {\n            label: 'DNS resolution error in logs',\n            pattern: 'dns.*fail|nslookup.*fail|could not resolve|name resolution',\n            type: 'supporting',\n          },\n          {\n            label: 'DNS resolution succeeds',\n            pattern: 'dns.*success|resolved.*successfully',\n            type: 'contradicting',\n          },\n        ],\n      },\n      {\n        idSuffix: 'oom-kill',\n        category: 'oom-kill',\n        rootCause:\n          'The container is being killed by the OOM killer because it exceeds its memory limit',\n        evidenceRules: [\n          {\n            label: 'OOMKilled exit reason',\n            pattern: 'oomkilled|oom.*kill|out of memory|exit code 137',\n            type: 'supporting',\n          },\n          {\n            label: 'Memory usage well below limit',\n            pattern: 'memory.*below.*limit|memory.*within.*limit',\n            type: 'contradicting',\n          },\n        ],\n      },\n      {\n        idSuffix: 'generic-crash',\n        category: 'generic-crash',\n        rootCause:\n          'The application has an unclassified bug causing it to crash immediately on startup',\n        evidenceRules: [\n          {\n            label: 'Non-zero exit code',\n            pattern: 'exit code [1-9]|exited with|fatal.*error|panic',\n            type: 'supporting',\n          },\n        ],\n      },\n    ],\n  },\n\n  // ── ImagePullBackOff ────────────────────────────────────────────────────\n  {\n    id: 'imagepull',\n    name: 'ImagePullBackOff',\n    symptomPatterns: [\n      'imagepullbackoff',\n      'errimagepull',\n      'image pull',\n      'failed to pull image',\n      'back-off pulling image',\n    ],\n    symptomKeyPrefix: 'pod-imagepull',\n    symptomDescriptionTemplate:\n      \"Pod '{name}' cannot pull its container image in namespace '{namespace}'\",\n    hypotheses: [\n      {\n        idSuffix: 'image-pull-failure:bad-tag',\n        category: 'image-pull-failure',\n        rootCause:\n          'The image tag does not exist in the container registry (wrong, misspelled, or deleted tag)',\n        evidenceRules: [\n          {\n            label: 'Tag not found error',\n            pattern: 'not found|manifest unknown|tag.*invalid|tag.*missing',\n            type: 'supporting',\n          },\n          {\n            label: 'Image tag verified to exist',\n            pattern: 'tag.*exists|image.*found|manifest.*present',\n            type: 'contradicting',\n          },\n        ],\n      },\n      {\n        idSuffix: 'image-pull-failure:auth-failure',\n        category: 'image-pull-failure',\n        rootCause:\n          'Registry authentication failure — pull credentials are invalid, expired, or have insufficient registry permissions',\n        evidenceRules: [\n          {\n            label: 'Auth/credentials error',\n            pattern: 'unauthorized|403|authentication.*fail|credentials.*invalid|pull.*secret.*missing',\n            type: 'supporting',\n          },\n          {\n            label: 'Auth succeeds',\n            pattern: 'authenticated|credentials.*valid',\n            type: 'contradicting',\n          },\n        ],\n      },\n      {\n        idSuffix: 'image-pull-failure:registry-unavailable',\n        category: 'image-pull-failure',\n        rootCause:\n          'The container registry is unavailable or unreachable from the cluster network',\n        evidenceRules: [\n          {\n            label: 'Registry connectivity error',\n            pattern: 'timeout|connection refused|unreachable|network.*error|registry.*down',\n            type: 'supporting',\n          },\n          {\n            label: 'Registry reachable',\n            pattern: 'registry.*reachable|registry.*available',\n            type: 'contradicting',\n          },\n        ],\n      },\n    ],\n  },\n\n  // ── Not Ready ───────────────────────────────────────────────────────────\n  {\n    id: 'not-ready',\n\n[253 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1774100333575}}
+{"type":"message","id":"3fd3127a","parentId":"342c31c0","timestamp":"2026-03-21T13:38:53.576Z","message":{"role":"toolResult","toolCallId":"call_Z7n9y3jeIyZHXoGFJSnhg2SU|fc_0e22c3c104fdf4860169be9f6d69c0819b87466e21614bcfd3","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect } from 'vitest';\nimport {\n  HYPOTHESIS_TEMPLATE_REGISTRY,\n  loadTemplates,\n  matchTemplate,\n  generateHypothesesFromTemplate,\n} from '../hypothesis-templates.js';\nimport type { HypothesisTemplate } from '../hypothesis-templates.js';\n\n// ---------------------------------------------------------------------------\n// loadTemplates\n// ---------------------------------------------------------------------------\n\ndescribe('loadTemplates', () => {\n  it('returns the full template registry', () => {\n    const templates = loadTemplates();\n    expect(templates).toBe(HYPOTHESIS_TEMPLATE_REGISTRY);\n  });\n\n  it('contains at least 4 templates (crashloop, imagepull, not-ready, pending + generic)', () => {\n    expect(loadTemplates().length).toBeGreaterThanOrEqual(5);\n  });\n\n  it('each template has a unique id', () => {\n    const ids = loadTemplates().map((t) => t.id);\n    expect(new Set(ids).size).toBe(ids.length);\n  });\n\n  it('each template has a non-empty name', () => {\n    for (const t of loadTemplates()) {\n      expect(t.name).toBeTruthy();\n    }\n  });\n\n  it('each template has at least one hypothesis definition', () => {\n    for (const t of loadTemplates()) {\n      expect(t.hypotheses.length).toBeGreaterThanOrEqual(1);\n    }\n  });\n\n  it('all hypothesis definitions have non-empty rootCause', () => {\n    for (const t of loadTemplates()) {\n      for (const h of t.hypotheses) {\n        expect(h.rootCause).toBeTruthy();\n      }\n    }\n  });\n\n  it('all hypothesis definitions have a valid category', () => {\n    const validCategories = [\n      'missing-secret', 'bad-db-endpoint', 'dns-failure', 'image-pull-failure',\n      'config-error', 'oom-kill', 'connectivity-failure', 'readiness-failure',\n      'generic-crash', 'missing-service', 'volume-mount-failure',\n    ];\n    for (const t of loadTemplates()) {\n      for (const h of t.hypotheses) {\n        expect(validCategories).toContain(h.category);\n      }\n    }\n  });\n\n  it('all hypothesis definitions have a non-empty idSuffix', () => {\n    for (const t of loadTemplates()) {\n      for (const h of t.hypotheses) {\n        expect(h.idSuffix).toBeTruthy();\n      }\n    }\n  });\n\n  it('includes a generic fallback template', () => {\n    const generic = loadTemplates().find((t) => t.id === 'generic');\n    expect(generic).toBeDefined();\n    expect(generic!.symptomPatterns).toHaveLength(0);\n  });\n});\n\n// ---------------------------------------------------------------------------\n// HypothesisTemplate type — structural checks\n// ---------------------------------------------------------------------------\n\ndescribe('HypothesisTemplate structure', () => {\n  it('crashloop template has symptomKeyPrefix \"pod-crashloop\"', () => {\n    const t = loadTemplates().find((t) => t.id === 'crashloop');\n    expect(t?.symptomKeyPrefix).toBe('pod-crashloop');\n  });\n\n  it('imagepull template has symptomKeyPrefix \"pod-imagepull\"', () => {\n    const t = loadTemplates().find((t) => t.id === 'imagepull');\n    expect(t?.symptomKeyPrefix).toBe('pod-imagepull');\n  });\n\n  it('not-ready template has symptomKeyPrefix \"pod-not-ready\"', () => {\n    const t = loadTemplates().find((t) => t.id === 'not-ready');\n    expect(t?.symptomKeyPrefix).toBe('pod-not-ready');\n  });\n\n  it('pending template has symptomKeyPrefix \"pod-pending\"', () => {\n    const t = loadTemplates().find((t) => t.id === 'pending');\n    expect(t?.symptomKeyPrefix).toBe('pod-pending');\n  });\n});\n\n// ---------------------------------------------------------------------------\n// EvidenceRule co-location\n// ---------------------------------------------------------------------------\n\ndescribe('evidence rules are co-located with hypothesis definitions', () => {\n  it('crashloop missing-secret hypothesis has at least one supporting rule', () => {\n    const t = loadTemplates().find((t) => t.id === 'crashloop')!;\n    const h = t.hypotheses.find((h) => h.category === 'missing-secret')!;\n    const supporting = h.evidenceRules.filter((r) => r.type === 'supporting');\n    expect(supporting.length).toBeGreaterThanOrEqual(1);\n  });\n\n  it('crashloop missing-secret hypothesis has at least one contradicting rule', () => {\n    const t = loadTemplates().find((t) => t.id === 'crashloop')!;\n    const h = t.hypotheses.find((h) => h.category === 'missing-secret')!;\n    const contradicting = h.evidenceRules.filter((r) => r.type === 'contradicting');\n    expect(contradicting.length).toBeGreaterThanOrEqual(1);\n  });\n\n  it('all evidence rules have a non-empty label', () => {\n    for (const t of loadTemplates()) {\n      for (const h of t.hypotheses) {\n        for (const r of h.evidenceRules) {\n          expect(r.label).toBeTruthy();\n        }\n      }\n    }\n  });\n\n  it('all evidence rules have a non-empty pattern', () => {\n    for (const t of loadTemplates()) {\n      for (const h of t.hypotheses) {\n        for (const r of h.evidenceRules) {\n          expect(r.pattern).toBeTruthy();\n        }\n      }\n    }\n  });\n\n  it('all evidence rules have a valid type', () => {\n    for (const t of loadTemplates()) {\n      for (const h of t.hypotheses) {\n        for (const r of h.evidenceRules) {\n          expect(['supporting', 'contradicting']).toContain(r.type);\n        }\n      }\n    }\n  });\n});\n\n// ---------------------------------------------------------------------------\n// matchTemplate\n// ---------------------------------------------------------------------------\n\ndescribe('matchTemplate', () => {\n  it('matches CrashLoopBackOff text to the crashloop template', () => {\n    const t = matchTemplate('pod is in crashloopbackoff');\n    expect(t.id).toBe('crashloop');\n  });\n\n  it('matches \"crashloop\" keyword', () => {\n    expect(matchTemplate('container crashloop detected').id).toBe('crashloop');\n  });\n\n  it('matches \"back-off restarting failed container\"', () => {\n    expect(matchTemplate('back-off restarting failed container').id).toBe('crashloop');\n  });\n\n  it('matches ImagePullBackOff text to the imagepull template', () => {\n    expect(matchTemplate('imagepullbackoff for myapp:v2').id).toBe('imagepull');\n  });\n\n  it('matches \"failed to pull image\"', () => {\n    expect(matchTemplate('failed to pull image registry/app:v1').id).toBe('imagepull');\n  });\n\n  it('matches \"image pull\" keyword', () => {\n    expect(matchTemplate('image pull error').id).toBe('imagepull');\n  });\n\n  it('matches \"not ready\" text to the not-ready template', () => {\n    expect(matchTemplate('pod is not ready').id).toBe('not-ready');\n  });\n\n  it('matches \"readiness probe failed\"', () => {\n    expect(matchTemplate('readiness probe failed: connection refused').id).toBe('not-ready');\n  });\n\n  it('matches pending pod patterns', () => {\n    expect(matchTemplate('pending pod stuck').id).toBe('pending');\n    expect(matchTemplate('containercreating timeout').id).toBe('pending');\n    expect(matchTemplate('failedmount event').id).toBe('pending');\n    expect(matchTemplate('failedscheduling').id).toBe('pending');\n  });\n\n  it('falls back to generic for unrecognised text', () => {\n    expect(matchTemplate('something completely different').id).toBe('generic');\n  });\n\n  it('is case-insensitive', () => {\n    expect(matchTemplate('CrashLoopBackOff').id).toBe('crashloop');\n    expect(matchTemplate('IMAGEPULLBACKOFF').id).toBe('imagepull');\n  });\n});\n\n// ---------------------------------------------------------------------------\n// generateHypothesesFromTemplate\n// ---------------------------------------------------------------------------\n\ndescribe('generateHypothesesF