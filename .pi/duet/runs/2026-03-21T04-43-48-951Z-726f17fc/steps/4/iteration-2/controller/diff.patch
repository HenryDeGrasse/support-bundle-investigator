nai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":24849,"output":238,"cacheRead":26240,"cacheWrite":0,"totalTokens":51327,"cost":{"input":0.062122500000000004,"output":0.0035700000000000003,"cacheRead":0.00656,"cacheWrite":0,"total":0.0722525}},"stopReason":"toolUse","timestamp":1774103165606,"responseId":"resp_0e22c3c104fdf4860169beaa7df21c819bae1c914b8126968f"}}
+{"type":"message","id":"ffbc5cfd","parentId":"ef89dca9","timestamp":"2026-03-21T14:26:15.378Z","message":{"role":"toolResult","toolCallId":"call_Aq4RhpOP4z9LGWKw7mXZZH6y|fc_0e22c3c104fdf4860169beaa874750819bb20ab431949a55ac","toolName":"read","content":[{"type":"text","text":"import { describe, it, expect, vi } from 'vitest';\nimport type { InvestigatorContext } from '../types.js';\nimport type { BundleProfile, K8sResource, K8sEvent } from '../../types/index.js';\nimport type { LogFile, LogLine } from '../../parsers/index.js';\nimport type { AIInvestigatorDeps } from '../ai-investigator.js';\nimport type { ResourceRelationshipGraph } from '../../graph/resource-graph.js';\nimport { classifyLogLevel } from '../../parsers/index.js';\nimport { runInvestigation } from '../orchestrator.js';\nimport { getRootCauses } from '../../graph/finding-tree.js';\n\n// ---------------------------------------------------------------------------\n// Fixture helpers\n// ---------------------------------------------------------------------------\n\nfunction makeProfile(): BundleProfile {\n  return {\n    manifest: {\n      bundlePath: '',\n      extractedPath: '',\n      files: [],\n      totalSize: 0,\n      extractedAt: new Date(),\n    },\n    analyzerCount: 0,\n    logFileCount: 0,\n    resourceCount: 0,\n    eventCount: 0,\n    namespaces: [],\n    workloads: [],\n    coverageGaps: [],\n    artifactsByCategory: {\n      analyzer: 0,\n      log: 0,\n      'kubernetes-resource': 0,\n      event: 0,\n      'cluster-info': 0,\n      'helm-release': 0,\n      unknown: 0,\n    },\n  };\n}\n\nfunction makeContext(partial: Partial<InvestigatorContext> = {}): InvestigatorContext {\n  return {\n    analyzerResults: [],\n    resources: [],\n    events: [],\n    logs: [] as LogFile[],\n    profile: makeProfile(),\n    ...partial,\n  };\n}\n\nfunction makeLogLine(content: string, lineNumber: number): LogLine {\n  return { lineNumber, content, level: classifyLogLevel(content) };\n}\n\nfunction makeLogFile(logPath: string, lines: string[]): LogFile {\n  const logLines = lines.map((c, i) => makeLogLine(c, i + 1));\n  const errorCount = logLines.filter((l) => l.level === 'error').length;\n  const warningCount = logLines.filter((l) => l.level === 'warning').length;\n  return { path: logPath, lines: logLines, errorCount, warningCount, importance: 0.5 };\n}\n\n// ---------------------------------------------------------------------------\n// Fixtures — CrashLoopBackOff pod\n// ---------------------------------------------------------------------------\n\nconst crashLoopPod: K8sResource = {\n  apiVersion: 'v1',\n  kind: 'Pod',\n  metadata: { name: 'app-pod', namespace: 'default' },\n  spec: {\n    containers: [{ name: 'app', image: 'myapp:v1.2.3' }],\n  },\n  status: {\n    phase: 'Running',\n    conditions: [\n      { type: 'Ready', status: 'False', reason: 'ContainersNotReady' },\n    ],\n    containerStatuses: [\n      {\n        name: 'app',\n        ready: false,\n        restartCount: 8,\n        state: {\n          waiting: {\n            reason: 'CrashLoopBackOff',\n            message: 'back-off 5m0s restarting failed container',\n          },\n        },\n      },\n    ],\n  },\n};\n\nconst backOffEvent: K8sEvent = {\n  involvedObject: { kind: 'Pod', name: 'app-pod', namespace: 'default' },\n  reason: 'BackOff',\n  message: 'Back-off restarting failed container',\n  type: 'Warning',\n  count: 12,\n  firstTimestamp: '2024-01-01T00:00:00Z',\n  lastTimestamp: '2024-01-01T01:00:00Z',\n};\n\n// ---------------------------------------------------------------------------\n// Fixtures — missing Secret\n// ---------------------------------------------------------------------------\n\nconst missingSecretPod: K8sResource = {\n  apiVersion: 'v1',\n  kind: 'Pod',\n  metadata: { name: 'secret-pod', namespace: 'production' },\n  spec: {\n    containers: [\n      {\n        name: 'app',\n        image: 'myapp:v2.0.0',\n        envFrom: [{ secretRef: { name: 'app-credentials' } }],\n      },\n    ],\n  },\n  status: { phase: 'Pending' },\n};\n\n/** A dummy Secret in the same namespace so the checker runs. */\nconst dummySecret: K8sResource = {\n  apiVersion: 'v1',\n  kind: 'Secret',\n  metadata: { name: 'other-secret', namespace: 'production' },\n};\n\n// ---------------------------------------------------------------------------\n// Fixtures — log file with DNS failures\n// ---------------------------------------------------------------------------\n\nconst dnsFailureLog: LogFile = makeLogFile('pod-logs/default/dns-pod/app.log', [\n  'INFO  Starting application',\n  'ERROR lookup db.internal: no such host',\n  'ERROR lookup db.internal: no such host',\n  'WARN  Retrying connection',\n  'ERROR lookup db.internal: no such host',\n]);\n\n// ---------------------------------------------------------------------------\n// AI deps helpers\n// ---------------------------------------------------------------------------\n\nfunction makeEmptyAIDeps(): AIInvestigatorDeps {\n  const emptyGraph: ResourceRelationshipGraph = { nodes: new Map(), edges: [] };\n  return {\n    llmClient: {\n      investigateSeed: vi.fn().mockResolvedValue({ findings: [] }),\n      // generateText is used by the seed-clustering pass (clusterSeeds).\n      // Default: empty string → graceful fallback to unclustered seeds.\n      // Override in individual tests to exercise the clustering path.\n      generateText: vi.fn().mockResolvedValue(''),\n    } as unknown as AIInvestigatorDeps['llmClient'],\n    chunkIndex: [],\n    resourceGraph: emptyGraph,\n    lexicalIndex: {\n      build: vi.fn(),\n      search: vi.fn().mockReturnValue([]),\n      extractQueryIdentifiers: vi.fn().mockReturnValue([]),\n    } as unknown as AIInvestigatorDeps['lexicalIndex'],\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Seed-clustering test helper\n// ---------------------------------------------------------------------------\n\n/**\n * Parses the serialised seed list from a `buildSeedClusteringPrompt` user\n * prompt and returns the array of `{ id, priority }` objects.\n *\n * The prompt embeds the seed list in a fenced JSON block:\n *\n * ```json\n * [{ \"id\": \"seed:pod:0\", \"priority\": 90, ... }, ...]\n * ```\n *\n * Returns `null` when the block cannot be found or parsed (defensive helper\n * for mock implementations — callers can return `''` on failure to trigger\n * the clusterer's graceful fallback path).\n */\nfunction parseSeedsFromClusteringPrompt(\n  userPrompt: string,\n): Array<{ id: string; priority: number }> | null {\n  try {\n    const match = userPrompt.match(/```json\\n([\\s\\S]*?)\\n```/);\n    if (!match) return null;\n    const parsed = JSON.parse(match[1]) as unknown;\n    if (!Array.isArray(parsed)) return null;\n    return parsed as Array<{ id: string; priority: number }>;\n  } catch {\n    return null;\n  }\n}\n\n// ---------------------------------------------------------------------------\n// Tests\n// ---------------------------------------------------------------------------\n\ndescribe('runInvestigation', () => {\n  it('returns an InvestigationResult with the expected shape on an empty context', async () => {\n    const result = await runInvestigation(makeContext());\n\n    expect(result).toMatchObject({\n      findings: expect.any(Array),\n      edges: expect.any(Array),\n      seeds: expect.any(Array),\n      metadata: {\n        seedCount: expect.any(Number),\n        rawFindingCount: expect.any(Number),\n        finalFindingCount: expect.any(Number),\n        aiEnabled: false,\n        aiFindings: 0,\n      },\n    });\n    expect(result.findings).toHaveLength(0);\n    expect(result.seeds).toHaveLength(0);\n    expect(result.metadata.seedCount).toBe(0);\n    expect(result.metadata.rawFindingCount).toBe(0);\n    expect(result.metadata.finalFindingCount).toBe(0);\n  });\n\n  it('generates seeds from context data', async () => {\n    const context = makeContext({ resources: [crashLoopPod], events: [backOffEvent] });\n    const result = await runInvestigation(context);\n\n    // Seeds should be generated for the CrashLoopBackOff pod and the Warning event\n    expect(result.seeds.length).toBeGreaterThan(0);\n    const crashSeed = result.seeds.find((s) =>\n      s.hypothesis.toLowerCase().includes('crashloop'),\n    );\n    expect(crashSeed).toBeDefined();\n    expect(crashSeed?.category).toBe('kubernetes');\n    expect(crashSeed?.priority).toBeGreaterThanOrEqual(80);\n  });\n\n  it('runs the Kubernetes investigator and produces CrashLoopBackOff findings', async () => {\n    const context = makeContext({ resources: [crashLoopPod], events: [backOffEvent] });\n    const result = await runInvestigation(context);\n\n    const crashFinding = result.findings.find((f) =>\n      f.title.toLowerCase().includes('crashloop'),\n    );\n    expect(crashFinding).toBeDefined();\n    expect(crashFinding?.severity).toBe('critical');\n    expect(crashFinding?.confidence).toBeGreaterThan(0);\n  });\n\n  it('runs the Log investigator and produces DNS failure findings', async () => {\n    const context = makeContext({ logs: [dnsFailureLog] });\n    const result = await runInvestigation(context);\n\n    const dnsFinding = result.findings.find(\n      (f) => f.title.toLowerCase().includes('dns'),\n    );\n    expect(dnsFinding).toBeDefined();\n    expect(dnsFinding?.severity).toBe('high');\n  });\n\n  it('runs the Configuration investigator and produces missing-secret findings', async () => {\n    const context = makeContext({\n      resources: [missingSecretPod, dummySecret],\n    });\n    const result = await runInvestigation(context);\n\n    const secretFinding = result.findings.find((f) =>\n      f.title.toLowerCase().includes('secret'),\n    );\n    expect(secretFinding).toBeDefined();\n    expect(secretFinding?.severity).toBe('critical');\n  });\n\n  it('collects edges from all three investigators', async () => {\n    const context = makeContext({\n      resources: [crashLoopPod, missingSecretPod, dummySecret],\n      events: [backOffEvent],\n      logs: [dnsFailureLog],\n    });\n    const result = await runInvestigation(context);\n\n    // Edges come from k8s, log, and config investigators\n    expect(result.edges.length).toBeGreaterThan(0);\n    expect(result.edges.every((e) => e.id && e.source && e.target && e.type)).toBe(true);\n  });\n\n  it('runs the verifier — deduplication reduces raw finding count when there is overlap', async () => {\n    // A context that triggers the same issue from multiple investigators\n    const context = makeContext({\n      resources: [crashLoopPod],\n      events: [backOffEvent],\n      logs: [dnsFailureLog],\n    });\n    const result = await runInvestigation(context);\n\n    // finalFindingCount should be <= rawFindingCount (dedup can only remove or keep)\n    expect(result.metadata.finalFindingCount).toBeLessThanOrEqual(\n      result.metadata.rawFindingCount,\n    );\n    // The metadata counts should be consistent with the returned arrays\n    expect(result.findings).toHaveLength(result.metadata.finalFindingCount);\n  });\n\n  it('sorts findings by severity descending, then confidence descending', async () => {\n    const context = makeContext({\n      resources: [crashLoopPod, missingSecretPod, dummySecret],\n      events: [backOffEvent],\n      logs: [dnsFailureLog],\n    });\n    const result = await runInvestigation(context);\n\n    const severityOrder: Record<string, number> = {\n      critical: 4,\n      high: 3,\n      medium: 2,\n\n[1668 more lines in file. Use offset=321 to continue.]"}],"isError":false,"timestamp":1774103175378}}
+{"type":"message","id":"d84ebfd0","parentId":"ffbc5cfd","timestamp":"2026-03-21T14:26:15.379Z","message":{"role":"toolResult","toolCallId":"call_ybghLhu9qew5LQ6e3cQxZvFA|fc_0e22c3c104fdf4860169beaa874768819b901a7e204b887698","toolName":"read","content":[{"type":"text","text":"import type { Finding, FindingSeverity, GraphEdge, Evidence, FindingTreeNode } from '../types/index.js';\nimport type { InvestigatorContext, InvestigationSeed, ClusteredSeed } from './types.js';\nimport { buildFindingTree } from '../graph/finding-tree.js';\nimport { generateSeeds } from './seed-generator.js';\nimport { clusterSeeds, toUnclusteredSeeds } from './seed-clusterer.js';\nimport { investigateKubernetes } from './kubernetes-investigator.js';\nimport { investigateLog } from './log-investigator.js';\nimport { investigateConfig } from './config-investigator.js';\nimport { investigateServices } from './service-investigator.js';\nimport { investigateNetworkPolicies } from './network-policy-investigator.js';\nimport { verifyFindings, computeConfidenceQuality } from './verifier.js';\nimport { investigateWithAI } from './ai-investigator.js';\nimport type { AIInvestigatorDeps } from './ai-investigator.js';\nimport { generateAllHypotheses, correlateAcrossSymptoms } from './hypothesis-generator.js';\nimport { collectEvidenceForHypothesis } from './hypothesis-evidence-collector.js';\nimport { rankHypotheses, identifySpecGaps } from './hypothesis-ranker.js';\nimport { convertHypothesisSetsToFindings } from './hypothesis-converter.js';\nimport { matchCausalTemplate } from '../graph/causal-templates.js';\nimport type { CausalTemplateInstance } from '../graph/causal-templates.js';\nimport type { K8sEvent } from '../types/index.js';\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/**\n * The result produced by a full orchestrated investigation run.\n *\n * - `findings`        — verified, deduplicated, severity-sorted findings\n * - `edges`           — all graph edges produced by every targeted investigator\n * - `findingTree`     — causal tree built from findings + 'causes' edges\n * - `seeds`           — original pre-clustering seeds (full audit trail)\n * - `clusteredSeeds`  — post-clustering seeds fed to the AI investigator\n * - `metadata`        — counters for seeds, raw vs. final findings\n */\nexport interface InvestigationResult {\n  findings: Finding[];\n  edges: GraphEdge[];\n  /** Causal tree built from `findings` and `edges` using {@link buildFindingTree}. */\n  findingTree: FindingTreeNode[];\n  /**\n   * Original pre-clustering seeds produced by `generateSeeds()`.\n   * Retained for full audit trail — shows every raw signal detected.\n   */\n  seeds: InvestigationSeed[];\n  /**\n   * Post-clustering seeds fed to the AI investigator.\n   * Each `ClusteredSeed` carries a `memberSeeds` list for traceability.\n   * When clustering is disabled or below the threshold, each entry is a\n   * singleton wrapper around a single original seed.\n   */\n  clusteredSeeds: ClusteredSeed[];\n  metadata: {\n    /** Total number of seeds generated before investigation. */\n    seedCount: number;\n    /** Total raw findings before verification and deduplication. */\n    rawFindingCount: number;\n    /** Total findings remaining after verification and deduplication. */\n    finalFindingCount: number;\n    /** Whether AI investigation was active during this run. */\n    aiEnabled: boolean;\n    /** Number of findings contributed by the AI investigator. */\n    aiFindings: number;\n    /** Total number of hypotheses generated across all symptom sets. */\n    hypothesesGenerated: number;\n    /** Number of hypotheses that received a confidence score > 0 after evidence collection. */\n    hypothesesVerified: number;\n    /**\n     * Number of symptom findings matched by causal template analysis.\n     * These findings were excluded from the hypothesis generator and handled\n     * via graph traversal (the graph-driven investigation path).\n     */\n    graphMatchedSymptoms: number;\n    /**\n     * Number of cluster representatives after seed clustering.\n     * Equals `clusteredSeeds.length`.  When clustering is disabled or\n     * below the threshold this equals `seedCount`.\n     */\n    seedClusterCount: number;\n    /**\n     * Whether AI seed clustering was attempted and succeeded.\n     * `false` when AI is disabled, seed count is below the threshold,\n     * or the LLM call / response validation failed (graceful degradation).\n     */\n    seedClusteringEnabled: boolean;\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Severity sort order  (higher number = higher priority in sorted output)\n// ---------------------------------------------------------------------------\n\nconst SEVERITY_ORDER: Record<FindingSeverity, number> = {\n  critical: 4,\n  high: 3,\n  medium: 2,\n  low: 1,\n  info: 0,\n};\n\nfunction buildHypothesisSupportEdges(findings: Finding[]): GraphEdge[] {\n  const edges: GraphEdge[] = [];\n\n  for (const finding of findings) {\n    for (let i = 0; i < finding.evidence.length; i++) {\n      const evidence = finding.evidence[i]!;\n      edges.push({\n        id: `edge:hypothesis-support:${finding.id}:${i}`,\n        source: `evidence:${evidence.path}`,\n        target: finding.id,\n        type: 'supports',\n        weight: finding.confidence,\n        note: 'Structured hypothesis evidence supports this differential-diagnosis candidate',\n      });\n    }\n  }\n\n  return edges;\n}\n\n// ---------------------------------------------------------------------------\n// Pass 1: Component-based merge (structural)\n// ---------------------------------------------------------------------------\n//\n// Contract: one normalization strategy (primaryComponent + issueFamily key)\n// and one merge strategy (AI > hypothesis > heuristic priority, with evidence\n// absorbed from non-winning findings).\n//\n// This pass replaces three previously-separate steps that all performed\n// overlapping component/family matching:\n//   (a) hypothesis category dedup within the hypothesis layer\n//   (b) AI-primary promotion (AI absorbs heuristic for same component)\n//   (c) mergeHypothesisFindings (hypothesis replaces heuristic for same family+component)\n\n/**\n * Returns the issue family string for a finding.\n *\n * This is the **single normalization strategy** for Pass 1. Hypothesis findings\n * declare their family via their ID. All other findings are classified from\n * their title using a precedence-ordered pattern list.\n */\nfunction normalizeIssueFamilyForPass1(finding: Finding): string {\n  // Hypothesis findings declare their family in their ID structure.\n  if (finding.id.startsWith('finding:hypothesis:')) {\n    return finding.id.split(':')[2] ?? 'unknown';\n  }\n\n  const lower = finding.title.toLowerCase();\n\n  // Missing secret: \"secret\" + absence indicator\n  if (\n    lower.includes('secret') &&\n    (lower.includes('missing') ||\n      lower.includes('not found') ||\n      lower.includes('absent') ||\n      lower.includes('does not exist') ||\n      lower.includes('required'))\n  ) {\n    return 'missing-secret';\n  }\n  // DNS / name resolution failures\n  if (\n    lower.includes('dns') ||\n    lower.includes('no such host') ||\n    lower.includes('resolution fail')\n  ) {\n    return 'dns-failure';\n  }\n  // Image pull failures (check before generic \"image\" matches)\n  if (\n    lower.includes('imagepullbackoff') ||\n    lower.includes('errimagepull') ||\n    lower.includes('image pull') ||\n    lower.includes('pull image') ||\n    lower.includes('failed to pull')\n  ) {\n    return 'image-pull-failure';\n  }\n  // CrashLoopBackOff\n  if (\n    lower.includes('crashloopbackoff') ||\n    lower.includes('crashloop') ||\n    lower.includes('crash loop')\n  ) {\n    return 'crashloop';\n  }\n  // OOM / me