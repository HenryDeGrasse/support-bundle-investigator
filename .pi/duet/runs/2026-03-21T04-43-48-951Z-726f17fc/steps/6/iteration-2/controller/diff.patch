contradiction penalty. */\nconst CONTRADICTION_CAP = 0.40;\n\n/** Each missing-decisive evidence item reduces confidence by this amount. */\nconst MISSING_PER_ITEM = 0.10;\n/** Maximum total missing-evidence penalty. */\nconst MISSING_CAP = 0.30;\n\n/**\n * When *all* supporting evidence is generic symptom-only (e.g. \"pod not\n * ready\" without a specific diagnostic signal), confidence is capped here to\n * prevent overconfidence from volume alone.\n */\nconst GENERIC_ONLY_CAP = 0.50;\n\n/**\n * Category-specific decisive bonuses reward exact root-cause evidence more\n * than broad symptom-adjacent evidence. For example, an exact `no such host`\n * signal should outrank a generic timeout when both are present in the same\n * scenario because it narrows the diagnosis to DNS rather than connectivity.\n */\nconst CATEGORY_DECISIVE_BONUS: Partial<Record<Hypothesis['category'], { perItem: number; cap: number; patterns: RegExp[] }>> = {\n  'dns-failure': {\n    perItem: 0.07,\n    cap: 0.21,\n    patterns: [/no such host/i, /nxdomain/i, /lookup.*fail/i, /dns resolution failure/i],\n  },\n  'missing-secret': {\n    perItem: 0.07,\n    cap: 0.21,\n    patterns: [/failedmount/i, /secret.*not\\s+found/i, /referenced secret .* absent/i],\n  },\n  'image-pull-failure': {\n    perItem: 0.07,\n    cap: 0.21,\n    patterns: [/errimagepull/i, /imagepullbackoff/i, /failed to pull image/i],\n  },\n  'readiness-failure': {\n    perItem: 0.05,\n    cap: 0.15,\n    patterns: [/readiness probe failed/i, /unhealthy event/i, /probe.*misconfig/i],\n  },\n  'connectivity-failure': {\n    perItem: 0.03,\n    cap: 0.09,\n    patterns: [/connection refused/i, /context deadline exceeded/i, /connection timed out/i, /i\\/o timeout/i],\n  },\n};\n\n// ---------------------------------------------------------------------------\n// Helpers — evidence classification\n// ---------------------------------------------------------------------------\n\n/**\n * Patterns that indicate an evidence note carries a *specific* diagnostic\n * signal (an exact error message, error code, or resource identifier) rather\n * than a generic status observation.\n *\n * These patterns are matched against `evidence.note` case-insensitively.\n */\nconst SPECIFIC_PATTERNS: RegExp[] = [\n  /no such host/i,\n  /nxdomain/i,\n  /lookup.*fail/i,\n  /errimagepull/i,\n  /imagepullbackoff/i,\n  /failed to pull image/i,\n  /back-off.*pulling image/i,\n  /oomkill/i,\n  /oom.*kill/i,\n  /out of memory/i,\n  /crashloopbackoff/i,\n  /crashloop/i,\n  /failedmount/i,\n  /mountvolume.*failed/i,\n  /secret.*not\\s+found/i,\n  /not\\s+found.*secret/i,\n  /connection refused/i,\n  /context deadline exceeded/i,\n  /connection timed out/i,\n  /i\\/o timeout/i,\n  /dial tcp/i,\n  /readiness probe failed/i,\n  /unhealthy.*readiness/i,\n  /readiness.*unhealthy/i,\n  /references secret .* absent/i,\n  /referenced secret .* not present/i,\n  /maps to missing service/i,\n  /references in-cluster hostname/i,\n  /dns-related failure/i,\n  /configuration error/i,\n  /resource not-found error/i,\n  /no endpoints resources found/i,\n  /unhealthy event/i,\n  /readiness probe configured/i,\n  // Notes synthesised by the evidence collector often embed the raw log line\n  // or event message, making them specific by nature.\n  /log line show/i,\n  /log line indicates/i,\n  /event indicates/i,\n  /waiting with reason/i,\n];\n\n/**\n * Patterns that indicate an evidence note carries only a *generic* symptom\n * observation (e.g. \"pod is not ready\") without a specific diagnostic signal.\n *\n * A note is considered generic only when it matches one of these patterns AND\n * does NOT match any of the {@link SPECIFIC_PATTERNS}.\n */\nconst GENERIC_PATTERNS: RegExp[] = [\n  /pod.*not\\s+ready/i,\n  /running but not ready/i,\n  /pod\\s+is\\s+unhealthy/i,\n  /is\\s+unhealthy/i,\n  /container.*not\\s+ready/i,\n  /pod status/i,\n];\n\n/**\n * Returns `true` when the evidence note contains a specific diagnostic signal\n * (an exact error message, error code, or precise resource reference) rather\n * than a generic status observation.\n */\nfunction isSpecificEvidence(evidence: Evidence): boolean {\n  return SPECIFIC_PATTERNS.some((p) => p.test(evidence.note));\n}\n\n/**\n * Returns `true` when the evidence note describes only a generic symptom\n * observation (e.g. \"pod is not ready\") and does NOT contain any specific\n * diagnostic signal.\n */\nfunction isGenericEvidence(evidence: Evidence): boolean {\n  if (isSpecificEvidence(evidence)) return false;\n  return GENERIC_PATTERNS.some((p) => p.test(evidence.note));\n}\n\nfunction getCategoryDecisiveBonus(hypothesis: Hypothesis): number {\n  const config = CATEGORY_DECISIVE_BONUS[hypothesis.category];\n  if (config == null) return 0;\n\n  const matchCount = hypothesis.evidenceAssessment.supporting.filter((evidence) =>\n    config.patterns.some((pattern) => pattern.test(evidence.note)),\n  ).length;\n\n  return Math.min(matchCount * config.perItem, config.cap);\n}\n\n// ---------------------------------------------------------------------------\n// Public API\n// ---------------------------------------------------------------------------\n\n/**\n * Computes a calibrated confidence score in **[0, 1]** for a single\n * hypothesis based on its evidence assessment.\n *\n * The score is derived from:\n * 1. **Base** — `min(n_supporting × 0.15, 0.60)`.\n * 2. **Specificity bonus** — up to `+0.30` when evidence notes contain exact\n *    diagnostic signals (e.g., `\"no such host\"`, `\"ErrImagePull\"`).\n * 3. **Cross-source bonus** — `+0.10` when supporting evidence spans two or\n *    more artifact types (e.g., `log` + `kubernetes-resource`).\n * 4. **Evidence diversity bonus** — additional `+0.05` when supporting\n *    evidence spans three or more distinct artifact types.\n * 5. **Cross-namespace corroboration bonus** — `+0.15` when any supporting\n *    evidence note confirms a cross-namespace service match (confirmed root\n *    cause; pattern: `/exists in namespace .* \\(not /i`).\n * 6. **Contradiction penalty** — `min(n_contradicting × 0.15, 0.40)`.\n * 7. **Missing decisive penalty** — `min(n_missing × 0.10, 0.30)`.\n * 8. **Generic-only cap** — if every supporting item is a generic symptom\n *    observation (no specific signal), the final score is capped at `0.50`.\n *\n * The result is always clamped to `[0, 1]`.\n */\nexport function scoreHypothesis(hypothesis: Hypothesis): number {\n  const { supporting, contradicting, missingDecisive } = hypothesis.evidenceAssessment;\n\n  // 1. Base score from supporting evidence count\n  const baseScore = Math.min(supporting.length * SUPPORTING_PER_ITEM, SUPPORTING_CAP);\n\n  // 2. Specificity bonus\n  const specificCount = supporting.filter(isSpecificEvidence).length;\n  const specificityBonus = Math.min(specificCount * SPECIFICITY_PER_ITEM, SPECIFICITY_CAP);\n  const categoryDecisiveBonus = getCategoryDecisiveBonus(hypothesis);\n\n  // 3. Cross-source bonus (requires 2+ distinct non-null artifact types)\n  const artifactTypes = new Set(\n    supporting.map((e) => e.artifactType).filter((t): t is NonNullable<typeof t> => t != null),\n  );\n  const crossSourceBonus = artifactTypes.size >= 2 ? CROSS_SOURCE_BONUS : 0.0;\n\n  // 4. Evidence diversity bonus: additional +0.05 for 3+ distinct artifact types\n  const diversityBonus = artifactTypes.size >= 3 ? EVIDENCE_DIVERSITY_BONUS : 0.0;\n\n  // 5. Cross-namespace corroboration bonus: +0.15 when any supporting evidence\n  //    note confirms a cross-namespace service match (confirmed root cause)\n  const hasCrossNamespace = supporting.some((e) => CROSS_NAMESPACE_PATTERN.test(e.note));\n  const crossNamespaceBonus = hasCrossNamespace ? CROSS_NAMESPACE_BONUS : 0.0;\n\n  // 6. Contradiction penalty\n  const contradictionPenalty = Math.min(\n    contradicting.length * CONTRADICTION_PER_ITEM,\n    CONTRADICTION_CAP,\n  );\n\n  // 7. Missing decisive evidence penalty\n  const missingPenalty = Math.min(missingDecisive.length * MISSING_PER_ITEM, MISSING_CAP);\n\n  // 8. Raw score\n  let score =\n    baseScore +\n    specificityBonus +\n    categoryDecisiveBonus +\n    crossSourceBonus +\n    diversityBonus +\n    crossNamespaceBonus -\n    contradictionPenalty -\n    missingPenalty;\n\n  // 9. Evidence sufficiency floor — cap generic-only hypotheses at GENERIC_ONLY_CAP\n  const hasSupporting = supporting.length > 0;\n  const allGeneric = hasSupporting && supporting.every((e) => isGenericEvidence(e));\n  if (allGeneric) {\n    score = Math.min(score, GENERIC_ONLY_CAP);\n  }\n\n  // 10. Clamp to [0, 1] and round away floating-point noise so calibrated\n  // confidence thresholds remain stable in tests and downstream ranking.\n  const clamped = Math.max(0.0, Math.min(1.0, score));\n  return Math.round(clamped * 10000) / 10000;\n}\n\n/**\n * Returns a human-readable explanation of how the confidence score was\n * derived from the hypothesis's evidence assessment.\n *\n * The rationale mentions: supporting item count, specificity signals, cross-\n * source diversity, contradiction count, missing-evidence count, and the\n * generic-only cap when applicable.\n */\nexport function buildConfidenceRationale(hypothesis: Hypothesis): string {\n  const { supporting, contradicting, missingDecisive } = hypothesis.evidenceAssessment;\n  const score = scoreHypothesis(hypothesis);\n\n  const parts: string[] = [];\n\n  if (supporting.length === 0) {\n    parts.push('no supporting evidence found');\n  } else {\n    const n = supporting.length;\n    parts.push(`${n} supporting evidence item${n === 1 ? '' : 's'}`);\n\n    const specificCount = supporting.filter(isSpecificEvidence).length;\n    if (specificCount > 0) {\n      parts.push(\n        `${specificCount} specific diagnostic signal${specificCount === 1 ? '' : 's'} (exact error / code)`,\n      );\n    }\n\n    const decisiveBonus = getCategoryDecisiveBonus(hypothesis);\n    if (decisiveBonus > 0) {\n      parts.push(`category-specific decisive evidence bonus (+${decisiveBonus.toFixed(2)})`);\n    }\n\n    const artifactTypes = new Set(\n      supporting.map((e) => e.artifactType).filter((t): t is NonNullable<typeof t> => t != null),\n    );\n    if (artifactTypes.size >= 2) {\n      const typeList = [...artifactTypes].join(', ');\n      parts.push(`cross-source evidence from ${typeList}`);\n    }\n    if (artifactTypes.size >= 3) {\n      parts.push(`evidence diversity bonus (+${EVIDENCE_DIVERSITY_BONUS.toFixed(2)}) — ${artifactTypes.size} distinct artifact types`);\n    }\n\n    const hasCrossNamespace = supporting.some((e) => CROSS_NAMESPACE_PATTERN.test(e.note));\n    if (hasCrossNamespace) {\n      parts.push(`cross-namespace corroboration bonus (+${CROSS_NAMESPACE_BONUS.toFixed(2)}) — service confirmed in different namespace`);\n    }\n  }\n\n  if (contradicting.length > 0) {\n    const n = contradicting.length;\n    parts.push(`${n} contradicting item${n === 1 ? '' : 's'} reducing confidence`);\n  }\n\n  if (missingDecisive.length > 0) {\n    const n = missingDecisive.length;\n    parts.push(`${n} missing decisive evidence item${n === 1 ? '' : 's'} limiting confidence`);\n  }\n\n  const hasSupporting = supporting.length > 0;\n  const allGeneric = hasSupporting && supporting.every((e) => isGenericEvidence(e));\n  if (allGeneric) {\n    parts.push(`confidence capped at ${GENERIC_ONLY_CAP.toFixed(2)} — only generic symptom evidence available`);\n  }\n\n  const scoreStr = score.toFixed(2);\n  return `Confidence ${scoreStr}: ${parts.join('; ')}.`;\n}\n\n/**\n * Scores and ranks an array of hypotheses by confidence (descending), and\n * updates each hypothesis's `confidence` and `confidenceRationale` fields\n * with freshly computed values.\n *\n * Returns a **new** array of hypothesis objects — the input array and its\n * objects are not mutated.\n */\nexport function rankHypotheses(hypotheses: Hypothesis[]): Hypothesis[] {\n  const scored = hypotheses.map((h) => ({\n    ...h,\n    confidence: scoreHypothesis(h),\n    confidenceRationale: buildConfidenceRationale(h),\n  }));\n  return scored.sort((a, b) => b.confidence - a.confidence);\n}\n\n/**\n * Identifies bundle spec-gap recommendations for a hypothesis when missing\n * decisive evidence prevents the hypothesis from being confirmed or ruled out.\n *\n * Each entry in `evidenceAssessment.missingDecisive` is transformed into an\n * actionable spec-gap recommendation suitable for inclusion in\n * {@link Hypothesis.specGapRecommendations}.\n *\n * Returns an **empty array** when no decisive evidence is missing.\n */\nexport function identifySpecGaps(hypothesis: Hypothesis): string[] {\n  const { missingDecisive } = hypothesis.evidenceAssessment;\n  if (missingDecisive.length === 0) return [];\n\n  return missingDecisive.map(\n    (gap) => `Spec gap [${hypothesis.category}]: ${gap}`,\n  );\n}\n"}],"isError":false,"timestamp":1774104193991}}
+{"type":"message","id":"33ea8b6e","parentId":"86cdc611","timestamp":"2026-03-21T14:43:13.992Z","message":{"role":"toolResult","toolCallId":"call_QfkOvYZsu3ehNCvl1vkheYro|fc_0e22c3c104fdf4860169beae81e160819bb25a763629815f22","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env node\nimport fs from 'fs/promises';\nimport path from 'path';\nimport os from 'os';\nimport { fileURLToPath } from 'url';\nimport { spawnSync } from 'child_process';\nimport * as tar from 'tar';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\nconst repoRoot = path.resolve(__dirname, '..');\nconst cliEntry = path.join(repoRoot, 'dist', 'cli', 'run.js');\n\nconst SCENARIOS = [\n  {\n    name: 'wrong-db-endpoint',\n    expectedTopCategory: 'dns-failure',\n  },\n  {\n    name: 'missing-secret-crashloop',\n    expectedTopCategory: 'missing-secret',\n  },\n  {\n    name: 'bad-image-tag',\n    expectedTopCategory: 'image-pull-failure',\n  },\n  {\n    name: 'pvc-pending',\n    expectedTopCategory: 'volume-mount-failure',\n  },\n];\n\n// ---------------------------------------------------------------------------\n// Category inference\n// ---------------------------------------------------------------------------\n\n/**\n * Infers the diagnostic category of a single finding from its ID or text.\n *\n * This mirrors the heuristic used to verify top-1 correctness but operates\n * on any finding, enabling per-confidence-band accuracy tracking.\n */\nfunction inferFindingCategory(finding) {\n  if (!finding) return 'none';\n\n  const id = String(finding.id ?? '');\n  if (id.startsWith('finding:hypothesis:')) {\n    return id.split(':')[2] ?? 'unknown';\n  }\n\n  const lower = `${finding.title ?? ''} ${finding.reasoningSummary ?? ''}`.toLowerCase();\n  if (lower.includes('dns') || lower.includes('name resolution') || lower.includes('nslookup')) {\n    return 'dns-failure';\n  }\n  if (lower.includes('secret') && (lower.includes('missing') || lower.includes('not found'))) {\n    return 'missing-secret';\n  }\n  if (lower.includes('image') && (lower.includes('pull') || lower.includes('err'))) {\n    return 'image-pull-failure';\n  }\n  if (lower.includes('volume') || lower.includes('pvc') || lower.includes('mount')) {\n    return 'volume-mount-failure';\n  }\n  if (lower.includes('connect')) {\n    return 'connectivity-failure';\n  }\n  return 'non-hypothesis';\n}\n\n/**\n * Infers the top category from a list of findings (uses the first / highest\n * confidence finding).  Used for the per-scenario `correct_top1` check.\n */\nfunction inferTopCategory(findings) {\n  return inferFindingCategory(findings[0]);\n}\n\n// ---------------------------------------------------------------------------\n// Confidence bands\n// ---------------------------------------------------------------------------\n\n/**\n * Confidence bands used for calibration analysis.\n *\n * Findings are assigned to the highest band whose `min` threshold they meet\n * (exclusive upper bound, inclusive lower bound, except the top band which\n * is inclusive on both ends).\n */\nconst CONFIDENCE_BANDS = [\n  { label: '0.85–1.00', min: 0.85, max: 1.01 },\n  { label: '0.70–0.85', min: 0.70, max: 0.85 },\n  { label: '0.50–0.70', min: 0.50, max: 0.70 },\n  { label: '0.00–0.50', min: 0.00, max: 0.50 },\n];\n\n/**\n * Assigns a finding's confidence value to a confidence band label.\n */\nfunction confidenceBand(confidence) {\n  for (const band of CONFIDENCE_BANDS) {\n    if (confidence >= band.min && confidence < band.max) {\n      return band.label;\n    }\n  }\n  return '0.00–0.50';\n}\n\n// ---------------------------------------------------------------------------\n// Helpers\n// ---------------------------------------------------------------------------\n\nfunction parseJson(stdout) {\n  const trimmed = stdout.trim();\n  if (trimmed.length === 0) {\n    throw new Error('CLI produced empty stdout');\n  }\n  return JSON.parse(trimmed);\n}\n\nfunction formatMs(value) {\n  return `${Math.round(value)}ms`;\n}\n\nfunction printTable(rows) {\n  const headers = [\n    'scenario',\n    'mode',\n    'elapsed',\n    'top_category',\n    'top_conf',\n    'correct_top1',\n    'total_findings',\n    'hypothesis_findings',\n    'ai_findings',\n  ];\n\n  const stringRows = rows.map((row) => [\n    row.scenario,\n    row.mode,\n    formatMs(row.elapsedMs),\n    row.topCategory,\n    row.topConfidence.toFixed(2),\n    row.correctTop1 ? 'yes' : 'no',\n    String(row.totalFindings),\n    String(row.hypothesisFindings),\n    String(row.aiFindings),\n  ]);\n\n  const widths = headers.map((header, i) =>\n    Math.max(header.length, ...stringRows.map((row) => row[i].length)),\n  );\n\n  const renderRow = (cells) =>\n    cells.map((cell, i) => cell.padEnd(widths[i])).join('  ');\n\n  console.log(renderRow(headers));\n  console.log(widths.map((w) => '-'.repeat(w)).join('  '));\n  for (const row of stringRows) {\n    console.log(renderRow(row));\n  }\n}\n\n/**\n * Prints the confidence calibration report.\n *\n * For each confidence band, shows the count of findings in that band, how\n * many were \"correct\" (matched the scenario's expected top category), and\n * the accuracy percentage.\n *\n * Also checks monotonicity: higher bands should have >= accuracy than lower\n * bands and prints a warning when this is violated.\n *\n * @param {Array<{confidence: number, correct: boolean, scenario: string, mode: string}>} allFindingStats\n */\nfunction printConfidenceCalibration(allFindingStats) {\n  console.log('\\n--- Confidence calibration by band ---\\n');\n  console.log(\n    'Definition of \"correct\": a finding is correct when its inferred category\\n' +\n    'matches the scenario\\'s expectedTopCategory.  With 4 scenarios this is a\\n' +\n    'small dataset — use the data to spot regressions, not absolute thresholds.\\n',\n  );\n\n  const headers = ['band', 'findings', 'correct', 'accuracy'];\n  const bandStats = CONFIDENCE_BANDS.map((band) => {\n    const inBand = allFindingStats.filter(\n      (s) => s.confidence >= band.min && s.confidence < band.max,\n    );\n    const correct = inBand.filter((s) => s.correct).length;\n    const accuracy = inBand.length > 0 ? correct / inBand.length : null;\n    return {\n      label: band.label,\n      total: inBand.length,\n      correct,\n      accuracy,\n    };\n  });\n\n  const stringRows = bandStats.map((s) => [\n    s.label,\n    String(s.total),\n    String(s.correct),\n    s.accuracy === null ? 'n/a (no data)' : `${(s.accuracy * 100).toFixed(1)}%`,\n  ]);\n\n  const widths = headers.map((h, i) =>\n    Math.max(h.length, ...stringRows.map((r) => r[i].length)),\n  );\n  const renderRow = (cells) =>\n    cells.map((cell, i) => cell.padEnd(widths[i])).join('  ');\n\n  console.log(renderRow(headers));\n  console.log(widths.map((w) => '-'.repeat(w)).join('  '));\n  for (const row of stringRows) {\n    console.log(renderRow(row));\n  }\n\n  // ── Monotonicity check ───────────────────────────────────────────────────\n  // Higher confidence bands should have >= accuracy than lower bands.\n  // We compare adjacent bands (highest first).\n\n  console.log('\\n--- Monotonicity check (higher confidence → higher accuracy) ---\\n');\n\n  const bandsWithData = bandStats.filter((b) => b.accuracy !== null);\n\n  if (bandsWithData.length < 2) {\n    console.log('Not enough data across bands to check monotonicity.');\n    return;\n  }\n\n  let allMonotone = true;\n  // bandsWithData is ordered highest-band-first (CONFIDENCE_BANDS order)\n  for (let i = 0; i < bandsWithData.length - 1; i++) {\n    const higher = bandsWithData[i];\n    const lower = bandsWithData[i + 1];\n    // Allow a tiny tolerance for floating-point imprecision\n    const isMonotone = higher.accuracy >= lower.accuracy - 0.001;\n    const status = isMonotone ? 'OK' : 'VIOLATION';\n    console.log(\n      `  ${higher.label} (${(higher.accuracy * 100).toFixed(1)}%) ` +\n        `>= ${lower.label} (${(lower.accuracy * 100).toFixed(1)}%): ${status}`,\n    );\n    if (!isMonotone) allMonotone = false;\n  }\n\n  if (allMonotone) {\n    console.log('\\nMonotonicity: PASS — confidence scores are well-ordered.');\n  } else {\n    console.log(\n      '\\nMonotonicity: WARN — some bands violate monotonicity.' +\n        '\\nThis may indicate miscalibrated scoring constants or insufficient data.' +\n        '\\nReview src/investigators/hypothesis-ranker.ts scoring weights.',\n    );\n  }\n\n  // ── Overall accuracy ─────────────────────────────────────────────────────\n  const totalAll = allFindingStats.length;\n  const correctAll = allFindingStats.filter((s) => s.correct).length;\n  if (totalAll > 0) {\n    console.log(\n      `\\nOverall accuracy: ${correctAll}/${totalAll} = ${((correctAll / totalAll) * 100).toFixed(1)}%`,\n\n[141 more lines in file. Use offset=261 to continue.]"}],"isError":false,"timestamp":1774104193991}}
+{"type":"message","id":"4df5db76","parentId":"33ea8b6e","timestamp":"2026-03-21T14:43:13.992Z","message":{"role":"toolResult","toolCallId":"call_OQSWrdPQ1yqKMoSIe9vcuaNK|fc_0e22c3c104fdf4860169beae81e168819b88ff32c1f1d60ec7","toolName":"read","content":[{"type":"text","text":"import type { Evidence } from '../types/index.js';\nimport type { EvidenceRule } from './hypothesis-templates.js';\n\n// ---------------------------------------------------------------------------\n// HypothesisCategory\n// ---------------------------------------------------------------------------\n\n/**\n * The broad root-cause class that a hypothesis belongs to.\n *\n * - `missing-secret`       — A required Kubernetes Secret or key is absent\n * - `bad-db-endpoint`      — A database connection string or endpoint is wrong\n * - `dns-failure`          — DNS resolution is failing for a service or host\n * - `image-pull-failure`   — A container image cannot be pulled (auth, tag, registry)\n * - `config-error`         — A ConfigMap value or environment variable is misconfigured\n * - `oom-kill`             — The container was killed due to memory limits being exceeded\n * - `connectivity-failure` — A network path between services or to an external endpoint is broken\n * - `readiness-failure`    — A Pod is not passing its readiness probe\n * - `generic-crash`        — The application crashed for an unclassified reason\n * - `missing-service`      — A required Kubernetes Service is absent or has no endpoints\n * - `volume-mount-failure`  — A PVC cannot be provisioned or a volume cannot be mounted (e.g. missing StorageClass)\n */\nexport type HypothesisCategory =\n  | 'missing-secret'\n  | 'bad-db-endpoint'\n  | 'dns-failure'\n  | 'image-pull-failure'\n  | 'config-error'\n  | 'oom-kill'\n  | 'connectivity-failure'\n  | 'readiness-failure'\n  | 'generic-crash'\n  | 'missing-service'\n  | 'volume-mount-failure';\n\n// ---------------------------------------------------------------------------\n// EvidenceAssessment\n// ---------------------------------------------------------------------------\n\n/**\n * A structured breakdown of all evidence gathered for a single hypothesis.\n *\n * - `supporting`       — Evidence items that increase confidence in the hypothesis\n * - `contradicting`    — Evidence items that lower confidence or rule out the hypothesis\n * - `missingDecisive`  — Descriptions of evidence that would be decisive but is absent,\n *                        used to drive spec-gap recommendations\n */\nexport interface EvidenceAssessment {\n  /** Evidence items that support the hypothesis being the root cause. */\n  supporting: Evidence[];\n  /** Evidence items that contradict or weaken the hypothesis. */\n  contradicting: Evidence[];\n  /**\n   * Human-readable descriptions of evidence that would decisively confirm or\n   * refute the hypothesis but is not present in the bundle.\n   */\n  missingDecisive: string[];\n}\n\n// ---------------------------------------------------------------------------\n// Hypothesis\n// ---------------------------------------------------------------------------\n\n/**\n * A single candidate root-cause hypothesis for an observed symptom.\n *\n * Each hypothesis is independently assessed with supporting, contradicting, and\n * missing evidence before a calibrated confidence score is assigned. This\n * models the differential-diagnosis pattern used by support engineers.\n */\nexport interface Hypothesis {\n  /** Unique identifier for this hypothesis within its {@link HypothesisSet}. */\n  id: string;\n  /** The observed symptom string that this hypothesis attempts to explain. */\n  symptom: string;\n  /** Human-readable statement of the proposed root cause. */\n  rootCause: string;\n  /** Broad classification of the root-cause class. */\n  category: HypothesisCategory;\n  /** Structured evidence gathered for and against this hypothesis. */\n  evidenceAssessment: EvidenceAssessment;\n  /** Declarative template evidence rules used by the evidence collector. */\n  evidenceRules?: EvidenceRule[];\n  /**\n   * Calibrated confidence that this hypothesis is the true root cause,\n   * in the range [0, 1]. Penalised when decisive evidence is missing.\n   */\n  confidence: number;\n  /**\n   * Free-text explanation of how the confidence score was derived from the\n   * supporting, contradicting, and missing evidence.\n   */\n  confidenceRationale: string;\n  /**\n   * Actionable recommendations to fill evidence gaps identified in\n   * {@link EvidenceAssessment.missingDecisive}. Emitted as spec-gap guidance\n   * when a hypothesis cannot be confirmed or ruled out.\n   */\n  specGapRecommendations: string[];\n  /**\n   * IDs of the raw {@link Finding} objects whose evidence contributed to\n   * this hypothesis.\n   */\n  sourceFindings: string[];\n}\n\n// ---------------------------------------------------------------------------\n// HypothesisSet\n// ---------------------------------------------------------------------------\n\n/**\n * All candidate hypotheses generated for a single symptom, together with the\n * top-ranked hypothesis (or `null` when no hypothesis reaches a useful\n * confidence threshold).\n */\nexport interface HypothesisSet {\n  /**\n   * A short stable key identifying the symptom (e.g. `\"pod-crashloop:api\"`)\n   * used for deduplication and cross-referencing.\n   */\n  symptomKey: string;\n  /** Full human-readable description of the observed symptom. */\n  symptomDescription: string;\n  /**\n   * All candidate hypotheses ranked from highest confidence to lowest.\n   * An empty array means no hypotheses could be generated for this symptom.\n   */\n  hypotheses: Hypothesis[];\n  /**\n   * The highest-ranked hypothesis after scoring, or `null` when `hypotheses`\n   * is empty.\n   */\n  topHypothesis: Hypothesis | null;\n}\n\n// ---------------------------------------------------------------------------\n// HypothesisVerificationResult\n// ---------------------------------------------------------------------------\n\n/**\n * The top-level result produced by the hypothesis verification layer.\n *\n * Contains one {@link HypothesisSet} per unique symptom detected across the\n * bundle, together with aggregate metadata suitable for tracing and reporting.\n */\nexport interface HypothesisVerificationResult {\n  /** One entry per unique symptom analysed. */\n  hypothesisSets: HypothesisSet[];\n  /** Aggregate counters for tracing and reporting. */\n  metadata: {\n    /** Total number of hypotheses generated across all symptom sets. */\n    totalHypotheses: number;\n    /** Total number of distinct symptoms that were analysed. */\n    totalSymptomsAnalyzed: number;\n  };\n}\n"}],"isError":false,"timestamp":1774104193992}}
